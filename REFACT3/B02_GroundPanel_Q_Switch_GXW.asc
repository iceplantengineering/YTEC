; B02 地上盤制御プログラム（M8001 オフライン/実装モード切り替え対応版）
; GX Works2 Simpleプロジェクト用 IL形式
;==============================================================================
; B02 地上盤 制御プログラム（M8001 オフライン/実装モード切り替え対応版）
; ベース: REFACT2/B02_GroundPanel_Q_GXW.asc
; M8001=OFF: 実装モード / M8001=ON: オフラインモード
;==============================================================================

;---------- オフラインモード初期化 ----------
  LDP M8001	;オフラインモード立上りパルス
  MOV K0 D456 	;Alarm_Code クリア
  MOV K0 D200 	;STKへ_タスクタイプ クリア
  DMOV K0 D201 	;STKへ_タスクID クリア
  MOV K0 D476 	;連動_PC無/単独_指令状態 クリア
  RST M360	;STK通信異常フラグ OFF
  LDF M8001	;オフラインモード立下りパルス(実装モード復帰)
  MOV K0 D456 	;Alarm_Code クリア

;[プログラム 00: 入力処理] 電源入力
  LD M8001	;オフラインバイパス
  OR X60
  OUT M100	;DI_電源入

;[プログラム 00: 入力処理] 予備 X61

;[プログラム 00: 入力処理] 非常停止PB正常監視 - 二重化入力
  LD M8001	;オフラインバイパス
  LD X62
  AND X63
  ORB
  LD M102	;DI_A01_非常停止PB正常1
  AND M103	;DI_A01_非常停止PB正常2
  ORB
  OUT M40	;非常停止正常まとめ

;[プログラム 00: 入力処理] 予備 X64-X6B

;[プログラム 00: 入力処理] 盤クーラ異常
  LDI X6C
  ANI M8001	;オフライン時はOFF(正常扱い)
  OUT M112	;DI_盤クーラ異常

;[プログラム 00: 入力処理] Ethernet光伝送異常
  LDI X6D
  ANI M8001	;オフライン時はOFF(正常扱い)
  OUT M113	;DI_Ethernet光伝送異常

;[プログラム 00: 入力処理] 予備 X6E-X6F

;[プログラム 00: 入力処理] 操作モード選択
  LD X70
  OUT M116	;DI_自動選択
  LD X71
  OUT M117	;DI_連動選択

;[プログラム 00: 入力処理] 管理者モード
  LD X72
  OUT M119	;DI_管理者モード入

;[プログラム 00: 入力処理] 操作ボタン
  LD X74
  OUT M120	;DI_異常リセット
  LD X76
  OUT M122	;DI_起動
  LD X77
  OUT M123	;DI_サイクル停止
  LD X78
  OUT M124	;DI_ランプチェック

;[プログラム 00: 入力処理] 運転準備入力 - 二重化
  LD M8001	;オフラインバイパス
  LD X7A
  AND X7B
  ORB
  OUT M10	;運転準備入

;[プログラム 00: 入力処理] STK電源MC状態
  LD M8001	;オフラインバイパス
  OR X7E
  OUT M130	;DI_STK電源_MC_ON

;[プログラム 00: 入力処理] B02安全機器状態 - 二重化入力
  LD M8001	;オフラインバイパス
  LD X88
  AND X89
  ORB
  OUT M140	;DI_B02_非常停止正常
  LD M8001	;オフラインバイパス
  LD X8A
  AND X8B
  ORB
  OUT M142	;DI_B02_ライトカーテン正常
  LD M8001	;オフラインバイパス
  LD X8C
  AND X8D
  ORB
  OUT M144	;DI_B02_安全ドアSW正常

;[プログラム 01: CC-Link通信処理(受信)] B02設備状態ビット受信
  LD SM400	;常時ON
  LD M8001	;オフラインバイパス
  OR B100
  OUT M1200	;CCLink_In_B02電源入
  LD M8001	;オフラインバイパス
  OR B101
  OUT M1201	;CCLink_In_B02運転準備入

;[プログラム 01: CC-Link通信処理(受信)] B02 RFIDデータ受信
  LD SM400	;常時ON
  BMOV W80 D352 K7`t; RFID受信
  BMOV W90 D359 K7`t; RFID受信

;[プログラム 02: STK通信処理(受信)] STK状態データ受信
  LD SM400	;常時ON
  MOV D128 K4M2500`t; STK状態データ受信`r`n
;[プログラム 03: 初期化処理] CV1出庫Forkワーク検出でAGV行先クリア
  LD M8001	;オフラインバイパス
  OR X1003	;从CV1_出庫Fork台ワーク検測
  MOV K0 D421 	;WMSから_入庫AGV行先
  MOV K0 D422 	;WMSから_出庫AGV行先

;[プログラム 09: 異常監視] 非常停止正常まとめ (統合済みのため削除)
  NOP
  NOP
  NOP

;[プログラム 09: 異常監視] アラームコード設定
  MOV K1 D456 	;Alarm_Code
  MOV K2 D456
  MOV K3 D456
  MOV K4 D456
  MOV K8 D456 	;* B02非常停止異常 *
  MOV K9 D456 	;* B02ライトカーテン異常 *
  MOV K10 D456 	;* B02安全ドアSW異常 *
  MOV K11 D456 	;* STKエラーコード異常 *
  MOV K13 D456 	;* B02エラーコード異常 *

;[プログラム 09: 異常監視] 超寬/超高アラーム(12-13)
  LD= D456 K0
  AND M1209	;CV01超寬検出1
  MOV K12 D456
  LD= D456 K0
  AND M1210	;CV01超寬検出2
  MOV K12 D456
  LD= D456 K0
  AND M1211	;CV01超高検出
  MOV K13 D456

;[プログラム 09: 異常監視] 光柵アラーム(14-17)
  LD= D456 K0
  ANI M1212	;AGV入庫光柵信号1=FALSE
  ANI M1800	;AGV進入中=FALSE
  MOV K14 D456
  LD= D456 K0
  ANI M1213	;AGV入庫光柵信号2=FALSE
  ANI M1800
  MOV K14 D456
  LD= D456 K0
  ANI M1214	;AGV出庫光柵信号1=FALSE
  ANI M1810	;AGV離開中=FALSE
  MOV K15 D456
  LD= D456 K0
  ANI M1215	;AGV出庫光柵信号2=FALSE
  ANI M1810
  MOV K15 D456
  LD= D456 K0
  ANI M1216	;CV_IN光柵信号1=FALSE
  AND M1208	;CV01伸縮中位2
  MOV K16 D456
  LD= D456 K0
  ANI M1217	;CV_IN光柵信号2=FALSE
  AND M1208
  MOV K16 D456
  LD= D456 K0
  ANI M1218	;CV_OUT光柵信号1=FALSE
  AND M1256	;Bx03伸縮中位2
  MOV K17 D456
  LD= D456 K0
  ANI M1219	;CV_OUT光柵信号2=FALSE
  AND M1256
  MOV K17 D456

;[プログラム 09: 異常監視] 安全門アラーム(18)
  LD= D456 K0
  ANI M1220	;安全門信号1=FALSE
  MOV K18 D456
  LD= D456 K0
  ANI M1221	;安全門信号2=FALSE
  MOV K18 D456

;[プログラム 09: 異常監視] 坍塌アラーム(19)
  LD= D456 K0
  AND M1222	;入庫坍塌検出
  AND M1208	;CV01伸縮中位2
  MOV K19 D456

;[プログラム 09: 異常監視] CC-Link通信監視
  LD M8001	;オフラインバイパス(通信正常扱い)
  OR SB49
  AND W900.1
  OUT M371	;B02_ON正常
  LD M8001	;オフラインバイパス(通信正常扱い)
  OR SB49
  AND W900.2
  OUT M372	;AGV_ON正常

;[プログラム 09: 異常監視] STK通信監視 - ハートビート
  OUT T1 K30
  LD T1
  ANI M8001	;オフライン時はタイムアウト異常OFF
  OUT M360	;スタッカーSC通信異常
  MOV D115 D3303

;[プログラム 09: 異常監視] 異常リセット処理
  LD M120	;DI_異常リセット
  MOV K0 D456 	;Alarm_Code
  DMOV K0 D4052 	;CV2へ_出庫STタスクID
  DMOV K0 D4049 	;CV2へ_ForkSTタスクID
  MOV K0 D4054 	;CV2へ_AGVへ出荷許可
  MOV K0 D4055 	;CV2へ_入庫口RFIDアラーム
  MOV K0 D4056 	;CV2へ_出庫口RFIDアラーム

;[プログラム 10: モード管理] 電源投入遅延
  LD M8001	;オフライン時は電源入と同等扱い
  OR M100	;DI_電源入
  OUT T10 K150	;電源入遅延

;[プログラム 10: モード管理] ハートビット生成
  OUT T0 K999	;ハートビット
  LD T0
  OUT M1

;[プログラム 10: モード管理] 運転準備入
  LD M8001	;オフラインバイパス
  OR M126	;DI_運転準備入1 AND M127 DI_運転準備入2
  OUT M10	;運転準備入
  OUT M158	;DO_運転準備ランプ

;[プログラム 10: モード管理] モード選択
  LD SM400	;常時ON
  LDI M116
  OUT M11	;手動操作選択
  LD M116
  OUT M12	;自動運転選択
  LDI M117
  OUT M13	;単独運転選択
  LD M117
  OUT M14	;連動運転選択

;[プログラム 10: モード管理] PC有効/無効モード
  LD SM400	;常時ON
  LD M207
  SET M19`t; PC有効フラグ
  LD M208
  RST M19`t; PC無効フラグ

;[プログラム 10: モード管理] モード表示灯制御
  LD SM400	;常時ON
  LD M12
  AND M14
  AND M19
  OUT M200	;モード_自動連動PC有PL
  MOV K0 D450 	;Mode
  AND M13
  ANI M19
  OUT M201	;ﾓｰﾄﾞ_自動単独/連動PC無PL
  MOV K1 D450
  LD M11
  OUT M202	;モード_手動PL
  MOV K2 D450

;[プログラム 10: モード管理] WMSタスクタイプクリア - PC無効時
  LD SM401	;常時OFF
  MOV K0 D400 	;WMSから_タスクタイプ
  MOV K0 D401 	;WMSから_タスクID

;[プログラム 10: モード管理] 自動運転開始条件1 - 基本条件
  LD M8001	;オフラインバイパス(条件強制成立)
  OR M10	;運転準備入
  LD M40	;非常停止正常まとめ
  LD M12	;自動運転選択
  LD M2513	;STKから_運転ﾓｰﾄﾞ選択
  LD D102	;STKから_エラーコード
  OUT M20	;自動運転開始条件1

;[プログラム 10: モード管理] 自動運転開始条件3 - CV系準備
  LD M8001	;オフラインバイパス(条件強制成立)
  OR M1210	;CCLink_In_B02自動運転中
  LD M8001	;オフラインバイパス
  OR M1218	;CCLink_In_B02連動ﾓｰﾄﾞ選択
  OUT M22	;自動運転開始条件3

;[プログラム 10: モード管理] 単独/連動PC無 自動運転開始
  LD M20	;自動運転開始条件1
  LD M35	;サイクル停止完了
  LD M201	;ﾓｰﾄﾞ_自動単独/連動PC無PL
  LD M122	;DI_起動
  LD M22
  OUT T11 K50	;単独/連動PC無自動運転開始遅延
  OUT M31	;自動_単独/連動PC無運転中
  LD M31
  OUT T11 K50

;[プログラム 10: モード管理] 連動PC有 自動運転開始
  LD M200	;モード_自動連動PC有PL
  LD M122	;DI_起動
  LD M22
  OUT T12 K50	;連動PC有自動運転開始遅延
  OUT M32	;自動_連動運転中
  LD M32
  OUT T12 K50

;[プログラム 10: モード管理] 運転中表示とSTKへ通知
  LD M31
  OUT M159	;DO_起動ランプ
  OUT M2013	;STKへ_自動運転中

;[プログラム 10: モード管理] サイクル停止
  OUT M15	;サイクル停止選択
  LD M15
  LD SM412
  OUT M160	;DO_サイクル停止ランプ

;[プログラム 10: モード管理] サイクル停止完了
  LD M15
  OUT M35	;サイクル停止完了

;[プログラム 10: モード管理] 手動操作中
  LD M11	;手動操作選択
  OUT M30	;手動操作中
  OUT M2000	;STKへ_手動制御リクエスト

;[プログラム 10: モード管理] WMSタスクタイプ判定 - 連動PC有
  LD= D400 K1`r`n  OUT M3831	;連動PC有_タスクタイプ搬入
  LD= D400 K2`r`n  OUT M3832	;連動PC有_タスクタイプ搬出
  LD= D400 K3`r`n  OUT M3833	;連動PC有_タスクタイプ移庫
  LD= D400 K4`r`n  OUT M3834	;連動PC有_タスクタイプ检修

;[プログラム 10: モード管理] 単独/連動PC無タスクタイプ判定
  LD= D500 K1`r`n  OUT M3821	;単独/連動PC無_ﾀｽｸﾀｲﾌﾟ搬入
  LD= D500 K2`r`n  OUT M3822	;単独/連動PC無_ﾀｽｸﾀｲﾌﾟ搬出
  LD= D500 K3`r`n  OUT M3823	;単独/連動PC無_ﾀｽｸﾀｲﾌﾟ移庫
  LD= D500 K4`r`n  OUT M3824	;単独/連動PC無_ﾀｽｸﾀｲﾌﾟ原位置

;[プログラム 11: 連動PC有モード処理] STK待機状態チェック
  LD= D100 K1`r`n  OUT M3800	;スタッカー_状態待機

;[プログラム 11: 連動PC有モード処理] タスク送信処理 - PC有モード
  LD M200	;モード_自動連動PC有PL
  LD M3818	;地上盤_待機
  LD M3800	;スタッカー_状態待機
  MOV D400 D200 	;STKへ_タスクタイプ
  DMOV D401 D201 	;STKへ_タスクID
  MOV D403 D203 	;STKへ_起点棚
  MOV D404 D204 	;STKへ_起点列
  MOV D405 D205 	;STKへ_起点層
  MOV D406 D206 	;STKへ_終点棚
  MOV D407 D207 	;STKへ_終点列
  MOV D408 D208 	;STKへ_終点層
  MOV K2 D209 	;STKへ_搬入ST番号
  MOV K6 D209
  MOV K0 D209
  MOV K4 D210 	;STKへ_搬出ST番号
  MOV K8 D210
  MOV K0 D210

;[プログラム 12: 単独/連動PC無モード処理] 在庫状態判定 - 終点
  LD D506	;連動_PC無/単独_終点棚
  LD D507	;連動_PC無/単独_終点列
  LD D508	;連動_PC無/単独_終点層
  OUT M3802	;単独/連動PC無終点タスクON
  LD M201
  MOV K0 D473 	;連動_PC無/単独_終点出庫状態
  MOV K1 D473
  MOV K0 D473
  MOV K1 D473
  LD= D473 K1`r`n  OUT M3813	;単独/連動PC無_終点ﾊﾟﾚｯﾄ無

;[プログラム 12: 単独/連動PC無モード処理] 在庫状態判定 - 起点
  LD D503	;連動_PC無/単独_起点棚
  LD D504	;連動_PC無/単独_起点列
  LD D505	;連動_PC無/単独_起点層
  OUT M3801	;単独/連動PC無起点タスクON
  LD M201
  MOV K0 D472 	;連動_PC無/単独_起点出庫状態
  MOV K1 D472
  MOV K0 D472
  MOV K1 D472
  LD= D472 K1`r`n  OUT M3812	;単独/連動PC無_起点有ワーク

;[プログラム 12: 単独/連動PC無モード処理] 搬入台ワーク状態確認
  LD= D509 K0`r`n  OUT M217	;連動PC無_搬入ST状態PL
  LD M217
  MOV K0 D474 	;連動_PC無_搬入台ワーク状態
  MOV K1 D474
  MOV K0 D474
  MOV K1 D474
  MOV K0 D474
  LD= D474 K1`r`n  OUT M3814	;連動PC無_搬入STﾊﾟﾚｯﾄ有

;[プログラム 12: 単独/連動PC無モード処理] 搬出台ワーク状態確認
  LD= D510 K0`r`n  OUT M218	;連動_搬出ST状態PL
  LD M218
  MOV K0 D475 	;連動_PC無_搬出台ワーク状態
  MOV K1 D475
  MOV K0 D475
  MOV K1 D475
  MOV K0 D475
  LD= D475 K1`r`n  OUT M3815	;連動PC無_搬出STﾊﾟﾚｯﾄ無

;[プログラム 12: 単独/連動PC無モード処理] 搬入許可判定
  LD M201
  LD M8001	;オフラインバイパス
  OR M1210	;B02自動運転中 AND M1218 B02連動モード
  LD D509
  OUT M220	;HMI_単独/連動PC無_搬入許可

;[プログラム 12: 単独/連動PC無モード処理] 搬入タスク発行
  LD M220
  MOV K1 D500 	;連動_PC無/単独_タスクタイプ
  ; LD D (元STコード参照)
  BMOV D352 D3304 K7	;搬入RFID番号

;[プログラム 12: 単独/連動PC無モード処理] タスク発行済み管理
  LD M201
  OUT M3803	;STK単独/連動PC無タスク発行済
  LD D501
  OUT M3804	;STK単独/連動PCタスクID発行済

;[プログラム 12: 単独/連動PC無モード処理] 搬入タスクSTKへ送信
  LD M3804
  LD M3821	;タスクタイプ搬入
  LD M3814	;搬入STパレット有
  LD M3813	;終点パレット無
  MOV D500 D200 	;STKへ_タスクタイプ
  DMOV D501 D201 	;STKへ_タスクID
  MOV D509 D209 	;STKへ_搬入ST番号
  MOV D506 D206 	;STKへ_終点棚
  MOV D507 D207 	;STKへ_終点列
  MOV D508 D208 	;STKへ_終点層
  MOV K1 D476 	;連動_PC無/単独_指令状態

;[プログラム 12: 単独/連動PC無モード処理] 搬出許可判定
  LD M201
  LD D470	;連動_PC無_AGV行き先
  LD M3815	;搬出STパレット無
  LD M3800
  OUT M214	;HMI_単独/連動PC無_搬出許可
  LD M201
  LD M3815
  OUT M214

;[プログラム 12: 単独/連動PC無モード処理] 搬出タスク発行
  LD M214
  MOV K2 D500
  ; LD D (元STコード参照)
  MOV D460  D503 	;起点棚 連動_PC無/単独_現在位置棚
  MOV D461  D504 	;起点列 現在位置列
  MOV D462  D505 	;起点層 現在位置層
  MOV K0 D460
  MOV K0 D461
  MOV K0 D462
  MOV K0 D470 	;AGV行き先

;[プログラム 12: 単独/連動PC無モード処理] 搬出タスクSTKへ送信
  LD M3804
  LD M3822	;タスクタイプ搬出
  LD M3812	;起点有ワーク
  LD M3815	;搬出STパレット無
  MOV D500 D200
  DMOV D501 D201
  MOV D510 D210 	;STKへ_搬出ST番号
  MOV D503 D203 	;STKへ_起点棚
  MOV D504 D204 	;STKへ_起点列
  MOV D505 D205 	;STKへ_起点層
  MOV K2 D476

;[プログラム 12: 単独/連動PC無モード処理] 移庫タスクSTKへ送信
  LD M3804
  LD M3823	;タスクタイプ移庫
  LD M3812	;起点有ワーク
  LD M3813	;終点パレット無
  MOV D500 D200
  DMOV D501 D201
  MOV D503 D203
  MOV D504 D204
  MOV D505 D205
  MOV D506 D206
  MOV D507 D207
  MOV D508 D208
  MOV K3 D476

;[プログラム 12: 単独/連動PC無モード処理] 原位置タスクSTKへ送信
  LD M3804
  MOV D500 D200
  DMOV D501 D201
  MOV K0 D203
  MOV K0 D204
  MOV K0 D205
  MOV K0 D206
  MOV K0 D207
  MOV K0 D208
  MOV K0 D209
  MOV K0 D210
  MOV K4 D476

;[プログラム 12: 単独/連動PC無モード処理] 指令タイムアウト監視
  LD D476
  OUT T4 K30
  MOV K0 D476

;[プログラム 13: 手動操作処理] 初期化
  LD SM402	;RUN後1スキャンON
  MOV K0 D10 	;HMI_手動操作機器選択
  LD M30	;手動操作中 AND D455 HMI画面コード
  MOV K0 D10

;[プログラム 13: 手動操作処理] 位置決め/棚位置決め
  LD M30
  OUT M2001	;STKへ__庫位置切替

;[プログラム 13: 手動操作処理] X軸操作 - D10=K10時
  LD M30
  LD M230
  AND M234`t; HMI操作PB
  OUT M2006	;STKへ__X軸前進
  LD M231
  AND M234`t; HMI操作PB
  OUT M2007	;STKへ__X軸後退
  LD M232
  AND M234`t; HMI操作PB
  OUT M2003	;STKへ__X軸定位

;[プログラム 13: 手動操作処理] Y軸操作 - D10=K11時
  LD M30
  LD M230
  OUT M2008	;STKへ__Y軸上昇
  LD M231
  OUT M2009	;STKへ__Y軸下降
  LD M232
  OUT M2004	;STKへ__Y軸定位

;[プログラム 13: 手動操作処理] Z軸操作 - D10=K12時
  LD M30
  LD M230
  OUT M2010	;STKへ__Z軸左伸
  LD M231
  OUT M2011	;STKへ__Z軸右伸
  LD M232
  OUT M2005	;STKへ__Z軸定位

;[プログラム 13: 手動操作処理] 原点復帰
  LD M2514	;STKから_X軸位置決め完了
  LD M2515	;STKから_Y軸位置決め完了
  OUT M50	;XY軸位置決め完了
  LD M30
  LD M2501	;STKから_Fork在中位
  OUT M2012	;STKへ_原点位置へ動作
  LD M2012
  MOVP K0 D10
  LD M50
  OUT T15 K3

;[プログラム 14: タスク管理] B02タスク待機状態
  LD= D3293 K0`r`n  OUT M3809	;B02タスク待機
  LD= D3297 K0`r`n  OUT M3810	;B2 AGV行き先空

;[プログラム 14: タスク管理] 搬入指令生成
  LD M200	;モード_自動連動PC有PL
  LD M3831	;連動PC有_タスクタイプ搬入
  LD D201	;STKへ_タスクID = D104 STKから_現在タスクID
  LD D103	;STKから_タスク状態
  OUT M3805	;CVライン_搬入指令
  LD M201	;ﾓｰﾄﾞ_自動単独/連動PC無PL
  LD M3821	;単独/連動PC無_ﾀｽｸﾀｲﾌﾟ搬入
  OUT M3805

;[プログラム 14: タスク管理] 搬入処理 - B02 CV3
  LD M3805
  LD M8001	;オフラインバイパス
  OR M1210	;CCLink_In_B02自動運転中
  LD M8001	;オフラインバイパス
  OR M1218	;CCLink_In_B02連動ﾓｰﾄﾞ選択
  LD M8001	;オフラインバイパス
  OR M1248	;CCLink_In_B02CV3受取可
  LD D352	;WMＳへ_出庫搬入RFID読み値
  BMOV D352 D3304 K7

;[プログラム 14: タスク管理] ForkSTタスクID発行 - B02
  LD SM401
  LD D104
  LD D3050	;CV2から_設備状態
  LD D3075	;CV2から_入庫フローワード
  LD D3051	;CV2から_エラーコード
  LD D104
  LD M8001	;オフラインバイパス
  OR X1030	;从CV2_入庫Fork台ワーク検測
  LD D352
  DMOV D104 D4049
  BMOV D352 D3304 K7

;[プログラム 14: タスク管理] ForkSTタスク完了クリア - B02
  LD SM401
  LD D4049
  LD D3051
  DMOV K0 D4049

;[プログラム 14: タスク管理] 搬出タスク管理 - AGV行き先設定（B02）
  LD M214	;HMI_単独/連動PC無_搬出許可
  LD M213	;HMI_単独/連動PC無_搬出PB
  LD M3809	;B02タスク待機
  LD M3810	;B2 AGV行き先空
  DMOV D501 D3293 	;Out_B02.タスクID1
  MOV D470 D3297 	;Out_B02.AGV行き先1
  DMOV D501 D3295 	;Out_CV2.タスクID2
  MOV D470 D3298 	;Out_B02.AGV行き先2

;[プログラム 14: タスク管理] 出庫STタスクID発行 - CV2
  LD SM401
  LD D3299
  LD D3050	;CV2から_設備状態
  LD D3076	;CV2から_出庫フローワード
  LD D3051	;CV2から_エラーコード
  LD D3299
  LD M8001	;オフラインバイパス
  OR X1035	;从CV2_出庫台ワーク検測
  DMOV D3299 D4052
  DMOV K0 D3299

;[プログラム 14: タスク管理] 出庫STタスク完了クリア - CV2
  LD SM401
  LD D4052
  LD D3051
  DMOV K0 D4052

;[プログラム 14: タスク管理] AGV発進許可処理 - B02
  LD M8001	;オフラインバイパス
  OR M1210	;B02自動運転中
  LD M8001	;オフラインバイパス
  OR M1218	;B02連動モード
  LD M2511	;STKから_受渡完了
  LD M1273	;B02CV4搬出ST在席
  OUT M3817	;CV2出庫AGVレディ
  LD M201
  OUT M3817
  LD M3817
  MOV D3298 W80`t; RFID出力
  LD SM401
  LD D3058	;CV2から_ST1003タスクID
  LD D3058
  MOV D3297 D4054 	;CV2へ_AGVへ出荷許可
  DMOV K0 D3293
  MOV K0 D3297
  MOV D3298 D4054
  DMOV K0 D3295
  MOV K0 D3298

;[プログラム 14: タスク管理] AGV行き先クリア - モード切替時
  LD M200
  MOV K0 D3297 	;Out_B02.AGV行き先1
  MOV K0 D3298 	;Out_B02.AGV行き先2
  MOV K0 D3297
  MOV K0 D3298

;[プログラム 14: タスク管理] タスク全クリア - モード切替時等
  LD SM401
  DMOV K0 D3293 	;Out_B02.タスクID1
  MOV K0 D3297 	;Out_B02.AGV行き先1
  DMOV K0 D3295 	;Out_CV2.タスクID2
  MOV K0 D3298 	;Out_B02.AGV行き先2

;[プログラム 30: HMI処理] タスクタイプ表示
  LD= D500 K1`r`n  OUT M300	;HMI_単独入庫タイプPL
  LD= D500 K2`r`n  OUT M301	;HMI_単独出庫タイプPL
  LD= D500 K3`r`n  OUT M302	;HMI_単独移库タイプPL
  LD= D400 K1`r`n  OUT M303	;HMI_連動入庫タイプPL
  LD= D400 K2`r`n  OUT M304	;HMI_連動出庫タイプPL
  LD= D400 K3`r`n  OUT M305	;HMI_連動移库タイプPL
  LD= D200 K1`r`n  OUT M306	;HMI_Auto入庫タイプPL
  LD= D200 K2`r`n  OUT M307	;HMI_Auto出庫タイプPL
  LD= D200 K3`r`n  OUT M308	;HMI_Auto移库タイプPL

;[プログラム 30: HMI処理] 管理者モード切替条件
  LD SM401	;常時OFF
  MOV K0 D454 	;パスワード許可
  OUT M156	;DO_積層灯BZ4

;[プログラム 30: HMI処理] 管理者画面切替有効条件
  LD M11	;手動操作選択
  OUT M920	;管理者画面切替有効条件

;[プログラム 30: HMI処理] パスワード設定
  LD SM400	;常時ON
  MOV K55 D5120 	;安全機器ﾊﾟｽﾜｰﾄﾞ設定値

;[プログラム 30: HMI処理] パスワード確認処理
  LD M920
  MOV K10 D5100 	;GOT画面切替番号
  MOV K0 D5101 	;GOTｵｰﾊﾞﾗｯﾌﾟｳｨﾝﾄﾞｳ1
  MOV K12 D5101

;[プログラム 30: HMI処理] パスワード入力クリア
  LD M922
  MOV K0 D5121

;[プログラム 30: HMI処理] 管理者画面終了
  MOV K0 D5101

;[プログラム 30: HMI処理] 安全機器一時解除有効
  LD M920
  OUT M921	;安全機器一時解除有効

;[プログラム 30: HMI処理] 画面復帰
  LD M921
  MOVP K1 D5100

;[プログラム 30: HMI処理] 異常発生時アラーム画面へ
  LD D456	;Alarm_Code
  MOVP K5 D455 	;HMI画面コード

;[プログラム 40: 出力処理] 積層灯制御
  LD SM400	;常時ON
  LD M150	;DO_積層灯R OR M124 DI_ランプチェック
  OUT Y90	;積層灯R
  LD M151	;DO_積層灯Y
  OUT Y91	;積層灯Y
  LD M152	;DO_積層灯G
  OUT Y92	;積層灯G
  LD M153
  OUT Y93	;積層灯BZ1
  LD M154
  OUT Y94	;積層灯BZ2
  LD M155
  OUT Y95	;積層灯BZ3
  LD M156
  OUT Y96	;積層灯BZ4

;[プログラム 40: 出力処理] 操作パネルランプ
  LD SM400	;常時ON
  LD M158	;DO_運転準備ランプ
  OUT Y98	;DO_運転準備ランプ
  LD M159	;DO_起動ランプ
  OUT Y99	;DO_起動ランプ
  LD M160	;DO_サイクル停止ランプ
  OUT Y9A	;DO_サイクル停止ランプ

;[プログラム 41: CC-Link通信処理(送信)] B02制御データ送信
  LD SM400	;常時ON
  LD M100
  OUT B1100
  LD M10
  OUT B1101
  LD M102
  AND M103
  OUT B1104
  LD M31
  OUT B110A
  LD M15
  OUT B110B
  LD M30
  OUT B110C
  LD M12
  OUT B1110
  LD M11
  OUT B1111
  LD M14
  OUT B1112
  LD M13
  OUT B1113
  LD M119
  OUT B1114
  LD M12
  AND M14
  AND M122
  OUT B111A
  LD M123
  OUT B111B
  LD K6
  AND M2508
  OUT B1120
  LD K6
  AND M2510
  OUT B1121
  LD K8
  AND M2509
  OUT B1122
  LD K8
  AND M2511
  OUT B1123

;[プログラム 42: STK通信処理(送信)] ハートビット送信
  LD SM400	;常時ON
  MOV T0  D211 	;STKへ_系统ハートビット ハートビット

;[プログラム 42: STK通信処理(送信)] 搬入受取可 - B02
; origine: IF 入庫口頂升上限 AND 入庫口物料有 THEN 允許取貨=1 ELSE =0
  LD SM400	;常時ON
  MOV K0 D213	;STKへ_搬入受取可 デフォルト=0
  LD M1200	;入庫口頂升上限
  AND M1204	;入庫口物料到位
  MOV K1 D213	;条件成立時 搬入受取可=1

;[プログラム 42: STK通信処理(送信)] 搬出受渡可 - B02
; origine: IF 出庫口頂升上限 AND 出庫口物料=FALSE THEN 允許放貨=1 ELSE =0
  LD SM400	;常時ON
  MOV K0 D215	;STKへ_搬出受渡可 デフォルト=0
  LD M1248	;出庫口頂升上限
  ANI M1252	;出庫口物料なし
  MOV K1 D215	;条件成立時 搬出受渡可=1

;[プログラム 42: STK通信処理(送信)] モード送信
  LD SM400	;常時ON
  MOV K0 D216 	;STKへ_モード
  MOV K2 D216

;[プログラム 42: STK通信処理(送信)] リセット送信
  LD SM400	;常時ON
  MOV K1 D217 	;STKへ_リセット
  MOV K0 D217

;[プログラム 42: STK通信処理(送信)] 手動制御リクエスト
  LD SM400	;常時ON
  MOV K4M2000  D224 	;STKへ_Control_Bit STKへ_手動制御リクエスト

;[プログラム 42: STK通信処理(送信)] 非常停止状態
  LD M140
  ANI M8001	;オフライン時は非常停止なし扱い
  LD M144
  ANI M8001	;オフライン時は非常停止なし扱い
  MOV K0 D225 	;STKへ_非常停止
  MOV K1 D225

;[プログラム 43: WMS通信処理] STK状態データ転送
  LD SM400	;常時ON
  MOV D100 D300 	;WMSへ_スタッカー状態
  MOV D101 D301 	;WMSへ_自動フローワード
  MOV D102 D302 	;WMSへ_エラーコード
  MOV D103 D303 	;WMSへ_タスク状態
  DMOV D104 D304 	;WMSへ_現在タスクID
  DMOV D106 D306 	;WMSへ_タスク実行総回数
  MOV D108 D308 	;WMSへ_走行現在位置
  MOV D109 D309 	;WMSへ_昇降現在位置
  MOV D110 D310 	;WMSへ_Fork現在位置
  MOV D111 D311 	;WMSへ_走行現在速度
  MOV D112 D312 	;WMSへ_昇降現在速度
  MOV D113 D313 	;WMSへ_Fork現在速度
  MOV D114 D314 	;WMSへ_現在モード
  MOV D115 D315 	;WMSへ_ハートビート

;[プログラム 43: WMS通信処理] 地上盤状態送信
  LD SM400	;常時ON
  MOV D450  D321 	;WMSへ_地上盤現在モード Mode

;[プログラム 43: WMS通信処理] 地上盤状態判定
; origine: IF Mode>1 THEN 状態=0; IF Mode<=1 AND Alarm=0 THEN 状態=1; IF Alarm<>0 THEN 状態=3
  LD SM400	;常時ON
  MOV K0 D322	;WMSへ_地上盤状態 デフォルト=0
  LD<= D450 K1	;Mode <= 1
  AND= D456 K0	;Alarm_Code = 0
  AND M159	;DO_起動ランプ
  MOV K1 D322	;設備状態=1(正常)
  LD<> D456 K0	;Alarm_Code <> 0
  MOV K3 D322	;設備状態=3(異常)
  LD= D480 K0	;入庫Step=0
  AND= D484 K0	;出庫Step=0
  OUT M3818	;地上盤_待機

;[プログラム 43: WMS通信処理] エラーコード送信
  LD SM400	;常時ON
  MOV D456 D323 	;WMSへ_地上盤エラーコード

;[プログラム 43: WMS通信処理] B02タスク状態送信
  LD SM400	;常時ON
  MOV D3052 D345 	;WMＳへ_出庫搬入タスク状態
  DMOV D3054 D347 	;WMＳへ_出庫搬入台タスクID
  MOV D3057 D349 	;WMＳへ_出庫搬出タスク状態
  DMOV D3058 D350 	;WMＳへ_出庫搬出台タスクID
  BMOV D3061 D352  K7	;WMＳへ_出庫搬入RFID読み値
  BMOV D3068 D359  K7	;WMＳへ_出庫搬出RFID読み値
  BMOV W1080 D352 K7
  BMOV W1090 D359 K7

;[プログラム 43: WMS通信処理] 搬出可状態送信
  LD SM400	;常時ON
  MOV D215 D367 	;WMＳへ_出庫搬出可
  MOV D3078 D369 	;WMＳへ_出庫搬出AGV受渡完了

;==============================================================================
; 【プログラム 45】光柵屏蔽制御 - B02
;==============================================================================
  LD SM400
  ANI M1208	;CV01伸縮中位2=FALSE
  OR M1903	;HMI.入庫光柵屏蔽
  OUT M3900	;DO_屏蔽CV_IN光柵信号1
  OUT M3901	;DO_屏蔽CV_IN光柵信号2

  LD SM400
  ANI M1256	;Bx03伸縮中位2=FALSE
  OR M1904	;HMI.出庫光柵屏蔽
  OUT M3902	;DO_屏蔽CV_OUT光柵信号1
  OUT M3903	;DO_屏蔽CV_OUT光柵信号2

  LD M1905	;HMI.安全門屏蔽
  OUT M3904	;DO_屏蔽安全門信号1
  OUT M3905	;DO_屏蔽安全門信号2

;==============================================================================
; 【プログラム 46】安全ドアロック制御 - B02
;==============================================================================
  LD M1223	;解鍤1安全門
  OUT M3907	;DO_鎖住安全門
  LDI M1223
  OUT M3906	;DO_開錠指示

;==============================================================================
; 【プログラム 47】フォーク零点判定 - B02
;==============================================================================
  LD M1207	;CV01伸縮中位1
  AND M1208	;CV01伸縮中位2
  AND> D184 K-2
  AND< D184 K2
  OUT M1830	;入庫Fork_在零点

  LD M1255	;Bx03伸縮中位1
  AND M1256	;Bx03伸縮中位2
  AND> D188 K-2
  AND< D188 K2
  OUT M1831	;出庫Fork_在零点

;==============================================================================
; 【プログラム 50】入庫搬送シーケンス (Store FB) - B02
;==============================================================================
; D480:入庫Step  D481:入庫タスク状態  D482:入庫タスクID  D488:単機入庫ID
; M1200:入庫口頂升上限  M1201:入庫口頂升下限  M1202:庫叉頂升上限  M1203:庫叉頂升下限
; M1204:入庫口物料到位  M1205:入庫口減速  M1206:庫叉位置物料検出
; M1207:庫叉伸出到位  M1208:庫叉縮回到位
; M1802:AGV就緒  M1803:AGV停止  M1804:AGV物料探検
; M3862:入庫口頂升上昇  M3863:入庫口頂升下降  M3864:庫叉頂升上昇  M3865:庫叉頂升下降
; M3866:庫送線制御  M3867:庫送線低速  M3868:庫叉伸出  M3869:庫叉縮回
;------------------------------------------------------------------------------

; --- 安全ガード ---
  LD> D450 K1
  OR= D480 K0
  OR<> D456 K0
  RST M3862
  RST M3863
  RST M3864
  RST M3865
  RST M3866
  RST M3867
  RST M3868
  RST M3869

; --- Alarm強制停止 ---
  LD<> D456 K0
  AND<> D480 K0
  MOV K0 D480
  MOV K3 D481

; --- 連動モード入庫タスク開始 ---
  LD= D322 K1
  AND= D450 K0
  AND<> D3200 D482
  AND<> D3200 K0
  AND= D480 K0
  AND= D456 K0
  AND M1206
  ANI M1204
  MOV D3200 D482
  MOV K1 D481
  MOV K1 D480
  MOV K0 D3078

; --- 単独モード入庫タスク開始 ---
  LD= D322 K1
  AND= D450 K1
  AND<> D488 D482
  AND<> D488 K0
  AND= D480 K0
  AND= D456 K0
  AND M1206
  ANI M1204
  MOV D488 D482
  MOV K1 D481
  MOV K1 D480
  MOV K0 D3078

; --- Step1-4: 入庫口搜送シーケンス ---
  LD= D480 K1
  ANI M1201
  SET M3863
  LD= D480 K1
  AND M1201
  RST M3863
  MOV K2 D480

  LD= D480 K2
  AND M1201
  SET M3866
  LD= D480 K2
  AND M1205
  SET M3867
  LD= D480 K2
  AND M1204
  RST M3866
  RST M3867
  MOV K3 D480

  LD= D480 K3
  AND M1204
  SET M3862
  MOV K4 D480

  LD= D480 K4
  AND M1200
  RST M3862
  MOV K2 D481
  MOV K0 D480
  MOV K0 D488
  MOV K0 D3200

; --- AGV→庫叉 Step10-15 ---
  LD= D322 K1
  AND<= D450 K1
  AND M1802
  AND M1803
  AND= D480 K0
  AND= D456 K0
  AND M1804
  ANI M1206
  MOV K1001 D482
  MOV K1 D481
  MOV K10 D480

  LD= D480 K10
  ANI M1203
  SET M3865
  LD= D480 K10
  AND M1203
  RST M3865
  MOV K11 D480

  LD= D480 K11
  SET M3868
  MOV K12 D480

  LD= D480 K12
  AND M1207
  RST M3868
  SET M3864
  MOV K13 D480

  LD= D480 K13
  AND M1202
  RST M3864
  SET M3869
  MOV K14 D480

  LD= D480 K14
  AND M1208
  RST M3869
  SET M3865
  MOV K15 D480

  LD= D480 K15
  AND M1203
  RST M3865
  MOV K2 D481
  MOV K0 D480
  MOV K1001 D3078

;==============================================================================
; 【プログラム 51】出庫搬送シーケンス (Outbound FB) - B02
;==============================================================================
; D484:出庫Step  D485:出庫タスク状態  D486:出庫タスクID  D490:単機出庫ID
; M1248:出庫口頂升上限  M1249:出庫口頂升下限  M1250:庫叉頂升上限  M1251:庫叉頂升下限
; M1252:出庫口物料到位  M1253:庫叉減速  M1254:庫叉物料検出
; M1255:庫叉伸出到位  M1256:庫叉縮回到位
; M3878:出庫口頂升上昇  M3879:出庫口頂升下降  M3880:庫叉頂升上昇  M3881:庫叉頂升下降
; M3882:庫送線制御  M3883:庫送線低速  M3884:庫叉伸出  M3885:庫叉縮回
;------------------------------------------------------------------------------

; --- 安全ガード ---
  LD> D450 K1
  OR= D484 K0
  OR<> D456 K0
  RST M3878
  RST M3879
  RST M3880
  RST M3881
  RST M3882
  RST M3883
  RST M3884
  RST M3885

; --- Alarm強制停止 ---
  LD<> D456 K0
  AND<> D484 K0
  MOV K0 D484
  MOV K3 D485

; --- 連動モード出庫タスク開始 ---
  LD= D322 K1
  AND= D450 K0
  AND<> D3258 D486
  AND= D484 K0
  AND= D456 K0
  ANI M1254
  AND M1252
  MOV D3258 D486
  MOV K1 D485
  MOV K1 D484

; --- 単独モード出庫タスク開始 ---
  LD= D322 K1
  AND= D450 K1
  AND<> D490 D486
  AND= D484 K0
  AND= D456 K0
  ANI M1254
  AND M1252
  MOV D490 D486
  MOV K1 D485
  MOV K1 D484

; --- Step1-5: 出庫搜送シーケンス ---
  LD= D484 K1
  SET M3879
  MOV K2 D484

  LD= D484 K2
  AND M1249
  RST M3879
  ANI M1251
  SET M3881
  LD= D484 K2
  AND M1251
  RST M3881
  SET M3882
  MOV K3 D484

  LD= D484 K3
  AND M1253
  SET M3883
  LD= D484 K3
  AND M1254
  RST M3882
  RST M3883
  MOV K4 D484

  LD= D484 K4
  ANI M1252
  SET M3878
  MOV K5 D484

  LD= D484 K5
  AND M1248
  RST M3878
  MOV K2 D485
  MOV K0 D484
  MOV K0 D490
  MOV K0 D3258

; --- 庫叉→AGV Step10-15 ---
  LD= D322 K1
  AND<= D450 K1
  AND M1812
  AND M1813
  AND= D484 K0
  AND= D456 K0
  ANI M1814
  AND M1254
  MOV K1 D485
  MOV K10 D484

  LD= D484 K10
  SET M3885
  MOV K11 D484

  LD= D484 K11
  AND M1256
  RST M3885
  SET M3880
  MOV K12 D484

  LD= D484 K12
  AND M1250
  RST M3880
  SET M3884
  MOV K13 D484

  LD= D484 K13
  AND M1255
  RST M3884
  SET M3881
  MOV K14 D484

  LD= D484 K14
  AND M1251
  RST M3881
  SET M3885
  MOV K15 D484

  LD= D484 K15
  AND M1256
  RST M3885
  MOV K2 D485
  MOV K0 D484
  MOV K0 D3258
  MOV K1003 D486

; --- デバイス参照(GXW用) ---
  LD X60
  LD X70
  LD X88
  LD M10
  LD M100
  LD M200
  LD M300
  LD M1200
  LD M2000
  LD M3800
  LD D10
  LD D100
  LD D200
  LD D300
  LD D400
  LD D450
  LD D480
  LD D500
  LD D3000
  LD D4000
  LD D5100

END
