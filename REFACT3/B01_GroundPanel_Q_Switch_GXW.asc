  DMOV K0 D3287 	;Out_B01.タスクID1
  MOV K0 D3291 	;Out_B01.AGV行き先1
  DMOV K0 D3289 	;Out_CV1.タスクID2
  MOV K0 D3292 	;Out_B01.AGV行き先2

;[プログラム 14: タスク管理] タスク完了後クリア - CV1
