; B01 地上盤制御プログラム（M8001 オフライン/実装モード切り替え対応版）
; GX Works2 Simpleプロジェクト用 IL形式
;==============================================================================
; B01 地上盤 制御プログラム（M8001 オフライン/実装モード切り替え対応版）
; ベース: REFACT2/B01_GroundPanel_Q_GXW.asc
; M8001=OFF: 実装モード / M8001=ON: オフラインモード
;==============================================================================

;---------- オフラインモード初期化 ----------
  LDP M8001	;オフラインモード立上りパルス
  MOV K0 D456 	;Alarm_Code クリア
  MOV K0 D200 	;STKへ_タスクタイプ クリア
  DMOV K0 D201 	;STKへ_タスクID クリア
  MOV K0 D476 	;連動_PC無/単独_指令状態 クリア
  RST M360	;STK通信異常フラグ OFF
  LDF M8001	;オフラインモード立下りパルス(実装モード復帰)
  MOV K0 D456 	;Alarm_Code クリア

;[プログラム 00: 入力処理] 電源入力
  LD M8001	;オフラインバイパス
  OR X60
  OUT M100	;DI_電源入

;[プログラム 00: 入力処理] 予備 X61

;[プログラム 00: 入力処理] 非常停止PB正常監視 - 二重化入力
  LD M8001	;オフラインバイパス
  LD X62
  AND X63
  ORB
  OUT M40	;非常停止PB_A01正常

;[プログラム 00: 入力処理] 予備 X64-X6B

;[プログラム 00: 入力処理] 盤クーラ異常
  LDI X6C
  ANI M8001	;オフライン時はOFF(正常扱い)
  OUT M112	;DI_盤クーラ異常

;[プログラム 00: 入力処理] Ethernet光伝送異常
  LDI X6D
  ANI M8001	;オフライン時はOFF(正常扱い)
  OUT M113	;DI_Ethernet光伝送異常

;[プログラム 00: 入力処理] 予備 X6E-X6F

;[プログラム 00: 入力処理] 操作モード選択
  LD X70
  OUT M116	;DI_自動選択
  LD X71
  OUT M117	;DI_連動選択

;[プログラム 00: 入力処理] 管理者モード
  LD X72
  OUT M119	;DI_管理者モード入

;[プログラム 00: 入力処理] 操作ボタン
  LD X74
  OUT M120	;DI_異常リセット
  LD X76
  OUT M122	;DI_起動
  LD X77
  OUT M123	;DI_サイクル停止
  LD X78
  OUT M124	;DI_ランプチェック

;[プログラム 00: 入力処理] 運転準備入力 - 二重化
  LD M8001	;オフラインバイパス
  LD X7A
  AND X7B
  ORB
  OUT M10	;運転準備入

;[プログラム 00: 入力処理] STK電源MC状態
  LD M8001	;オフラインバイパス
  OR X7E
  OUT M130	;DI_STK電源_MC_ON

;[プログラム 00: 入力処理] B01安全機器状態 - 二重化入力
  LD M8001	;オフラインバイパス
  LD X80
  AND X81
  ORB
  OUT M132	;DI_B01_非常停止正常
  LD M8001	;オフラインバイパス
  LD X82
  AND X83
  ORB
  OUT M134	;DI_B01_ライトカーテン正常
  LD M8001	;オフラインバイパス
  LD X84
  AND X85
  ORB
  OUT M136	;DI_B01_安全ドアSW正常

;[プログラム 01: CC-Link通信処理(受信)] B01設備状態ビット受信
  LD SM400	;常時ON
  LD M8001	;オフラインバイパス
  OR B00
  OUT M1000	;CCLink_In_B01電源入
  LD M8001	;オフラインバイパス
  OR B01
  OUT M1001	;CCLink_In_B01運転準備入
  LD B02
  ANI M8001	;オフライン時はOFF(重故障なし)
  OUT M1002	;CCLink_In_B01重故障
  LD B03
  ANI M8001	;オフライン時はOFF(軽故障なし)
  OUT M1003	;CCLink_In_B01軽故障
  LD M8001	;オフラインバイパス
  OR B04
  OUT M1004	;CCLink_In_B01非常停止正常
  LD M8001	;オフラインバイパス
  OR B05
  OUT M1005	;CCLink_In_B01安全ドアSW正常
  LD M8001	;オフラインバイパス
  OR B06
  OUT M1006	;CCLink_In_B01CV側ライトカーテン正常
  LD M8001	;オフラインバイパス
  OR B07
  OUT M1007	;CCLink_In_B01AGV側ライトカーテン正常
  LD M8001	;オフラインバイパス
  OR B0A
  OUT M1010	;CCLink_In_B01自動運転中
  LD B0B
  OUT M1011	;CCLink_In_B01サイクル停止中
  LD B0C
  OUT M1012	;CCLink_In_B01手動操作中
  LD B10
  OUT M1016	;CCLink_In_B01自動モード選択
  LD B11
  OUT M1017	;CCLink_In_B01手動モード選択
  LD M8001	;オフラインバイパス
  OR B12
  OUT M1018	;CCLink_In_B01連動モード選択
  LD B13
  OUT M1019	;CCLink_In_B01単独モード選択
  LD B14
  OUT M1020	;CCLink_In_B01管理者モード選択
  LD B20
  OUT M1032	;CCLink_In_B01RFID1読取完了
  LD B21
  OUT M1033	;CCLink_In_B01RFID1読取NG
  LD B22
  OUT M1034	;CCLink_In_B01RFID2読取完了
  LD B23
  OUT M1035	;CCLink_In_B01RFID2読取NG
  LD B27
  OUT M1039	;CCLink_In_B01安全ドアSW無効
  LD B28
  OUT M1040	;CCLink_In_B01ライトカーテン1無効
  LD B29
  OUT M1041	;CCLink_In_B01ライトカーテン2無効
  LD B2A
  OUT M1042	;CCLink_In_B01ライトカーテン3無効
  LD B2B
  OUT M1043	;CCLink_In_B01ライトカーテン4無効
  LD M8001	;オフラインバイパス
  OR B30
  OUT M1048	;CCLink_In_B01CV1_STK受取可
  LD M8001	;オフラインバイパス
  OR B31
  OUT M1049	;CCLink_In_B01CV1_AGV発進可
  LD B33
  OUT M1051	;CCLink_In_B01CV1_CV動作中
  LD B34
  OUT M1052	;CCLink_In_B01CV1_フォーク動作中
  LD B35
  OUT M1053	;CCLink_In_B01CV1_フォークリフタ動作中
  LD B37
  OUT M1055	;CCLink_In_B01CV1_AGV在席
  LD B38
  OUT M1056	;CCLink_In_B01CV1_フォーク在席
  LD B39
  OUT M1057	;CCLink_In_B01CV1_搬入ST在席
  LD B3A
  OUT M1058	;CCLink_In_B01CV1_フォーク戻限
  LD B3B
  OUT M1059	;CCLink_In_B01CV1_フォーク出限
  LD M8001	;オフラインバイパス
  OR B3C
  OUT M1060	;CCLink_In_B01CV1_フォークリフタ下限
  LD M8001	;オフラインバイパス
  OR B3D
  OUT M1061	;CCLink_In_B01CV1_フォークリフタ上限
  LD M8001	;オフラインバイパス
  OR B3E
  OUT M1062	;CCLink_In_B01CV1_搬入リフタ下限
  LD M8001	;オフラインバイパス
  OR B3F
  OUT M1063	;CCLink_In_B01CV1_搬入リフタ上限
  LD M8001	;オフラインバイパス
  OR B40
  OUT M1064	;CCLink_In_B01CV2_STK受渡可
  LD M8001	;オフラインバイパス
  OR B41
  OUT M1065	;CCLink_In_B01CV2_AGV発進可
  LD B43
  OUT M1067	;CCLink_In_B01CV2_CV動作中
  LD B44
  OUT M1068	;CCLink_In_B01CV2_フォーク動作中
  LD B45
  OUT M1069	;CCLink_In_B01CV2_フォークリフタ動作中
  LD B47
  OUT M1071	;CCLink_In_B01CV2_AGV在席
  LD B48
  OUT M1072	;CCLink_In_B01CV2_フォーク在席
  LD B49
  OUT M1073	;CCLink_In_B01CV2_搬出ST在席
  LD B4A
  OUT M1074	;CCLink_In_B01CV2_フォーク戻限
  LD B4B
  OUT M1075	;CCLink_In_B01CV2_フォーク出限
  LD M8001	;オフラインバイパス
  OR B4C
  OUT M1076	;CCLink_In_B01CV2_フォークリフタ下限
  LD M8001	;オフラインバイパス
  OR B4D
  OUT M1077	;CCLink_In_B01CV2_フォークリフタ上限
  LD M8001	;オフラインバイパス
  OR B4E
  OUT M1078	;CCLink_In_B01CV2_搬出リフタ下限
  LD M8001	;オフラインバイパス
  OR B4F
  OUT M1079	;CCLink_In_B01CV2_搬出リフタ上限

;[プログラム 01: CC-Link通信処理(受信)] B01 RFIDデータ受信
  LD SM400	;常時ON
  BMOV W0 D331 K7`t; RFID受信
  BMOV W10 D338 K7`t; RFID受信

;[プログラム 02: STK通信処理(受信)] STK状態データ受信
  LD SM400	;常時ON
  MOV D128 K4M2500`t; STK状態データ受信`r`n
;[プログラム 03: 初期化処理] CV1出庫Forkワーク検出でAGV行先クリア
  LD M8001	;オフラインバイパス
  OR X1003	;从CV1_出庫Fork台ワーク検測
  MOV K0 D421 	;WMSから_入庫AGV行先
  MOV K0 D422 	;WMSから_出庫AGV行先

;[プログラム 09: 異常監視] 非常停止正常まとめ
  LD M102	;DI_A01_非常停止PB正常1
  LD M103	;DI_A01_非常停止PB正常2
  OUT M40	;非常停止正常まとめ

;[プログラム 09: 異常監視] アラームコード設定
  MOV K1 D456 	;Alarm_Code
  MOV K2 D456
  MOV K3 D456
  MOV K4 D456
  MOV K5 D456 	;* B01非常停止異常 *
  MOV K6 D456 	;* B01ライトカーテン異常 *
  MOV K7 D456 	;* B01安全ドアSW異常 *
  MOV K11 D456 	;* STKエラーコード異常 *
  MOV K12 D456 	;* B01エラーコード異常 *

;[プログラム 09: 異常監視] 超寬/超高アラーム(12-13)
; origine: IF CV01超寬検棈1 OR CV01超寬検棈2 AND Alarm=0 THEN Alarm:=12
  LD= D456 K0	;Alarm_Code=0
  AND M1009	;CV01超寬検出1
  MOV K12 D456
  LD= D456 K0
  AND M1010	;CV01超寬検出2
  MOV K12 D456
  LD= D456 K0
  AND M1011	;CV01超高検出
  MOV K13 D456

;[プログラム 09: 異常監視] 光柵アラーム(14-17)
; origine: IF AGV光柵信号=FALSE AND AGV進入中=FALSE AND Alarm=0 THEN Alarm:=14
  LD= D456 K0
  ANI M1012	;AGV入庫光柵信号1=FALSE
  ANI M1700	;AGV進入中=FALSE
  MOV K14 D456
  LD= D456 K0
  ANI M1013	;AGV入庫光柵信号2=FALSE
  ANI M1700
  MOV K14 D456
  LD= D456 K0
  ANI M1014	;AGV出庫光柵信号1=FALSE
  ANI M1710	;AGV離開中=FALSE
  MOV K15 D456
  LD= D456 K0
  ANI M1015	;AGV出庫光柵信号2=FALSE
  ANI M1710
  MOV K15 D456
  LD= D456 K0
  ANI M1016	;CV_IN光柵信号1=FALSE
  AND M1008	;CV01伸縮中位2
  MOV K16 D456
  LD= D456 K0
  ANI M1017	;CV_IN光柵信号2=FALSE
  AND M1008
  MOV K16 D456
  LD= D456 K0
  ANI M1018	;CV_OUT光柵信号1=FALSE
  AND M1056	;Bx03伸縮中位2
  MOV K17 D456
  LD= D456 K0
  ANI M1019	;CV_OUT光柵信号2=FALSE
  AND M1056
  MOV K17 D456

;[プログラム 09: 異常監視] 安全門アラーム(18)
  LD= D456 K0
  ANI M1020	;安全門信号1=FALSE
  MOV K18 D456
  LD= D456 K0
  ANI M1021	;安全門信号2=FALSE
  MOV K18 D456

;[プログラム 09: 異常監視] 坍塌アラーム(19)
  LD= D456 K0
  AND M1022	;入庫坍塌検出
  AND M1008	;CV01伸縮中位2
  MOV K19 D456

;[プログラム 09: 異常監視] CC-Link通信監視
  LD M8001	;オフラインバイパス(通信正常扱い)
  OR SB49
  AND W900.0
  OUT M370	;B01_ON正常
  LD M8001	;オフラインバイパス(通信正常扱い)
  OR SB49
  AND W900.2
  OUT M372	;AGV_ON正常

;[プログラム 09: 異常監視] STK通信監視 - ハートビート
  OUT T1 K30
  LD T1
  ANI M8001	;オフライン時はタイムアウト異常OFF
  OUT M360	;スタッカーSC通信異常
  MOV D115 D3303

;[プログラム 09: 異常監視] 異常リセット処理
  LD M120	;DI_異常リセット
  MOV K0 D456 	;Alarm_Code
  DMOV K0 D4004 	;CV1へ_出庫STタスクID
  DMOV K0 D4001 	;B01へ_ForkSTタスクID
  MOV K0 D4006 	;CV1へ_AGVへ出荷許可
  MOV K0 D4007 	;CV1へ_入庫口RFIDアラーム
  MOV K0 D4008 	;CV1へ_出庫口RFIDアラーム

;[プログラム 10: モード管理] 電源投入遅延
  LD M8001	;オフライン時は電源入と同等扱い
  OR M100	;DI_電源入
  OUT T10 K150	;電源入遅延

;[プログラム 10: モード管理] ハートビット生成
  OUT T0 K999	;ハートビット
  LD T0
  OUT M1

;[プログラム 10: モード管理] 運転準備入
  LD M8001	;オフラインバイパス
  OR M126	;DI_運転準備入1 AND M127 DI_運転準備入2
  OUT M10	;運転準備入
  OUT M158	;DO_運転準備ランプ

;[プログラム 10: モード管理] モード選択
  LD SM400	;常時ON
  LDI M116
  OUT M11	;手動操作選択
  LD M116
  OUT M12	;自動運転選択
  LDI M117
  OUT M13	;単独運転選択
  LD M117
  OUT M14	;連動運転選択

;[プログラム 10: モード管理] PC有効/無効モード
  LD SM400	;常時ON
  LD M207
  SET M19`t; PC有効フラグ
  LD M208
  RST M19`t; PC無効フラグ

;[プログラム 10: モード管理] モード表示灯制御
  LD SM400	;常時ON
  LD M12
  AND M14
  AND M19
  OUT M200	;モード_自動連動PC有PL
  MOV K0 D450 	;Mode
  AND M13
  ANI M19
  OUT M201	;ﾓｰﾄﾞ_自動単独/連動PC無PL
  MOV K1 D450
  LD M11
  OUT M202	;モード_手動PL
  MOV K2 D450

;[プログラム 10: モード管理] WMSタスクタイプクリア - PC無効時
  LD SM401	;常時OFF
  MOV K0 D400 	;WMSから_タスクタイプ
  MOV K0 D401 	;WMSから_タスクID

;[プログラム 10: モード管理] 自動運転開始条件1 - 基本条件
  LD M8001	;オフラインバイパス(条件強制成立)
  OR M10	;運転準備入
  LD M40	;非常停止正常まとめ
  LD M12	;自動運転選択
  LD M2513	;STKから_運転ﾓｰﾄﾞ選択
  LD D102	;STKから_エラーコード
  OUT M20	;自動運転開始条件1

;[プログラム 10: モード管理] 自動運転開始条件2 - CV系準備
  LD M8001	;オフラインバイパス(条件強制成立)
  OR M1010	;CCLink_In_B01自動運転中
  LD M8001	;オフラインバイパス
  OR M1018	;CCLink_In_B01連動ﾓｰﾄﾞ選択
  OUT M21	;自動運転開始条件2

;[プログラム 10: モード管理] 単独/連動PC無 自動運転開始
  LD M20	;自動運転開始条件1
  LD M35	;サイクル停止完了
  LD M201	;ﾓｰﾄﾞ_自動単独/連動PC無PL
  LD M122	;DI_起動
  LD M21
  OUT T11 K50	;単独/連動PC無自動運転開始遅延
  OUT M31	;自動_単独/連動PC無運転中
  LD M31
  OUT T11 K50

;[プログラム 10: モード管理] 連動PC有 自動運転開始
  LD M200	;モード_自動連動PC有PL
  LD M122	;DI_起動
  LD M21
  OUT T12 K50	;連動PC有自動運転開始遅延
  OUT M32	;自動_連動運転中
  LD M32
  OUT T12 K50

;[プログラム 10: モード管理] 運転中表示とSTKへ通知
  LD M31
  OUT M159	;DO_起動ランプ
  OUT M2013	;STKへ_自動運転中

;[プログラム 10: モード管理] サイクル停止
  OUT M15	;サイクル停止選択
  LD M15
  LD SM412
  OUT M160	;DO_サイクル停止ランプ

;[プログラム 10: モード管理] サイクル停止完了
  LD M15
  OUT M35	;サイクル停止完了

;[プログラム 10: モード管理] 手動操作中
  LD M11	;手動操作選択
  OUT M30	;手動操作中
  OUT M2000	;STKへ_手動制御リクエスト

;[プログラム 10: モード管理] WMSタスクタイプ判定 - 連動PC有
  LD= D400 K1`r`n  OUT M3831	;連動PC有_タスクタイプ搬入
  LD= D400 K2`r`n  OUT M3832	;連動PC有_タスクタイプ搬出
  LD= D400 K3`r`n  OUT M3833	;連動PC有_タスクタイプ移庫
  LD= D400 K4`r`n  OUT M3834	;連動PC有_タスクタイプ检修

;[プログラム 10: モード管理] 単独/連動PC無タスクタイプ判定
  LD= D500 K1`r`n  OUT M3821	;単独/連動PC無_ﾀｽｸﾀｲﾌﾟ搬入
  LD= D500 K2`r`n  OUT M3822	;単独/連動PC無_ﾀｽｸﾀｲﾌﾟ搬出
  LD= D500 K3`r`n  OUT M3823	;単独/連動PC無_ﾀｽｸﾀｲﾌﾟ移庫
  LD= D500 K4`r`n  OUT M3824	;単独/連動PC無_ﾀｽｸﾀｲﾌﾟ原位置

;[プログラム 11: 連動PC有モード処理] STK待機状態チェック
  LD= D100 K1`r`n  OUT M3800	;スタッカー_状態待機

;[プログラム 11: 連動PC有モード処理] タスク送信処理 - PC有モード
  LD M200	;モード_自動連動PC有PL
  LD M3818	;地上盤_待機
  LD M3800	;スタッカー_状態待機
  MOV D400 D200 	;STKへ_タスクタイプ
  DMOV D401 D201 	;STKへ_タスクID
  MOV D403 D203 	;STKへ_起点棚
  MOV D404 D204 	;STKへ_起点列
  MOV D405 D205 	;STKへ_起点層
  MOV D406 D206 	;STKへ_終点棚
  MOV D407 D207 	;STKへ_終点列
  MOV D408 D208 	;STKへ_終点層
  MOV K2 D209 	;STKへ_搬入ST番号
  MOV K6 D209
  MOV K0 D209
  MOV K4 D210 	;STKへ_搬出ST番号
  MOV K8 D210
  MOV K0 D210

;[プログラム 12: 単独/連動PC無モード処理] 在庫状態判定 - 終点
  LD D506	;連動_PC無/単独_終点棚
  LD D507	;連動_PC無/単独_終点列
  LD D508	;連動_PC無/単独_終点層
  OUT M3802	;単独/連動PC無終点タスクON
  LD M201
  MOV K0 D473 	;連動_PC無/単独_終点出庫状態
  MOV K1 D473
  MOV K0 D473
  MOV K1 D473
  LD= D473 K1`r`n  OUT M3813	;単独/連動PC無_終点ﾊﾟﾚｯﾄ無

;[プログラム 12: 単独/連動PC無モード処理] 在庫状態判定 - 起点
  LD D503	;連動_PC無/単独_起点棚
  LD D504	;連動_PC無/単独_起点列
  LD D505	;連動_PC無/単独_起点層
  OUT M3801	;単独/連動PC無起点タスクON
  LD M201
  MOV K0 D472 	;連動_PC無/単独_起点出庫状態
  MOV K1 D472
  MOV K0 D472
  MOV K1 D472
  LD= D472 K1`r`n  OUT M3812	;単独/連動PC無_起点有ワーク

;[プログラム 12: 単独/連動PC無モード処理] 搬入台ワーク状態確認
  LD= D509 K0`r`n  OUT M217	;連動PC無_搬入ST状態PL
  LD M217
  MOV K0 D474 	;連動_PC無_搬入台ワーク状態
  MOV K1 D474
  MOV K0 D474
  MOV K1 D474
  MOV K0 D474
  LD= D474 K1`r`n  OUT M3814	;連動PC無_搬入STﾊﾟﾚｯﾄ有

;[プログラム 12: 単独/連動PC無モード処理] 搬出台ワーク状態確認
  LD= D510 K0`r`n  OUT M218	;連動_搬出ST状態PL
  LD M218
  MOV K0 D475 	;連動_PC無_搬出台ワーク状態
  MOV K1 D475
  MOV K0 D475
  MOV K1 D475
  MOV K0 D475
  LD= D475 K1`r`n  OUT M3815	;連動PC無_搬出STﾊﾟﾚｯﾄ無

;[プログラム 12: 単独/連動PC無モード処理] 搬入許可判定
  LD M201
  LD M3800	;STK待機
  LD M8001	;オフラインバイパス
  OR M1010	;B01自動運転中 AND M1018 B01連動モード
  LD D509
  OUT M220	;HMI_単独/連動PC無_搬入許可

;[プログラム 12: 単独/連動PC無モード処理] 搬入タスク発行
  LD M220
  MOV K1 D500 	;連動_PC無/単独_タスクタイプ
  ; LD D (元STコード参照)
  BMOV D331 D3304  K7	;搬入RFID番号

;[プログラム 12: 単独/連動PC無モード処理] タスク発行済み管理
  LD M201
  OUT M3803	;STK単独/連動PC無タスク発行済
  LD D501
  OUT M3804	;STK単独/連動PCタスクID発行済

;[プログラム 12: 単独/連動PC無モード処理] 搬入タスクSTKへ送信
  LD M3804
  LD M3821	;タスクタイプ搬入
  LD M3814	;搬入STパレット有
  LD M3813	;終点パレット無
  MOV D500 D200 	;STKへ_タスクタイプ
  DMOV D501 D201 	;STKへ_タスクID
  MOV D509 D209 	;STKへ_搬入ST番号
  MOV D506 D206 	;STKへ_終点棚
  MOV D507 D207 	;STKへ_終点列
  MOV D508 D208 	;STKへ_終点層
  MOV K1 D476 	;連動_PC無/単独_指令状態

;[プログラム 12: 単独/連動PC無モード処理] 搬出許可判定
  LD M201
  LD D470	;連動_PC無_AGV行き先
  LD M3815	;搬出STパレット無
  LD M3800
  OUT M214	;HMI_単独/連動PC無_搬出許可
  LD M201
  LD M3815
  OUT M214

;[プログラム 12: 単独/連動PC無モード処理] 搬出タスク発行
  LD M214
  MOV K2 D500
  ; LD D (元STコード参照)
  MOV D460  D503 	;起点棚 連動_PC無/単独_現在位置棚
  MOV D461  D504 	;起点列 現在位置列
  MOV D462  D505 	;起点層 現在位置層
  MOV K0 D460
  MOV K0 D461
  MOV K0 D462
  MOV K0 D470 	;AGV行き先

;[プログラム 12: 単独/連動PC無モード処理] 搬出タスクSTKへ送信
  LD M3804
  LD M3822	;タスクタイプ搬出
  LD M3812	;起点有ワーク
  LD M3815	;搬出STパレット無
  MOV D500 D200
  DMOV D501 D201
  MOV D510 D210 	;STKへ_搬出ST番号
  MOV D503 D203 	;STKへ_起点棚
  MOV D504 D204 	;STKへ_起点列
  MOV D505 D205 	;STKへ_起点層
  MOV K2 D476

;[プログラム 12: 単独/連動PC無モード処理] 移庫タスクSTKへ送信
  LD M3804
  LD M3823	;タスクタイプ移庫
  LD M3812	;起点有ワーク
  LD M3813	;終点パレット無
  MOV D500 D200
  DMOV D501 D201
  MOV D503 D203
  MOV D504 D204
  MOV D505 D205
  MOV D506 D206
  MOV D507 D207
  MOV D508 D208
  MOV K3 D476

;[プログラム 12: 単独/連動PC無モード処理] 原位置タスクSTKへ送信
  LD M3804
  MOV D500 D200
  DMOV D501 D201
  MOV K0 D203
  MOV K0 D204
  MOV K0 D205
  MOV K0 D206
  MOV K0 D207
  MOV K0 D208
  MOV K0 D209
  MOV K0 D210
  MOV K4 D476

;[プログラム 12: 単独/連動PC無モード処理] 指令タイムアウト監視
  LD<> D476 K0`r`n  OUT T4 K30
  MOV K0 D476

;[プログラム 13: 手動操作処理] 初期化
  LD SM402	;RUN後1スキャンON
  MOV K0 D10 	;HMI_手動操作機器選択
  LD M30	;手動操作中 AND D455 HMI画面コード
  MOV K0 D10

;[プログラム 13: 手動操作処理] 位置決め/棚位置決め
  LD M30
  OUT M2001	;STKへ__庫位置切替

;[プログラム 13: 手動操作処理] X軸操作 - D10=K10時
  LD M30
  LD M230
  AND M234`t; HMI操作PB
  OUT M2006	;STKへ__X軸前進
  LD M231
  AND M234`t; HMI操作PB
  OUT M2007	;STKへ__X軸後退
  LD M232
  AND M234`t; HMI操作PB
  OUT M2003	;STKへ__X軸定位

;[プログラム 13: 手動操作処理] Y軸操作 - D10=K11時
  LD M30
  LD M230
  OUT M2008	;STKへ__Y軸上昇
  LD M231
  OUT M2009	;STKへ__Y軸下降
  LD M232
  OUT M2004	;STKへ__Y軸定位

;[プログラム 13: 手動操作処理] Z軸操作 - D10=K12時
  LD M30
  LD M230
  OUT M2010	;STKへ__Z軸左伸
  LD M231
  OUT M2011	;STKへ__Z軸右伸
  LD M232
  OUT M2005	;STKへ__Z軸定位

;[プログラム 13: 手動操作処理] 原点復帰
  LD M2514	;STKから_X軸位置決め完了
  LD M2515	;STKから_Y軸位置決め完了
  OUT M50	;XY軸位置決め完了
  LD M30
  LD M2501	;STKから_Fork在中位
  OUT M2012	;STKへ_原点位置へ動作
  LD M2012
  MOVP K0 D10
  LD M50
  OUT T15 K3

;[プログラム 14: タスク管理] B01タスク待機状態
  LD= D3287 K0`r`n  OUT M3807	;B01タスク待機
  LD= D3291 K0`r`n  OUT M3808	;B01 AGV行き先空

;[プログラム 14: タスク管理] 搬入指令生成
  LD M200	;モード_自動連動PC有PL
  LD M3831	;連動PC有_タスクタイプ搬入
  LD D201	;STKへ_タスクID = D104 STKから_現在タスクID
  LD D103	;STKから_タスク状態
  OUT M3805	;CVライン_搬入指令
  LD M201	;ﾓｰﾄﾞ_自動単独/連動PC無PL
  LD M3821	;単独/連動PC無_ﾀｽｸﾀｲﾌﾟ搬入
  OUT M3805

;[プログラム 14: タスク管理] 搬入処理 - B01 CV1
  LD M3805
  LD M8001	;オフラインバイパス
  OR M1010	;CCLink_In_B01自動運転中
  LD M8001	;オフラインバイパス
  OR M1018	;CCLink_In_B01連動ﾓｰﾄﾞ選択
  LD M8001	;オフラインバイパス
  OR M1048	;CCLink_In_B01CV1_STK受取可
  LD D331	;WMＳへ_入庫搬入RFID読み値
  BMOV D331 D3304  K7	;搬入RFID番号

;[プログラム 14: タスク管理] ForkSTタスクID発行 - B01
  LD SM401	;常時OFF
  LD D104
  LD D3002	;CV1から_設備状態
  LD D3027	;B01から_搬入フローワード
  LD D3003	;B01から_エラーコード
  LD D104
  LD M8001	;オフラインバイパス
  OR X1000	;从CV1_入庫Fork台ワーク検測
  LD D331
  DMOV D104 D4001
  BMOV D331 D3304 K7

;[プログラム 14: タスク管理] ForkSTタスク完了クリア - B01
  LD SM401
  LD D4001
  LD D3003
  DMOV K0 D4001

;[プログラム 14: タスク管理] 搬出タスク管理 - AGV行き先設定（B01）
  LD M214	;HMI_単独/連動PC無_搬出許可
  LD M213	;HMI_単独/連動PC無_搬出PB
  LD M3807	;B01タスク待機
  LD M3808	;B01 AGV行き先空
  DMOV D501 D3287 	;Out_B01.タスクID1
  MOV D470  D3291 	;Out_B01.AGV行き先1 連動_PC無_AGV行き先
  DMOV D501 D3289 	;Out_CV1.タスクID2
  MOV D470 D3292 	;Out_B01.AGV行き先2

;[プログラム 14: タスク管理] 出庫STタスクID発行 - CV1
  LD SM401
  LD D3301
  LD D3002	;CV1から_設備状態
  LD D3028	;CV1から_出庫フローワード
  LD D3003	;B01から_エラーコード
  LD D3301
  LD M8001	;オフラインバイパス
  OR X1005	;从CV1_出庫台ワーク検測
  DMOV D3301 D4004
  DMOV K0 D3301

;[プログラム 14: タスク管理] 出庫STタスク完了クリア - CV1
  LD SM401
  LD D4004
  LD D3003
  DMOV K0 D4004

;[プログラム 14: タスク管理] AGV発進許可処理 - B01
  LD M8001	;オフラインバイパス
  OR M1010	;B01自動運転中
  LD M8001	;オフラインバイパス
  OR M1018	;B01連動モード
  LD M2511	;STKから_受渡完了
  LD M1073	;B01CV2搬出ST在席
  OUT M3816	;B01搬出AGVレディ
  OUT M3816
  LD M3816
  MOV D3292 W0`t; RFID出力
  LD SM401
  LD D3010	;CV1から_ST1003タスクID
  LD D3010
  MOV D3291  D4006 	;CV1へ_AGVへ出荷許可 Out_B01.AGV行き先1
  DMOV K0 D3287
  MOV K0 D3291
  MOV D3292  D4006	;Out_B01.AGV行き先2
  DMOV K0 D3289
  MOV K0 D3292

;[プログラム 14: タスク管理] タスク全クリア - モード切替時等
  LD SM401
  DMOV K0 D3287 	;Out_B01.タスクID1
  MOV K0 D3291 	;Out_B01.AGV行き先1
  DMOV K0 D3289 	;Out_CV1.タスクID2
  MOV K0 D3292 	;Out_B01.AGV行き先2

;[プログラム 14: タスク管理] タスク完了後クリア - CV1
  LD SM401
  LD D103
  LD M8001	;オフラインバイパス
  OR X1005	;从CV1_出庫台ワーク検測
  DMOV K0 D3287
  MOV K0 D3291
  DMOV K0 D3289
  MOV K0 D3292
  DMOV K0 D3301
  LD M8001	;オフラインバイパス
  OR X1005
  DMOV K0 D3287
  MOV K0 D3291
  DMOV K0 D3289
  MOV K0 D3292
  DMOV K0 D3301

;[プログラム 30: HMI処理] タスクタイプ表示
  LD= D500 K1`r`n  OUT M300	;HMI_単独入庫タイプPL
  LD= D500 K2`r`n  OUT M301	;HMI_単独出庫タイプPL
  LD= D500 K3`r`n  OUT M302	;HMI_単独移库タイプPL
  LD= D400 K1`r`n  OUT M303	;HMI_連動入庫タイプPL
  LD= D400 K2`r`n  OUT M304	;HMI_連動出庫タイプPL
  LD= D400 K3`r`n  OUT M305	;HMI_連動移库タイプPL
  LD= D200 K1`r`n  OUT M306	;HMI_Auto入庫タイプPL
  LD= D200 K2`r`n  OUT M307	;HMI_Auto出庫タイプPL
  LD= D200 K3`r`n  OUT M308	;HMI_Auto移库タイプPL

;[プログラム 30: HMI処理] 管理者モード切替条件
  LD SM401	;常時OFF
  MOV K0 D454 	;パスワード許可
  OUT M156	;DO_積層灯BZ4

;[プログラム 30: HMI処理] 管理者画面切替有効条件
  LD M11	;手動操作選択
  OUT M920	;管理者画面切替有効条件

;[プログラム 30: HMI処理] パスワード設定
  LD SM400	;常時ON
  MOV K55 D5120 	;安全機器ﾊﾟｽﾜｰﾄﾞ設定値

;[プログラム 30: HMI処理] パスワード確認処理
  LD M920
  MOV K10 D5100 	;GOT画面切替番号
  MOV K0 D5101 	;GOTｵｰﾊﾞﾗｯﾌﾟｳｨﾝﾄﾞｳ1
  MOV K12 D5101

;[プログラム 30: HMI処理] パスワード入力クリア
  LD M922
  MOV K0 D5121

;[プログラム 30: HMI処理] 管理者画面終了
  MOV K0 D5101

;[プログラム 30: HMI処理] 安全機器一時解除有効
  LD M920
  OUT M921	;安全機器一時解除有効

;[プログラム 30: HMI処理] 画面復帰
  LD M921
  MOVP K1 D5100

;[プログラム 30: HMI処理] 異常発生時アラーム画面へ
  LD D456	;Alarm_Code
  MOVP K5 D455 	;HMI画面コード

;[プログラム 40: 出力処理] 積層灯制御
  LD SM400	;常時ON
  LD M150	;DO_積層灯R OR M124 DI_ランプチェック
  OUT Y90	;積層灯R
  LD M151	;DO_積層灯Y
  OUT Y91	;積層灯Y
  LD M152	;DO_積層灯G
  OUT Y92	;積層灯G
  LD M153
  OUT Y93	;積層灯BZ1
  LD M154
  OUT Y94	;積層灯BZ2
  LD M155
  OUT Y95	;積層灯BZ3
  LD M156
  OUT Y96	;積層灯BZ4

;[プログラム 40: 出力処理] 操作パネルランプ
  LD SM400	;常時ON
  LD M158	;DO_運転準備ランプ
  OUT Y98	;DO_運転準備ランプ
  LD M159	;DO_起動ランプ
  OUT Y99	;DO_起動ランプ
  LD M160	;DO_サイクル停止ランプ
  OUT Y9A	;DO_サイクル停止ランプ

;[プログラム 41: CC-Link通信処理(送信)] B01制御データ送信
  LD SM400	;常時ON
  LD M100
  OUT B1000
  LD M10
  OUT B1001
  LD M102
  AND M103
  OUT B1004
  LD M31
  OUT B100A
  LD M15
  OUT B100B
  LD M30
  OUT B100C
  LD M12
  OUT B1010
  LD M11
  OUT B1011
  LD M14
  OUT B1012
  LD M13
  OUT B1013
  LD M119
  OUT B1014
  LD M12
  AND M14
  AND M122
  OUT B101A
  LD M123
  OUT B101B
  LD K2
  AND M2508
  OUT B1020
  LD K2
  AND M2510
  OUT B1021
  LD K4
  AND M2509
  OUT B1022
  LD K4
  AND M2511
  OUT B1023

;[プログラム 42: STK通信処理(送信)] ハートビット送信
  LD SM400	;常時ON
  MOV T0  D211 	;STKへ_系统ハートビット ハートビット

;[プログラム 42: STK通信処理(送信)] 搬入受取可 - B01
; origine: IF 入庫口頂升上限 AND 入庫口物料有 THEN 允許取庫=1 ELSE =0
  LD SM400	;常時ON
  MOV K0 D212	;STKへ_搬入受取可 デフォルト=0
  LD M1000	;入庫口頂升上限
  AND M1004	;入庫口物料到位
  MOV K1 D212	;条件成立時 搬入受取可=1

;[プログラム 42: STK通信処理(送信)] 搬出受渡可 - B01
; origine: IF 出庫口頂升上限 AND 出庫口物料=FALSE THEN 允許放庫=1 ELSE =0
  LD SM400	;常時ON
  MOV K0 D214	;STKへ_搬出受渡可 デフォルト=0
  LD M1048	;出庫口頂升上限
  ANI M1052	;出庫口物料なし
  MOV K1 D214	;条件成立時 搬出受渡可=1

;[プログラム 42: STK通信処理(送信)] モード送信
  LD SM400	;常時ON
  MOV K0 D216 	;STKへ_モード
  MOV K2 D216

;[プログラム 42: STK通信処理(送信)] リセット送信
  LD SM400	;常時ON
  MOV K1 D217 	;STKへ_リセット
  MOV K0 D217

;[プログラム 42: STK通信処理(送信)] 手動制御リクエスト
  LD SM400	;常時ON
  MOV K4M2000  D224 	;STKへ_Control_Bit STKへ_手動制御リクエスト

;[プログラム 42: STK通信処理(送信)] 非常停止状態
  LD M134
  ANI M8001	;オフライン時は非常停止なし扱い
  LD M136
  ANI M8001	;オフライン時は非常停止なし扱い
  MOV K0 D225 	;STKへ_非常停止
  MOV K1 D225

;[プログラム 43: WMS通信処理] STK状態データ転送
  LD SM400	;常時ON
  MOV D100 D300 	;WMSへ_スタッカー状態
  MOV D101 D301 	;WMSへ_自動フローワード
  MOV D102 D302 	;WMSへ_エラーコード
  MOV D103 D303 	;WMSへ_タスク状態
  DMOV D104 D304 	;WMSへ_現在タスクID
  DMOV D106 D306 	;WMSへ_タスク実行総回数
  MOV D108 D308 	;WMSへ_走行現在位置
  MOV D109 D309 	;WMSへ_昇降現在位置
  MOV D110 D310 	;WMSへ_Fork現在位置
  MOV D111 D311 	;WMSへ_走行現在速度
  MOV D112 D312 	;WMSへ_昇降現在速度
  MOV D113 D313 	;WMSへ_Fork現在速度
  MOV D114 D314 	;WMSへ_現在モード
  MOV D115 D315 	;WMSへ_ハートビート

;[プログラム 43: WMS通信処理] 地上盤状態送信
  LD SM400	;常時ON
  MOV D450  D321 	;WMSへ_地上盤現在モード Mode

;[プログラム 43: WMS通信処理] 地上盤状態判定
; origine: IF Mode>1 THEN 状態=0; IF Mode<=1 AND Alarm=0 THEN 状態=1; IF Alarm<>0 THEN 状態=3
  LD SM400	;常時ON
  MOV K0 D322	;WMSへ_地上盤状態 デフォルト=0
  LD<= D450 K1	;Mode <= 1 (自動モード)
  AND= D456 K0	;Alarm_Code = 0
  AND M159	;DO_起動ランプ
  MOV K1 D322	;設備状態=1(正常就緒)
  LD<> D456 K0	;Alarm_Code <> 0
  MOV K3 D322	;設備状態=3(異常)
; 設備静止中判定
  LD= D460 K0	;入庫Step=0
  AND= D464 K0	;出庫Step=0
  OUT M3818	;地上盤_待機

;[プログラム 43: WMS通信処理] エラーコード送信
  LD SM400	;常時ON
  MOV D456 D323 	;WMSへ_地上盤エラーコード

;[プログラム 43: WMS通信処理] B01タスク状態送信
  LD SM400	;常時ON
  MOV D3004 D324 	;WMSへ_入庫搬入タスク状態
  MOV D3005 D325 	;WMSへ_入庫搬入ForkタスクID
  DMOV D3006 D326 	;WMＳへ_入庫搬入台タスクID
  MOV D3009 D328 	;WMＳへ_入庫搬出タスク状態
  DMOV D3010 D329 	;WMＳへ_入庫搬出台タスクID
  BMOV D3013 D331  K7	;WMＳへ_入庫搬入RFID読み値
  BMOV D3020 D338  K7	;WMＳへ_入庫搬出RFID読み値
  BMOV W1000 D331 K7
  BMOV W1010 D338 K7

;[プログラム 43: WMS通信処理] 搬出可状態送信
  LD SM400	;常時ON
  MOV D214 D366 	;WMＳへ_入庫搬出可
  MOV D3030 D368 	;WMＳへ_入庫搬出AGV受渡完了

;==============================================================================
; 【プログラム 45】光柵屏蔽制御
;==============================================================================
; origine: IF CV01伸縮中位2=FALSE OR HMI.入庫光柵屏蔽 THEN 屏蔽CV_IN光柵=TRUE

; --- CV_IN光柵屏蔽 ---
  LD SM400
  ANI M1008	;CV01伸縮中位2=FALSE(フォーク動作中)
  OR M1900	;HMI.入庫光柵屏蔽
  OUT M3890	;DO_屏蔽CV_IN光柵信号1
  OUT M3891	;DO_屏蔽CV_IN光柵信号2

; --- CV_OUT光柵屏蔽 ---
  LD SM400
  ANI M1056	;Bx03伸縮中位2=FALSE(フォーク動作中)
  OR M1901	;HMI.出庫光柵屏蔽
  OUT M3892	;DO_屏蔽CV_OUT光柵信号1
  OUT M3893	;DO_屏蔽CV_OUT光柵信号2

; --- 安全門屏蔽 ---
  LD M1902	;HMI.安全門屏蔽
  OUT M3894	;DO_屏蔽安全門信号1
  OUT M3895	;DO_屏蔽安全門信号2

;==============================================================================
; 【プログラム 46】安全ドアロック制御
;==============================================================================
; origine: IF 解鍤1安全門 THEN 開錠=FALSE, 鎖住=TRUE ELSE 開錠=TRUE, 鎖住=FALSE
  LD M1023	;解鍤1安全門
  OUT M3897	;DO_鎖住安全門
  LDI M1023
  OUT M3896	;DO_開錠指示

;==============================================================================
; 【プログラム 47】フォーク零点判定
;==============================================================================
; origine: Fork_在零点 := CV01伸縮中位1 AND CV01伸縮中位2 AND 位置>-2 AND 位置<2

; --- 入庫フォーク零点判定 ---
  LD M1007	;CV01伸縮中位1
  AND M1008	;CV01伸縮中位2
  AND> D184 K-2	;入庫庫叉位置>-2
  AND< D184 K2	;入庫庫叉位置<2
  OUT M1730	;入庫Fork_在零点

; --- 出庫フォーク零点判定 ---
  LD M1055	;Bx03伸縮中位1
  AND M1056	;Bx03伸縮中位2
  AND> D188 K-2	;出庫庫叉位置>-2
  AND< D188 K2	;出庫庫叉位置<2
  OUT M1731	;出庫Fork_在零点

;==============================================================================
; 【プログラム 50】入庫搬送シーケンス (Store FB)
;==============================================================================
; デバイス割当:
; D460:入庫Step  D461:入庫タスク状態  D462:入庫タスクID  D468:単機入庫ID
; M1000:入庫口頂升上限  M1001:入庫口頂升下限  M1002:庫叉頂升上限  M1003:庫叉頂升下限
; M1004:入庫口物料到位  M1005:入庫口減速  M1006:庫叉位置物料検出
; M1007:庫叉伸出到位  M1008:庫叉縮回到位
; M1702:AGV就緒  M1703:AGV停止  M1704:AGV物料探検
; M3832:入庫口頂升上昇  M3833:入庫口頂升下降  M3834:庫叉頂升上昇  M3835:庫叉頂升下降
; M3836:庫送線制御  M3837:庫送線低速  M3838:庫叉伸出  M3839:庫叉縮回
;------------------------------------------------------------------------------

; --- 安全ガード: Mode>1 OR Step=0 OR Alarm時 全制御OFF ---
  LD> D450 K1
  OR= D460 K0
  OR<> D456 K0
  RST M3832
  RST M3833
  RST M3834
  RST M3835
  RST M3836
  RST M3837
  RST M3838
  RST M3839

; --- Alarm発生時 強制停止 ---
  LD<> D456 K0
  AND<> D460 K0
  MOV K0 D460	;Step1 := 0
  MOV K3 D461	;タスク状態 := 3(異常)

; --- 連動モード入庫タスク開始 ---
  LD= D322 K1	;設備状態=1
  AND= D450 K0	;Mode=0(連動)
  AND<> D3200 D462	;庫叉任務ID<>現任務ID
  AND<> D3200 K0
  AND= D460 K0	;Step=0
  AND= D456 K0	;Alarm=0
  AND M1006	;庫叉物料あり
  ANI M1004	;入庫口物料なし
  MOV D3200 D462
  MOV K1 D461
  MOV K1 D460
  MOV K0 D3030

; --- 単独モード入庫タスク開始 ---
  LD= D322 K1
  AND= D450 K1	;Mode=1(単独)
  AND<> D468 D462
  AND<> D468 K0
  AND= D460 K0
  AND= D456 K0
  AND M1006
  ANI M1004
  MOV D468 D462
  MOV K1 D461
  MOV K1 D460
  MOV K0 D3030

; --- Step1: 入庫口リフタ下降 ---
  LD= D460 K1
  AND M1006
  ANI M1004
  ANI M1001	;下限でない
  SET M3833	;入庫口頂升下降ON

  LD= D460 K1
  AND M1001	;下限到達
  RST M3833
  MOV K2 D460

; --- Step2: 庫送線搬送 ---
  LD= D460 K2
  AND M1001
  SET M3836	;庫送線ON

  LD= D460 K2
  AND M1005	;減速検出
  SET M3837	;庫送線低速ON

  LD= D460 K2
  AND M1004	;物料到位
  RST M3836
  RST M3837
  MOV K3 D460

; --- Step3: 入庫口リフタ上昇 ---
  LD= D460 K3
  AND M1004
  SET M3832	;入庫口頂升上昇ON
  MOV K4 D460

; --- Step4: 完了 ---
  LD= D460 K4
  AND M1000	;上限到達
  RST M3832
  MOV K2 D461	;タスク状態=2(完了)
  MOV K0 D460
  MOV K0 D468
  MOV K0 D3200

; --- AGV→庫叉 タスク開始 ---
  LD= D322 K1
  AND<= D450 K1	;Mode<=1
  AND M1702	;AGV就緒
  AND M1703	;AGV停止
  AND= D460 K0
  AND= D456 K0
  AND M1704	;AGV物料あり
  ANI M1006	;庫叉物料なし
  MOV K1001 D462
  MOV K1 D461
  MOV K10 D460

; --- Step10: 庫叉リフタ下降 ---
  LD= D460 K10
  AND M1704
  ANI M1006
  ANI M1003	;庫叉下限でない
  SET M3835	;庫叉頂升下降ON

  LD= D460 K10
  AND M1003	;庫叉下限到達
  RST M3835
  MOV K11 D460

; --- Step11: 庫叉伸出 ---
  LD= D460 K11
  AND M1003
  SET M3838	;庫叉伸出ON
  MOV K12 D460

; --- Step12: 庫叉頂升上昇(物料持上げ) ---
  LD= D460 K12
  AND M1007	;庫叉伸出到位
  RST M3838
  SET M3834	;庫叉頂升上昇ON
  MOV K13 D460

; --- Step13: 庫叉頂升上限→縮回 ---
  LD= D460 K13
  AND M1002	;庫叉頂升上限
  RST M3834
  SET M3839	;庫叉縮回ON
  MOV K14 D460

; --- Step14: 庫叉縮回完了→下降 ---
  LD= D460 K14
  AND M1008	;庫叉縮回到位
  RST M3839
  SET M3835	;庫叉頂升下降ON
  MOV K15 D460

; --- Step15: 下降完了 ---
  LD= D460 K15
  AND M1003	;庫叉下限到達
  RST M3835
  MOV K2 D461	;タスク状態=2(完了)
  MOV K0 D460
  MOV K1001 D3030	;AGV取庫完了=1001

;==============================================================================
; 【プログラム 51】出庫搬送シーケンス (Outbound FB)
;==============================================================================
; デバイス割当:
; D464:出庫Step  D465:出庫タスク状態  D466:出庫タスクID  D470:単機出庫ID
; M1048:出庫口頂升上限  M1049:出庫口頂升下限  M1050:庫叉頂升上限  M1051:庫叉頂升下限
; M1052:出庫口物料到位  M1053:庫叉位置減速  M1054:庫叉位置物料検出
; M1055:庫叉伸出到位  M1056:庫叉縮回到位
; M1712:AGV就緒  M1713:AGV停止  M1714:AGV物料探検
; M3848:出庫口頂升上昇  M3849:出庫口頂升下降  M3850:庫叉頂升上昇  M3851:庫叉頂升下降
; M3852:庫送線制御  M3853:庫送線低速  M3854:庫叉伸出  M3855:庫叉縮回
;------------------------------------------------------------------------------

; --- 安全ガード ---
  LD> D450 K1
  OR= D464 K0
  OR<> D456 K0
  RST M3848
  RST M3849
  RST M3850
  RST M3851
  RST M3852
  RST M3853
  RST M3854
  RST M3855

; --- Alarm発生時 強制停止 ---
  LD<> D456 K0
  AND<> D464 K0
  MOV K0 D464
  MOV K3 D465

; --- 連動モード出庫タスク開始 ---
  LD= D322 K1
  AND= D450 K0
  AND<> D3210 D466	;出庫任務ID<>現任務ID
  AND= D464 K0
  AND= D456 K0
  ANI M1054	;庫叉物料なし
  AND M1052	;出庫口物料あり
  MOV D3210 D466
  MOV K1 D465
  MOV K1 D464

; --- 単独モード出庫タスク開始 ---
  LD= D322 K1
  AND= D450 K1
  AND<> D470 D466
  AND= D464 K0
  AND= D456 K0
  ANI M1054
  AND M1052
  MOV D470 D466
  MOV K1 D465
  MOV K1 D464

; --- Step1: 出庫口リフタ下降 ---
  LD= D464 K1
  ANI M1054
  AND M1052
  SET M3849	;出庫口頂升下降ON
  MOV K2 D464

; --- Step2: 出庫口下限→庫叉下降→庫送線開始 ---
  LD= D464 K2
  AND M1049	;出庫口下限到達
  RST M3849
  ANI M1051	;庫叉下限でない
  SET M3851	;庫叉頂升下降ON

  LD= D464 K2
  AND M1051	;庫叉下限到達
  RST M3851
  SET M3852	;庫送線ON
  MOV K3 D464

; --- Step3: 庫送線搬送(減速→物料到位) ---
  LD= D464 K3
  AND M1053	;減速検出
  SET M3853	;庫送線低速ON

  LD= D464 K3
  AND M1054	;物料到位
  RST M3852
  RST M3853
  MOV K4 D464

; --- Step4: 出庫口物料なし→リフタ上昇 ---
  LD= D464 K4
  ANI M1052	;出庫口物料なし
  SET M3848	;出庫口頂升上昇ON
  MOV K5 D464

; --- Step5: 完了 ---
  LD= D464 K5
  AND M1048	;上限到達
  RST M3848
  MOV K2 D465	;タスク状態=2(完了)
  MOV K0 D464
  MOV K0 D470
  MOV K0 D3210

; --- 庫叉→AGV タスク開始 ---
  LD= D322 K1
  AND<= D450 K1
  AND M1712	;AGV就緒
  AND M1713	;AGV停止
  AND= D464 K0
  AND= D456 K0
  ANI M1714	;AGV物料なし
  AND M1054	;庫叉物料あり
  MOV K1 D465
  MOV K10 D464

; --- Step10: 庫叉縮回(零点でない場合) ---
  LD= D464 K10
  ANI M1714
  AND M1054
  SET M3855	;庫叉縮回ON
  MOV K11 D464

; --- Step11: 庫叉縮回完了→庫叉頂升上昇 ---
  LD= D464 K11
  AND M1056	;庫叉縮回到位
  RST M3855
  SET M3850	;庫叉頂升上昇ON
  MOV K12 D464

; --- Step12: 庫叉上限→庫叉伸出 ---
  LD= D464 K12
  AND M1050	;庫叉頂升上限
  RST M3850
  SET M3854	;庫叉伸出ON
  MOV K13 D464

; --- Step13: 庫叉伸出到位→庫叉頂升下降 ---
  LD= D464 K13
  AND M1055	;庫叉伸出到位
  RST M3854
  SET M3851	;庫叉頂升下降ON
  MOV K14 D464

; --- Step14: 庫叉下限→庫叉縮回 ---
  LD= D464 K14
  AND M1051	;庫叉下限到達
  RST M3851
  SET M3855	;庫叉縮回ON
  MOV K15 D464

; --- Step15: 縮回完了 ---
  LD= D464 K15
  AND M1056	;庫叉縮回到位
  RST M3855
  MOV K2 D465	;タスク状態=2(完了)
  MOV K0 D464
  MOV K0 D3210
  MOV K1003 D466	;タスクID=1003

; --- デバイス参照(GXW用) ---
  LD X60
  LD X70
  LD X80
  LD M10
  LD M100
  LD M200
  LD M300
  LD M1000
  LD M2000
  LD M3800
  LD D10
  LD D100
  LD D200
  LD D300
  LD D400
  LD D450
  LD D460
  LD D500
  LD D3000
  LD D4000
  LD D5100

END
