  DMOV D501 D201
  MOV D503 D203
  MOV D504 D204
  MOV D505 D205
  MOV D506 D206
  MOV D507 D207
  MOV D508 D208
  MOV K3 D476

;[プログラム 12: 単独/連動PC無モード処理] 原位置タスクSTKへ送信
