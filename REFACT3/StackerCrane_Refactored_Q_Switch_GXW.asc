  K2 T50
  T50
  RST M9


;******************************************************************************
; BLOCK_02: 入力処理
;******************************************************************************

;【02-00】デジタル入力マッピング - オフライン時バイパス
( 250)
  SM400
  M8001                    ; オフラインモード: 点検/運転SSW → 運転SSW ON(M602=ON)扱い
  OR X42 M602              ; 点検/運転SSW
  X43 M603                 ; 異常リセットKSW（バイパスなし）
  X44 M604                 ; 管理者モードKSW（バイパスなし）

( 255)
  ; 走行系センサ - オフライン時はOFF固定（障害物なし）
  SM400
  ANI M8001                ; オフライン時OFF
  LD X46 M606              ; 走行前方障害物減速
  LD X47 M607              ; 走行前方障害物停止
  LD X48 M608              ; 走行後方障害物減速
  LD X49 M609              ; 走行後方障害物停止
  LD X4C M612              ; 走行前方オーバーRUN
  LD X4D M613              ; 走行後方オーバーRUN
  LD X4E M614              ; 走行減速

( 265)
  ; 昇降系センサ - オフライン時はOFF固定（異常なし）
