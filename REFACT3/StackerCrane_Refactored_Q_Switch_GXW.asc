  MOV D402 D3077           ; 現在所在層
  MOV D406 D3079           ; ワーニングコード

; --- 3400 ---
  ; 状態ビット
  MOV K4M2000 D3078        ; Status_Bit
  LD M35
  OUT M2000	; 地上手動操作中
  LD M96
  OUT M2001	; フォーク中位
  LD M612
  OUT M2002	; 前進到位
  LD M613
  OUT M2003	; 後退到位
  LD M616
  OUT M2004	; 上昇到位
  LD M617
  OUT M2005	; 下降到位
  LD M624
  OUT M2006	; 左伸到位
  LD M625
  OUT M2007	; 右伸到位
  LD M90
  OUT M2008	; 受取中
  LD M91
  OUT M2009	; 受渡中
  LD M92
  OUT M2010	; 受取完了
  LD M93
  OUT M2011	; 受渡完了
  LD M11
  OUT M2012	; 点検モード選択
  LD M12
  OUT M2013	; 運転モード選択
  LD M416
  OUT M2014	; X軸位置到達
  LD M437
  OUT M2015	; Y軸位置到達

; --- 3450 ---
