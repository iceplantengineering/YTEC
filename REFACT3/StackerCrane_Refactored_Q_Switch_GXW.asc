  MOVP K0 D330
  MOVP K0 D333
  MOVP K0 D334
  MOVP K0 D335
  MOVP K0 D336
  MOVP K0 D337
  MOVP K0 D338
  MOVP K0 D339
  MOVP K0 D340

( 200)
