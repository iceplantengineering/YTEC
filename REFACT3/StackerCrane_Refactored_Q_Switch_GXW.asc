; BLOCK_10: 出力処理
;******************************************************************************

;------------------------------------------------------------------------------
; 【10-00】デジタル出力 - 統合版
;------------------------------------------------------------------------------
; --- 3550 ---
  ; 積層灯
  M670 Y80                 ; 積層灯 R(赤)
  M671 Y81                 ; 積層灯 Y(黄)
  M672 Y82                 ; 積層灯 G(緑)
  M673 Y83                 ; 積層灯 BZ(ブザー)

; --- 3560 ---
  ; 障害物回避モード
