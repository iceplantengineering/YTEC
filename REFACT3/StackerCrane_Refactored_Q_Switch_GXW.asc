  FLT D382 D3262           ; Y軸位置決め位置
  FLT D384 D3260           ; Z軸位置決め位置
  MOV D386 D3259           ; X庫位列
  MOV D387 D3258           ; Y庫位層

;------------------------------------------------------------------------------
; 【08-01】手動X軸位置決め - 簡素化版
;------------------------------------------------------------------------------
