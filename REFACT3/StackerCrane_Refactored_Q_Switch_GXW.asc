  ANI M8001
  LD X70 M648              ; 盤クーラ異常
  LD X71 M649              ; 光通信センサ異常
  LD X7A M658              ; メンテピン格納1
  LD X7B M659              ; メンテピン格納2

( 310)
  ; INV電源確認 - オフライン時はON固定（電源あり）
  M8001                    ; オフライン: 走行ドライブ電源ON固定
  OR X5D M629
  M8001
  OR X5E M630
  M8001
  OR X5F M631
  M8001
  OR X74 M652              ; 走行INV MC ON
  M8001
  OR X75 M653              ; 昇降INV MC ON
  M8001
  OR X76 M654              ; 伸縮INV MC ON

;【02-01】フォーク中位検出
( 330)
  M8001                    ; オフライン: フォーク中位強制SET
  OR M626
  M8001
  OR M627
  SET M95

( 335)
  M626
  ANI M8001
  RST M95

( 337)
  M627
  ANI M8001
  RST M95

;【02-02】フォーク原点検出
( 340)
  M8001                    ; オフライン: フォーク原位置強制SET
  OR_LD
  M95
  D321 E>= E-2
  D321 E< E2
  ORB
  SET M96

( 345)
  M95
  ANI M8001
  RST M96

;【02-03】地上盤通信データ受信 - オフライン時バイパス
( 360)
  SM400
  ANI M8001                ; オフライン時はU2受信スキップ
  BMOV U2\G4096 D3000 K30

( 365)
  ; タスク情報（実装時のみ受信）
  SM400
  ANI M8001
  MOV D3000 D330
  DMOV D3001 D331
  MOV D3003 D333
  MOV D3004 D334
  MOV D3005 D335
  MOV D3006 D336
  MOV D3007 D337
  MOV D3008 D338
  MOV D3009 D339
  MOV D3010 D340

( 380)
  ; 制御ビット情報（実装時のみ受信）
  SM400
  ANI M8001
  MOV D3024 K4M2500
  M2500 M535
  M2501 M523
  M2502 M530
  M2503 M520
  M2504 M521
  M2505 M522
  M2506 M524
  M2507 M525
  M2508 M526
  M2509 M527
  M2510 M528
  M2511 M529
  M2512 M531
  M2513 M539

( 400)
  ; モード・状態情報（実装時: 受信データ判定 / オフライン時: 自動モード固定）
  M8001                    ; オフライン: 自動運転モード固定
  OR_LD
  D3016 = K0 M3220         ; 自動運転モード
  ORB
  OUT M3220
  D3016 = K2 M3221         ; 手動運転モード
  ANI M8001
  D3017 = K1 M3217         ; リセット
  D3018 = K1 M3218         ; 一時停止
  D3025 = K1 M3219         ; 非常停止
  ANI M8001                ; オフライン時は非常停止フラグOFF

( 410)
  ; 搬入搬出可能フラグ（オフライン: 全て許可）
  M8001                    ; オフライン: B01搬入可 ON固定
  OR_LD
  D3012 = K1 M3208
  ORB
  OUT M3208
  M8001
  OR_LD
  D3013 = K1 M3210
  ORB
  OUT M3210
  M8001
  OR_LD
  D3014 = K1 M3213
  ORB
  OUT M3213
  M8001
  OR_LD
  D3015 = K1 M3215
  ORB
  OUT M3215


;******************************************************************************
; BLOCK_03: 軸制御共通処理
;******************************************************************************

;【03-00】U0(軸制御ユニット)データ受信 - オフライン時スキップ
( 450)
  SM400
  ANI M8001                ; オフライン時はU0受信スキップ
  BMOV U0\G4096 D100 K8
  ANI M8001
  BMOV U0\G4112 D110 K8
  ANI M8001
  BMOV U0\G4128 D120 K8

( 460)
  ; 状態ワード展開（実装時）
  SM400
  ANI M8001
  MOV D100 K4M200
  ANI M8001
  MOV D110 K4M220
  ANI M8001
  MOV D120 K4M240

;[オフライン時] 軸状態を「正常・レディ・原点」に固定
  LDP M8001                ; オフライン立上りで固定値セット
  MOVP H0033 D100          ; X軸: レディ=1, 原点=1 の模擬値
  MOVP H0033 D110          ; Y軸
  MOVP H0033 D120          ; Z軸
  MOVP K0 D101             ; X軸速度=0
  MOVP K0 D111             ; Y軸速度=0
  MOVP K0 D121             ; Z軸速度=0

( 470)
  ; 通信異常監視（オフライン時は異常検出しない）
  SM400
  ANI M8001
  MOV U0\G3104 K4M320
  ANI M8001
  MOV U2\G3104 K4M340

;【03-01】現在位置・速度データ処理
( 500)
  SM400
  ANI M8001                ; オフライン時はスキップ（位置データは目標値で模擬）
  MOV D106 D161
  ANI M8001
  MOV D107 D160
  ANI M8001
  DFLT D160 D204
  ANI M8001
  E/ D204 E10 D1000
  ANI M8001
  E- D1000 D5024 D317

( 510)
