  INT D319 D3059           ; 昇降現在位置
  INT D321 D3060           ; フォーク現在位置
  INT D323 D3061           ; 走行現在速度
  INT D325 D3062           ; 昇降現在速度
  INT D327 D3063           ; フォーク現在速度

; --- 3340 ---
