;******************************************************************************
; スタッカークレーン制御プログラム - M8001 オフライン/実装モード切り替え機能付き
; ベース: REFACT2/StackerCrane_Refactored_Q_GXW.asc
;
; 【M8001 モード説明】
;   M8001 = OFF: 実装モード（実機センサ・軸制御ユニット・地上盤通信を使用）
;   M8001 = ON : オフラインモード（全入力をバイパス、軸レディ/原点を強制ON）
;
; 【オフライン時の主な動作】
;   - 非常停止・安全センサ: 正常固定
;   - 軸制御ユニット(U0)データ受信: スキップ→状態ワードを「正常」固定値代入
;   - 地上盤通信(U2)データ受信: スキップ→主要フラグを正常固定
;   - 位置到達フラグ(M416/M437/M458): 即時SET（シーケンス即時進行）
;   - 自動運転開始条件: 全条件バイパス
;******************************************************************************

;==============================================================================
; プログラム構成
;==============================================================================
; BLOCK_00: 初期化・システム監視
; BLOCK_01: 安全機能管理
; BLOCK_02: 入力処理
; BLOCK_03: 軸制御共通処理
; BLOCK_04: X軸(走行)制御
; BLOCK_05: Y軸(昇降)制御
; BLOCK_06: Z軸(フォーク)制御
; BLOCK_07: 自動運転制御
; BLOCK_08: 手動・点検運転制御
; BLOCK_09: 通信処理
; BLOCK_10: 出力処理
; BLOCK_11: HMI・表示処理
;==============================================================================


;******************************************************************************
; 【オフラインモード初期化処理】 - M8001 ON立上り時
;******************************************************************************

;[オフライン初期化] M8001 ON立上りパルス処理
  LDP M8001	;SM8001_オフラインモード立上りパルス
  RST M1	;システム動作許可をいったんリセット
  MOVP K0 D301	;アラームコードクリア
  MOVP K0 K4M800	;全アラーム記録クリア(M800-M831)
  SET M40	;非常停止正常 強制SET
  SET M600	;非常停止1正常 強制SET
  SET M601	;非常停止2正常 強制SET
  SET M95	;フォーク中位 強制SET
  SET M96	;フォーク原位置 強制SET
  SET M200	;X軸運転レディ 強制SET
  SET M205	;X軸装置原点 強制SET
  SET M220	;Y軸運転レディ 強制SET
  SET M225	;Y軸装置原点 強制SET
  SET M240	;Z軸運転レディ 強制SET
  SET M245	;Z軸装置原点 強制SET
  SET M629	;走行ドライブ電源 強制SET
  SET M630	;昇降ドライブ電源 強制SET
  SET M631	;フォークドライブ電源 強制SET
  SET M652	;走行INV MC ON 強制SET
  SET M653	;昇降INV MC ON 強制SET
  SET M654	;伸縮INV MC ON 強制SET

;[オフライン初期化] M8001 OFF立下りパルス処理（実装モード復帰）
  LDF M8001	;SM8001_オフラインモード立下りパルス
  MOVP K0 D301	;アラームコードクリア
  MOVP K0 K4M800	;全アラーム記録クリア
  RST M40	;非常停止正常クリア（実機センサで再判定させる）


;******************************************************************************
; BLOCK_00: 初期化・システム監視
;******************************************************************************

;【00-00】システム起動時初期化
( 0)
  SM400                    ; 常時ON
  K300 T0                  ; 電源ON後遅延タイマー(3秒)
  
( 1)
  T0                       ; 起動遅延完了後
  M8001                    ; オフラインモード時は即時完了でもOK
  SET M0                   ; システム初期化完了フラグ

;【00-01】システム状態管理
( 5)
  M0                       ; システム初期化完了
  M8001                    ; オフラインモード: 非常停止正常バイパス
  M40                      ; 非常停止正常
  ORB
  M8001                    ; オフラインモード: 異常なしバイパス
  M45                      ; 異常なし(反転)
  ORB
  SET M1                   ; システム動作許可

( 10)
  M0                       ; システム初期化完了
  M8001                    ; オフライン時は解除しない
  ANI M8001
  M40                      ; 非常停止正常(反転)
  ORB
  ANI M8001
  RST M1                   ; システム動作許可解除

( 15)
  M0
  M8001
  ANI M8001
  M45                      ; 異常発生
  ORB
  ANI M8001
  RST M1                   ; システム動作許可解除


;******************************************************************************
; BLOCK_01: 安全機能管理
;******************************************************************************

;【01-00】非常停止監視
( 20)
  M8001                    ; オフラインモード: 非常停止1正常固定
  OR X40                   ; 非常停止PB1
  SET M600                 ; 非常停止1正常
  
( 22)
  X40                      ; 非常停止PB1(反転)
  ANI M8001                ; オフライン時はRSTしない
  RST M600

( 24)
  M8001                    ; オフラインモード: 非常停止2正常固定
  OR X41                   ; 非常停止PB2
  SET M601                 ; 非常停止2正常
  
( 26)
  X41                      ; 非常停止PB2(反転)
  ANI M8001                ; オフライン時はRSTしない
  RST M601

( 28)
  M600                     ; 非常停止1正常
  M601                     ; 非常停止2正常
  SET M40                  ; 非常停止正常まとめ

( 32)
  M600                     ; 非常停止1異常
  ANI M8001                ; オフライン時はRSTしない
  RST M40

( 34)
  M601                     ; 非常停止2異常
  ANI M8001
  RST M40

;【01-01】アラーム検出・記録 - 統合版
( 40)
  M40                      ; 非常停止異常
  ANI M8001                ; オフライン時はアラーム抑制
  SET M800                 ; アラーム記録1
  MOVP K1 D301             ; アラームコード1

( 45)
  M340                     ; 地上盤通信異常
  ANI M8001                ; オフライン時はアラーム抑制
  SET M804                 ; アラーム記録5
  MOVP K5 D301

( 50)
  M320                     ; X軸通信異常
  ANI M8001                ; オフライン時はアラーム抑制
  SET M805
  MOVP K6 D301

( 55)
  M322                     ; Y軸通信異常
  ANI M8001
  SET M806
  MOVP K7 D301

( 60)
  M324                     ; Z軸通信異常
  ANI M8001
  SET M807
  MOVP K8 D301

;【01-02】走行系安全装置監視 - オフライン時抑制
( 70)
  SM400
  M606                     ; 前方障害物減速
  M910                     ; 障害物センサ無効PB(反転)
  M11                      ; 点検モード(反転)
  ANI M8001                ; オフライン時はアラーム抑制
  SET M3179                ; 障害物回避アラーム

( 75)
  M608                     ; 後方障害物減速
  M910
  M11
  ANI M8001
  SET M3179

( 80)
  M607                     ; 前方障害物停止
  M910
  M11
  ANI M8001
  SET M829
  MOVP K30 D301

( 85)
  M609                     ; 後方障害物停止
  M910
  M11
  ANI M8001
  SET M830
  MOVP K31 D301

;【01-03】昇降系安全装置監視 - オフライン時抑制
( 100)
  M619                     ; 昇降失速
  M11                      ; 点検モード(反転)
  M915                     ; 失速LS無効PB(反転)
  ANI M8001                ; オフライン時はアラーム抑制
  SET M811
  MOVP K12 D301

( 105)
  M620                     ; 昇降ロープ緩み1
  M621                     ; または緩み2
  M11
  M914
  ANI M8001
  SET M812
  MOVP K13 D301

( 112)
  M622                     ; 昇降過負荷1
  M623                     ; または過負荷2
  M11
  M914
  ANI M8001
  SET M814
  MOVP K15 D301

;【01-04】フォーク系安全監視 - オフライン時抑制
( 130)
  M632                     ; 左側崩壊1
  M633
  M12
  M95
  M307
  ANI M8001                ; オフライン時はアラーム抑制
  SET M3205

( 140)
  M640                     ; 右側崩壊1
  M641
  M12
  M95
  M307
  ANI M8001
  SET M3200

( 150)
  M634
  M635
  M12
  M95
  M307
  ANI M8001
  SET M3203

( 160)
  M642
  M643
  M12
  M95
  M307
  ANI M8001
  SET M3198

;【01-05】アラームリセット処理
( 180)
  X43                      ; 異常リセットKSW
  M3217                    ; 地上盤リセット
  D301 <> K0
  SET M9                   ; アラームリセット中フラグ

( 185)
  M9
  MOVP K0 K4M800
  MOVP K0 D301
  RST M3179
  RST M3205
  RST M3204
  RST M3200
  RST M3199

( 195)
