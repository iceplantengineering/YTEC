  AND M503
  AND M531
  ; 庫位列 → 座標変換
  D3259 - K1 D390          ; 列インデックス = 列 - 1

; --- 2970 ---
  LD M531                     ; 原点位置決め時
  AND M523
  AND M531
  K7 - K1 D390             ; 原点列インデックス = 7 - 1

; --- 2980 ---
