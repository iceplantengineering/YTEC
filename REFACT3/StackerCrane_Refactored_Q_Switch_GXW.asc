;******************************************************************************
; スタッカークレーン制御プログラム - M8001切り替え対応版
; ベース: REFACT2/StackerCrane_Refactored_Q_GXW.asc
; M8001=OFF: 実装モード / M8001=ON: オフラインモード
; 
; 【主な改修内容】
; 1. 冗長なコードの統合と削除
; 2. 命名規則の統一とコメントの充実
; 3. 安全機能の集約化
; 4. タスク処理フローの明確化
; 5. 通信処理の効率化
; 6. M8001によるオフライン/実装モード切り替え機能追加
;******************************************************************************

;==============================================================================
; プログラム構成
;==============================================================================
; BLOCK_00: 初期化・システム監視
; BLOCK_01: 安全機能管理
; BLOCK_02: 入力処理
; BLOCK_03: 軸制御共通処理
; BLOCK_04: X軸(走行)制御
; BLOCK_05: Y軸(昇降)制御
; BLOCK_06: Z軸(フォーク)制御
; BLOCK_07: 自動運転制御
; BLOCK_08: 手動・点検運転制御
; BLOCK_09: 通信処理
; BLOCK_10: 出力処理
; BLOCK_11: HMI・表示処理
;==============================================================================


;******************************************************************************
; BLOCK_00: 初期化・システム監視
;******************************************************************************

;------------------------------------------------------------------------------
; 【00-XX】M8001 オフラインモード初期化
;------------------------------------------------------------------------------
; --- -1 ---
  LDP M8001                 ; オフラインモード立上りパルス
  MOVP K0 D301              ; アラームコードクリア
  MOVP K0 K4M800            ; 全アラーム記録クリア
  RST M3179                 ; 障害物アラームクリア
  RST M3205
  RST M3200
  SET M200                  ; X軸運転レディ強制SET
  SET M220                  ; Y軸運転レディ強制SET
  SET M240                  ; Z軸運転レディ強制SET
  SET M205                  ; X軸装置原点強制SET
  SET M225                  ; Y軸装置原点強制SET
  SET M245                  ; Z軸装置原点強制SET

; --- -2 ---
  LDF M8001                 ; 実装モード復帰パルス
  MOVP K0 D301              ; アラームコードクリア

;------------------------------------------------------------------------------
; 【00-00】システム起動時初期化
;------------------------------------------------------------------------------
; --- 0 ---
  LD SM400                    ; 常時ON
  OUT T0 K300	; 電源ON後遅延タイマー(3秒)
  
; --- 1 ---
  LD T0                       ; 起動遅延完了後
  SET M0                   ; システム初期化完了フラグ

;------------------------------------------------------------------------------
; 【00-01】システム状態管理
;------------------------------------------------------------------------------
; --- 5 ---
  LD M0                       ; システム初期化完了
  AND M40                      ; 非常停止正常
  AND M45                      ; 異常なし(反転)
  SET M1                   ; システム動作許可

; --- 10 ---
  LD M0                       ; システム初期化完了
  AND M40                      ; 非常停止正常(反転)
  RST M1                   ; システム動作許可解除

; --- 15 ---
  LD M0
  AND M45                      ; 異常発生
  RST M1                   ; システム動作許可解除


;******************************************************************************
; BLOCK_01: 安全機能管理
;******************************************************************************

;------------------------------------------------------------------------------
; 【01-00】非常停止監視
;------------------------------------------------------------------------------
; --- 20 ---
  LD M8001                    ; オフラインバイパス
  AND X40                      ; 非常停止PB1
  SET M600                 ; 非常停止1正常
  
; --- 22 ---
  LD X40                      ; 非常停止PB1(反転)
  ANI M8001                ; オフライン時はRSTしない
  RST M600

; --- 24 ---
  LD M8001                    ; オフラインバイパス
  AND X41                      ; 非常停止PB2
  SET M601                 ; 非常停止2正常
  
; --- 26 ---
  LD X41                      ; 非常停止PB2(反転)
  ANI M8001                ; オフライン時はRSTしない
  RST M601

; --- 28 ---
  LD M600                     ; 非常停止1正常
  AND M601                     ; 非常停止2正常
  SET M40                  ; 非常停止正常まとめ

; --- 32 ---
  LD M600                     ; 非常停止1異常
  RST M40

; --- 34 ---
  LD M601                     ; 非常停止2異常
  RST M40

;------------------------------------------------------------------------------
; 【01-01】アラーム検出・記録 - 統合版
;------------------------------------------------------------------------------
; --- 40 ---
  LD M40                      ; 非常停止異常
  SET M800                 ; アラーム記録1
  MOVP K1 D301             ; アラームコード1

; --- 45 ---
  LD M340                     ; 地上盤通信異常
  SET M804                 ; アラーム記録5
  MOVP K5 D301

; --- 50 ---
  LD M320                     ; X軸通信異常
  SET M805
  MOVP K6 D301

; --- 55 ---
  LD M322                     ; Y軸通信異常
  SET M806
  MOVP K7 D301

; --- 60 ---
  LD M324                     ; Z軸通信異常
  SET M807
  MOVP K8 D301

;------------------------------------------------------------------------------
; 【01-02】走行系安全装置監視 - 最適化版
;------------------------------------------------------------------------------
; --- 70 ---
  LD SM400
  AND M606                     ; 前方障害物減速
  AND M910                     ; 障害物センサ無効PB(反転)
  AND M11                      ; 点検モード(反転)
  SET M3179                ; 障害物回避アラーム

; --- 75 ---
  LD M608                     ; 後方障害物減速
  AND M910
  AND M11
  SET M3179

; --- 80 ---
  LD M607                     ; 前方障害物停止
  AND M910
  AND M11
  SET M829                 ; アラーム記録30
  MOVP K30 D301

; --- 85 ---
  LD M609                     ; 後方障害物停止
  AND M910
  AND M11
  SET M830
  MOVP K31 D301

;------------------------------------------------------------------------------
; 【01-03】昇降系安全装置監視 - 統合版
;------------------------------------------------------------------------------
; --- 100 ---
  LD M619                     ; 昇降失速
  AND M11                      ; 点検モード(反転)
  AND M915                     ; 失速LS無効PB(反転)
  SET M811
  MOVP K12 D301

; --- 105 ---
  LD M620                     ; 昇降ロープ緩み1
  AND M621                     ; または緩み2
  AND M11
  AND M914                     ; ワイヤー緩みLS無効PB(反転)
  SET M812                 ; アラーム記録13
  MOVP K13 D301

; --- 112 ---
  LD M622                     ; 昇降過負荷1
  AND M623                     ; または過負荷2
  AND M11
  AND M914
  SET M814
  MOVP K15 D301

;------------------------------------------------------------------------------
; 【01-04】フォーク系安全監視 - 統合・簡素化版
;------------------------------------------------------------------------------
; 左側崩壊検出
; --- 130 ---
  LD M632                     ; 左側崩壊1
  AND M633                     ; または崩壊2
  AND M12                      ; 運転モード時のみ
  AND M95                      ; フォーク中位
  AND M307                     ; Z軸動作中
  SET M3205                ; 左側崩壊アラーム

; 右側崩壊検出
; --- 140 ---
  LD M640                     ; 右側崩壊1
  AND M641                     ; または崩壊2
  AND M12
  AND M95
  AND M307
  SET M3200                ; 右側崩壊アラーム

; はみだし検出(左右統合)
; --- 150 ---
  LD M634                     ; 左側はみだし1
  AND M635                     ; 左側はみだし2
  AND M12
  AND M95
  AND M307
  SET M3203                ; 左超ワイドアラーム

; --- 160 ---
  LD M642                     ; 右側はみだし1
  AND M643                     ; 右側はみだし2
  AND M12
  AND M95
  AND M307
  SET M3198                ; 右超ワイドアラーム

;------------------------------------------------------------------------------
; 【01-05】アラームリセット処理 - 統合版
;------------------------------------------------------------------------------
; --- 180 ---
  LD X43                      ; 異常リセットKSW
  AND M3217                    ; 地上盤リセット
  LD<> D301 K0               ; アラームコード有効時
  SET M9                   ; アラームリセット中フラグ

; --- 185 ---
  LD M9                       ; アラームリセット実行
  MOVP K0 K4M800           ; 全アラーム記録クリア(M800-M835)
  MOVP K0 D301             ; アラームコードクリア
  RST M3179                ; 障害物回避アラームクリア
  RST M3205                ; 左側崩壊アラームクリア
  RST M3204
  RST M3200                ; 右側崩壊アラームクリア
  RST M3199

; --- 195 ---
  LD M9
  MOVP K0 D330             ; タスクタイプクリア
  MOVP K0 D333             ; 起点データクリア
  MOVP K0 D334
  MOVP K0 D335
  MOVP K0 D336             ; 終点データクリア
  MOVP K0 D337
  MOVP K0 D338
  MOVP K0 D339             ; 搬入台番号クリア
  MOVP K0 D340             ; 搬出台番号クリア

; --- 200 ---
  LD M9
  SET M268                 ; X軸異常リセット
  SET M288                 ; Y軸異常リセット
  SET M308                 ; Z軸異常リセット

; --- 205 ---
  LD M9                       ; リセット完了後
  OUT T50 K2	; 0.2秒後
  AND T50
  RST M9                   ; リセット中フラグOFF


;******************************************************************************
; BLOCK_02: 入力処理
;******************************************************************************

;------------------------------------------------------------------------------
; 【02-00】デジタル入力マッピング - 統合版
;------------------------------------------------------------------------------
; --- 250 ---
  LD SM400
  LD X42
  OUT M602	; 点検/運転SSW
  LD X43
  OUT M603	; 異常リセットKSW
  LD X44
  OUT M604	; 管理者モードKSW

; --- 255 ---
  ; 走行系センサ
  LD X46
  OUT M606	; 走行前方障害物減速
  LD X47
  OUT M607	; 走行前方障害物停止
  LD X48
  OUT M608	; 走行後方障害物減速
  LD X49
  OUT M609	; 走行後方障害物停止
  LD X4C
  OUT M612	; 走行前方オーバーRUN
  LD X4D
  OUT M613	; 走行後方オーバーRUN
  LD X4E
  OUT M614	; 走行減速

; --- 265 ---
  ; 昇降系センサ
  LD X50
  OUT M616	; 昇降上オーバーRUN
  LD X51
  OUT M617	; 昇降下オーバーRUN
  LD X52
  OUT M618	; 昇降減速
  LD X53
  OUT M619	; 昇降失速
  LD X54
  OUT M620	; 昇降ロープ緩み1
  LD X55
  OUT M621	; 昇降ロープ緩み2
  LD X56
  OUT M622	; 昇降過負荷1
  LD X57
  OUT M623	; 昇降過負荷2

; --- 275 ---
  ; フォーク系センサ
  LD X58
  OUT M624	; フォーク左側出限
  LD X59
  OUT M625	; フォーク右側出限
  LD X5A
  OUT M626	; フォーク中位1
  LD X5B
  OUT M627	; フォーク中位2
  LD X5C
  OUT M628	; パレット在席

; --- 285 ---
  ; フォーク異常検出
  LD X60
  OUT M632	; 左側崩壊1
  LD X61
  OUT M633	; 左側崩壊2
  LD X62
  OUT M634	; 左側はみだし1
  LD X63
  OUT M635	; 左側はみだし2
  LD X64
  OUT M636	; 左側超高
  LD X65
  OUT M637	; 左側パレット検出

; --- 295 ---
  LD X68
  OUT M640	; 右側崩壊1
  LD X69
  OUT M641	; 右側崩壊2
  LD X6A
  OUT M642	; 右側超はみだし1
  LD X6B
  OUT M643	; 右側超はみだし2
  LD X6C
  OUT M644	; 右側超高
  LD X6D
  OUT M645	; 右側パレット検出

; --- 305 ---
  ; その他
  LD X70
  OUT M648	; 盤クーラ異常
  LD X71
  OUT M649	; 光通信センサ異常
  LD X7A
  OUT M658	; メンテピン格納1
  LD X7B
  OUT M659	; メンテピン格納2

; --- 310 ---
  ; INV電源確認
  LD X5D
  OUT M629	; 走行ドライブ電源
  LD X5E
  OUT M630	; 昇降ドライブ電源
  LD X5F
  OUT M631	; フォーク(伸縮)ドライブ電源
  LD X74
  OUT M652	; 走行INV MC ON
  LD X75
  OUT M653	; 昇降INV MC ON
  LD X76
  OUT M654	; 伸縮INV MC ON

;------------------------------------------------------------------------------
; 【02-01】フォーク中位検出 - 簡素化
;------------------------------------------------------------------------------
; --- 330 ---
  LD M626                     ; フォーク中位1
  AND M627                     ; フォーク中位2
  SET M95                  ; フォーク伸縮中位検出

; --- 335 ---
  LD M626                     ; どちらかOFFで
  RST M95

; --- 337 ---
  LD M627
  RST M95

;------------------------------------------------------------------------------
; 【02-02】フォーク原点検出 - 最適化
;------------------------------------------------------------------------------
; --- 340 ---
  LD M95                      ; フォーク中位
  ED> D321 E-2              ; Z軸現在位置 > -2
  ED< D321 E2               ; かつ < 2
  SET M96                  ; フォーク原位置

; --- 345 ---
  LD M95                      ; 条件外
  RST M96

;------------------------------------------------------------------------------
; 【02-03】地上盤通信データ受信 - 統合版
;------------------------------------------------------------------------------
; --- 360 ---
  LD SM400
  ANI M8001                ; オフライン時は地上盤受信スキップ
  BMOV U2\G4096 D3000 K30  ; 地上盤データ一括受信

; --- 365 ---
  ; タスク情報
  MOV D3000 D330           ; タスクタイプ
  DMOV D3001 D331          ; タスクID
  MOV D3003 D333           ; 起点棚
  MOV D3004 D334           ; 起点列
  MOV D3005 D335           ; 起点層
  MOV D3006 D336           ; 終点棚
  MOV D3007 D337           ; 終点列
  MOV D3008 D338           ; 終点層
  MOV D3009 D339           ; 搬入台番号
  MOV D3010 D340           ; 搬出台番号

; --- 380 ---
  ; 制御ビット情報
  MOV D3024 K4M2500        ; 制御ビット → M2500~
  LD M2500
  OUT M535	; 手動操作要求
  LD M2501
  OUT M523	; 庫位切替
  LD M2502
  OUT M530	; Y軸強制動作
  LD M2503
  OUT M520	; X軸位置決め
  LD M2504
  OUT M521	; Y軸位置決め
  LD M2505
  OUT M522	; Z軸位置決め
  LD M2506
  OUT M524	; X軸前進
  LD M2507
  OUT M525	; X軸後退
  LD M2508
  OUT M526	; Y軸上昇
  LD M2509
  OUT M527	; Y軸下降
  LD M2510
  OUT M528	; Z軸左伸
  LD M2511
  OUT M529	; Z軸右伸
  LD M2512
  OUT M531	; 原点位置決め
  LD M2513
  OUT M539	; 自動運転中

; --- 400 ---
  ; モード・状態情報
  LD= D3016 K0 M3220         ; 自動運転モード
  LD= D3016 K2 M3221         ; 手動運転モード
  LD= D3017 K1 M3217         ; リセット
  LD= D3018 K1 M3218         ; 一時停止
  LD= D3025 K1 M3219         ; 非常停止

; --- 410 ---
  ; 搬入搬出可能フラグ
  LD= D3012 K1 M3208         ; B01搬入可
  LD= D3013 K1 M3210         ; B02搬入可
  LD= D3014 K1 M3213         ; B01搬出可
  LD= D3015 K1 M3215         ; B02搬出可


;******************************************************************************
; BLOCK_03: 軸制御共通処理
;******************************************************************************

;------------------------------------------------------------------------------
; 【03-00】U0(軸制御ユニット)データ受信
;------------------------------------------------------------------------------
; --- 450 ---
  LD SM400
  ANI M8001                ; オフライン時はU0受信スキップ
  BMOV U0\G4096 D100 K8    ; X軸データ受信
  BMOV U0\G4112 D110 K8    ; Y軸データ受信
  BMOV U0\G4128 D120 K8    ; Z軸データ受信

; --- 460 ---
  ; 状態ワード展開
  MOV D100 K4M200          ; X軸状態 → M200~
  MOV D110 K4M220          ; Y軸状態 → M220~
  MOV D120 K4M240          ; Z軸状態 → M240~

; --- 470 ---
  ; 通信異常監視
  MOV U0\G3104 K4M320      ; X軸通信異常
  MOV U2\G3104 K4M340      ; 地上盤通信異常

;------------------------------------------------------------------------------
; 【03-01】現在位置・速度データ処理 - 統合版
;------------------------------------------------------------------------------
; --- 500 ---
  LD SM400
  ; X軸(走行)
  MOV D106 D161            ; X軸現在位置(High)
  MOV D107 D160            ; X軸現在位置(Low)
  DFLT D160 D204           ; 実数変換
  EDIV D204 E10 D1000        ; モータ位置 = 現在位置/10
  ESUB D1000 D5024 D317      ; 実位置 = モータ位置 - オフセット

; --- 510 ---
  ; Y軸(昇降)
  MOV D116 D163
  MOV D117 D162
  DFLT D162 D216
  EDIV D216 E10 D1004
  ESUB D1004 D5026 D319

; --- 520 ---
  ; Z軸(フォーク)
  MOV D126 D165
  MOV D127 D164
  DFLT D164 D228
  EDIV D228 E10 D1008
  ESUB D1008 D5028 D321

; --- 530 ---
  ; 速度データ
  FLT D101 D206            ; X軸速度
  EDIV D206 E1 D323
  FLT D111 D218            ; Y軸速度
  EDIV D218 E1 D325
  FLT D121 D230            ; Z軸速度
  EDIV D230 E1 D327

;------------------------------------------------------------------------------
; 【03-02】目標位置計算 - 統合・最適化版
;------------------------------------------------------------------------------
; --- 560 ---
  LD SM400
  ; X軸目標位置計算
  EADD D200 D5024 D208       ; 列目標位置 + オフセット
  EMUL D208 E10 D208         ; ×10(モータ単位)
  DINT D208 D170           ; 整数変換
  MOV D171 D136            ; 目標位置High
  MOV D170 D137            ; 目標位置Low

; --- 570 ---
  ; Y軸目標位置計算
  EADD D212 D5026 D220
  EMUL D220 E10 D220
  DINT D220 D172
  MOV D173 D146
  MOV D172 D147

; --- 580 ---
  ; Z軸目標位置計算
  EADD D224 D5028 D232
  EMUL D232 E10 D232
  DINT D232 D174
  MOV D175 D156
  MOV D174 D157

;------------------------------------------------------------------------------
; 【03-03】位置到達判定 - 統合版
;------------------------------------------------------------------------------
; --- 600 ---
  LD SM400
  ; X軸位置到達判定
  AND M8001                    ; オフライン時は即時到達
  ED>= D317 D200            ; 現在位置 >= 目標位置
  ESUB D317 D200 D1002       ; 位置差計算
  ED< D1002 E5              ; 位置差 < 5mm
  AND M207                     ; 情報有効化済み
  AND M401                     ; X軸位置決め中(自動)
  SET M416                 ; X軸位置到達

; --- 610 ---
  ; 同様にY軸
  AND M8001                    ; オフライン時は即時到達
  ED>= D319 D212
  ESUB D319 D212 D1006
  ED< D1006 E2              ; ±2mm
  AND M227
  AND M422
  SET M437                 ; Y軸位置到達

; --- 620 ---
  ; 同様にZ軸
  AND M8001                    ; オフライン時は即時到達
  ED>= D321 D224
  ESUB D321 D224 D1010
  ED< D1010 E2
  AND M247
  AND M443
  SET M458                 ; Z軸位置到達

; --- 630 ---
  ; 逆方向からの到達判定も同様に処理(省略)

;------------------------------------------------------------------------------
; 【03-04】軸動作許可条件 - 統合・簡素化版
;------------------------------------------------------------------------------
; --- 680 ---
  ; X軸(走行)動作許可
  AND T0                       ; 起動遅延完了
  AND M652                     ; 走行INV電源ON
  AND M95                      ; フォーク中位
  ED> D5012 D317            ; 前方リミット内
  AND M606                     ; 前方障害物なし(反転)
  AND M612                     ; 前方オーバーRUNなし(反転)
  AND M910                     ; 障害物センサ無効時は許可
  SET M417                 ; X軸正回転可

; --- 690 ---
  LD T0
  AND M652
  AND M95
  ED< D5014 D317            ; 後方リミット内
  AND M608                     ; 後方障害物なし
  AND M613                     ; 後方オーバーRUNなし
  AND M910
  SET M418                 ; X軸逆回転可

; --- 700 ---
  ; Y軸(昇降)動作許可
  AND T0
  AND M653                     ; 昇降INV電源ON
  AND M95
  ED> D5016 D319            ; 上限リミット内
  AND M616                     ; 上オーバーRUNなし
  AND M30                      ; 点検モード時は許可
  AND M510                     ; Y軸強制可時は許可
  SET M438                 ; Y軸正回転可

; --- 710 ---
  LD T0
  AND M653
  AND M95
  ED< D5018 D319            ; 下限リミット内
  AND M617                     ; 下オーバーRUNなし
  AND M30
  AND M530                     ; 地上盤Y軸強制可
  SET M439                 ; Y軸逆回転可

; --- 720 ---
  ; Z軸(フォーク)動作許可
  AND T0
  AND M654                     ; フォークINV電源ON
  ED> D5020 D321            ; 左限リミット内
  AND M624                     ; 左出限なし
  SET M459                 ; Z軸正回転可

; --- 730 ---
  LD T0
  AND M654
  ED< D5022 D321            ; 右限リミット内
  AND M625                     ; 右出限なし
  SET M460                 ; Z軸逆回転可

;------------------------------------------------------------------------------
; 【03-05】速度設定 - 統合版
;------------------------------------------------------------------------------
; --- 760 ---
  ; X軸速度設定
  AND M267                     ; X軸動作中
  AND M614                     ; 走行減速(反転)
  AND M11                      ; 点検モード
  MOV D5003 D131           ; 手動速度設定

; --- 765 ---
  LD M267
  AND M614
  AND M12                      ; 運転モード
  MOV D5000 D131           ; 自動速度設定

; --- 770 ---
  LD M267
  AND M614                     ; 減速センサON時
  MOVP K500 D131           ; 減速速度(500mm/s)

; --- 780 ---
  ; Y軸速度設定
  AND M287                     ; Y軸動作中
  AND M618                     ; 昇降減速(反転)
  AND M11
  MOV D5004 D141           ; 手動速度設定

; --- 785 ---
  LD M287
  AND M618
  AND M12
  MOV D5001 D141           ; 自動速度設定

; --- 790 ---
  LD M287
  AND M618                     ; 減速センサON時
  MOVP K300 D141           ; 減速速度(300mm/s)

; --- 795 ---
  ; 受取・受渡時の低速設定
  AND M56                      ; 受取フォーク持上げ中
  AND M61                      ; 受渡フォーク下降中
  MOVP D5070 D141          ; 取投物料速度(50mm/s)

; --- 800 ---
  ; Z軸速度設定(点検/運転で切替)
  AND M307                     ; Z軸動作中
  AND M11
  MOV D5005 D151           ; 手動速度設定

; --- 805 ---
  LD M307
  AND M12
  MOV D5002 D151           ; 自動速度設定

;------------------------------------------------------------------------------
; 【03-06】加減速設定 - 統合版
;------------------------------------------------------------------------------
; --- 820 ---
  LD M267                     ; X軸動作中
  MOV D5006 D132           ; X軸加速度
  MOV D5007 D133           ; X軸減速度

; --- 825 ---
  LD M287                     ; Y軸動作中
  MOV D5008 D142
  MOV D5009 D143

; --- 830 ---
  LD M307                     ; Z軸動作中
  MOV D5010 D152
  MOV D5011 D153

;------------------------------------------------------------------------------
; 【03-07】制御ワード送信 - 統合版
;------------------------------------------------------------------------------
; --- 850 ---
  LD SM400
  ; X軸制御ワード
  MOV K4M260 D130          ; Enable非常停止 → 制御ワード
  ANI M8001                ; オフライン時はU0送信スキップ
  BMOV D130 U0\G12288 K8   ; 送信

; --- 855 ---
  ; Y軸制御ワード
  MOV K4M280 D140
  ANI M8001                ; オフライン時はU0送信スキップ
  BMOV D140 U0\G12304 K8

; --- 860 ---
  ; Z軸制御ワード
  MOV K4M300 D150
  ANI M8001                ; オフライン時はU0送信スキップ
  BMOV D150 U0\G12320 K8


;******************************************************************************
; BLOCK_04: X軸(走行)制御
;******************************************************************************

;------------------------------------------------------------------------------
; 【04-00】X軸位置決め - 統合版
;------------------------------------------------------------------------------
; --- 900 ---
  ; 自動運転時の位置決め
  AND M102                     ; X軸ON 位置決め補助1
  AND M103                     ; 補助2
  AND M104                     ; 補助3
  AND M105                     ; 補助4
  AND M106                     ; 補助5
  AND M107                     ; 補助6
  AND M108                     ; 補助7
  AND M109                     ; 補助8
  AND M110                     ; 補助9
  SET M401                 ; X軸位置決め自動運転

; --- 910 ---
  LD M401                     ; 自動位置決め中
  AND M3144                    ; X軸位置決め可能
  AND M416                     ; 位置到達(反転)
  SET M267                 ; X軸バス同期スロープ起動

; --- 915 ---
  LD M267                     ; 動作中
  AND M416                     ; 位置到達
  RST M267                 ; 停止

; --- 920 ---
  ; 点検/手動時の位置決め
  AND M402                     ; X軸ON 位置決め点検/手動
  AND M3144
  AND M416
  SET M267

; --- 925 ---
  LD M402
  AND M3144
  AND M416
  MOVP K400 D135           ; 設定応用モード

; --- 930 ---
  LD M267
  AND M100                     ; Enable応用停止補助1
  RST M267

;------------------------------------------------------------------------------
; 【04-01】X軸ジョグ運転 - 統合版
;------------------------------------------------------------------------------
; --- 950 ---
  ; 正転ジョグ
  AND M30                      ; 点検モード
  AND M504                     ; HMI X軸ジョグ正転PB
  AND M417                     ; X軸正回転可
  SET M264                 ; X軸正回転ジョグ

; --- 955 ---
  LD M35                      ; 手動モード
  AND M524                     ; 地上盤ジョグ正転
  AND M417
  SET M264

; --- 960 ---
  ; 逆転ジョグ
  AND M30
  AND M505                     ; HMI X軸ジョグ逆転PB
  AND M418                     ; X軸逆回転可
  SET M265                 ; X軸逆回転ジョグ

; --- 965 ---
  LD M35
  AND M525                     ; 地上盤ジョグ逆転
  AND M418
  SET M265

; --- 970 ---
  ; ジョグ時の設定
  AND M264                     ; 正転ジョグ中
  AND M265                     ; 逆転ジョグ中
  MOVP K100 D135           ; 設定応用モード100
  MOVP D5003 D131          ; 手動速度
  MOVP K50 D132            ; 加速度50
  MOVP K50 D133            ; 減速度50

; --- 980 ---
  LD M264
  AND M265
  AND M101                     ; Enable応用停止補助2
  RST M264
  RST M265

;------------------------------------------------------------------------------
; 【04-02】X軸位置決め可否判定 - 簡素化
;------------------------------------------------------------------------------
; --- 1000 ---
  ED>= D5012 D200           ; 前方リミット <= 目標位置
  D5014 E<= D200           ; 後方リミット >= 目標位置
  LD M95                      ; フォーク中位
  SET M3144                ; X軸位置決め可

; --- 1010 ---
  ED< D5012 D200            ; リミット外
  RST M3144

; --- 1015 ---
  ED> D5014 D200
  RST M3144

; --- 1020 ---
  LD M95                      ; フォーク中位でない
  RST M3144


;******************************************************************************
; BLOCK_05: Y軸(昇降)制御
;******************************************************************************

;------------------------------------------------------------------------------
; 【05-00】Y軸位置決め - X軸と同様の構造
;------------------------------------------------------------------------------
; --- 1100 ---
  LD M122
  AND M123
  AND M124
  AND M125
  AND M126
  AND M127
  AND M128
  AND M129
  AND M130
  AND M131
  AND M132
  SET M422                 ; Y軸位置決め自動運転

; --- 1110 ---
  LD M422
  AND M3145                    ; Y軸位置決め可能
  AND M437                     ; 位置到達(反転)
  SET M287                 ; Y軸バス同期スロープ起動

; --- 1115 ---
  LD M287
  AND M437
  RST M287

; --- 1120 ---
  ; 特殊条件: 自動運転時Y軸動作許可
  AND M129                     ; 補助8
  AND M131                     ; 補助10
  SET M470                 ; 自動運転時Y軸動作許可

; --- 1130 ---
  LD M423                     ; 点検/手動位置決め
  AND M3145
  AND M437
  SET M287

; --- 1135 ---
  LD M423
  AND M3145
  AND M437
  MOVP K400 D145           ; 設定応用モード

; --- 1140 ---
  LD M287
  AND M120                     ; Enable応用停止補助1
  RST M287

;------------------------------------------------------------------------------
; 【05-01】Y軸ジョグ運転
;------------------------------------------------------------------------------
; --- 1160 ---
  LD M30
  AND M506                     ; HMI Y軸ジョグ正転PB
  AND M438                     ; Y軸正回転可
  SET M284

; --- 1165 ---
  LD M35
  AND M526
  AND M438
  SET M284

; --- 1170 ---
  LD M30
  AND M507
  AND M439
  SET M285

; --- 1175 ---
  LD M35
  AND M527
  AND M439
  SET M285

; --- 1180 ---
  LD M284
  AND M285
  MOVP K101 D145           ; 設定応用モード101
  MOVP D5004 D141
  MOVP K50 D142
  MOVP K50 D143

; --- 1190 ---
  LD M284
  AND M285
  AND M121
  RST M284
  RST M285

;------------------------------------------------------------------------------
; 【05-02】Y軸位置決め可否判定
;------------------------------------------------------------------------------
; --- 1210 ---
  ED>= D5016 D212
  D5018 E<= D212
  LD M95
  SET M3145

; --- 1215 ---
  LD M470                     ; 自動運転時Y軸動作許可
  SET M3145                ; 強制的に許可

; --- 1220 ---
  ED< D5016 D212
  RST M3145

; --- 1225 ---
  ED> D5018 D212
  RST M3145

; --- 1230 ---
  LD M95
  AND M470
  RST M3145


;******************************************************************************
; BLOCK_06: Z軸(フォーク)制御
;******************************************************************************

;------------------------------------------------------------------------------
; 【06-00】Z軸位置決め
;------------------------------------------------------------------------------
; --- 1300 ---
  LD M142
  AND M143
  AND M144
  AND M145
  AND M146
  SET M443                 ; Z軸位置決め自動運転

; --- 1310 ---
  LD M443
  AND M3146                    ; Z軸位置決め可能
  AND M458                     ; 位置到達(反転)
  SET M307                 ; Z軸バス同期スロープ起動

; --- 1315 ---
  LD M307
  AND M458
  RST M307

; --- 1320 ---
  LD M444                     ; 点検/手動位置決め
  AND M3146
  AND M458
  SET M307

; --- 1325 ---
  LD M444
  AND M3146
  AND M458
  MOVP K400 D155

; --- 1330 ---
  LD M307
  AND M140
  RST M307

;------------------------------------------------------------------------------
; 【06-01】Z軸ジョグ運転
;------------------------------------------------------------------------------
; --- 1350 ---
  LD M30
  AND M508
  AND M459
  SET M304

; --- 1355 ---
  LD M35
  AND M528
  AND M459
  SET M304

; --- 1360 ---
  LD M30
  AND M509
  AND M460
  SET M305

; --- 1365 ---
  LD M35
  AND M529
  AND M460
  SET M305

; --- 1370 ---
  LD M304
  AND M305
  MOVP K100 D155
  MOVP D5005 D151
  MOVP K50 D152
  MOVP K50 D153

; --- 1380 ---
  LD M304
  AND M305
  AND M141
  RST M304
  RST M305

;------------------------------------------------------------------------------
; 【06-02】Z軸位置決め可否判定
;------------------------------------------------------------------------------
; --- 1400 ---
  ED>= D5020 D224
  D5022 E<= D224
  SET M3146

; --- 1410 ---
  ED< D5020 D224
  RST M3146

; --- 1415 ---
  ED> D5022 D224
  RST M3146


;******************************************************************************
; BLOCK_07: 自動運転制御
;******************************************************************************

;------------------------------------------------------------------------------
; 【07-00】運転モード選択 - 統合・簡素化版
;------------------------------------------------------------------------------
; --- 1500 ---
  LD M602                     ; 運転SSW ON
  AND M11                      ; 点検モード(反転)
  SET M12                  ; 運転モード選択

; --- 1505 ---
  LD M602
  SET M11                  ; 点検操作モード選択

; --- 1510 ---
  LD M12
  AND M3221                    ; 地上盤手動運転モード
  AND M3220                    ; 地上盤自動運転モード(反転)
  AND M535                     ; 地上盤手動操作要求
  SET M15                  ; 地上盤手動操作選択

; --- 1515 ---
  LD M12
  AND M3220                    ; 地上盤自動運転モード
  AND M3221                    ; 地上盤手動運転モード(反転)
  AND M535                     ; 地上盤手動操作要求(反転)
  SET M16                  ; 地上盤自動運転選択

;------------------------------------------------------------------------------
; 【07-01】待機状態管理
;------------------------------------------------------------------------------
; --- 1530 ---
  LD M16                      ; 自動運転選択
  AND M37                      ; 運転中(反転)
  SET M50                  ; 待機状態

; --- 1535 ---
  LD M50
  MOVP K0 D316             ; スタッカー状態 = 0(待機)

;------------------------------------------------------------------------------
; 【07-02】自動運転開始条件チェック - 統合版
;------------------------------------------------------------------------------
; --- 1550 ---
  LD M8001                    ; オフラインバイパス(条件強制成立)
  AND T0                       ; 起動遅延完了
  AND M16                      ; 自動運転選択
  AND M40                      ; 非常停止正常
  AND M45                      ; 異常なし
  AND M85                      ; タスク完了補助2(反転)
  SET M20                  ; 自動運転開始条件1

; --- 1560 ---
  LD M8001                    ; オフラインバイパス(条件強制成立)
  LD= D301 K0                ; アラームコードなし
  AND M200                     ; X軸運転レディ
  AND M220                     ; Y軸運転レディ
  AND M240                     ; Z軸運転レディ
  AND M205                     ; X軸装置原点
  AND M225                     ; Y軸装置原点
  AND M245                     ; Z軸装置原点
  SET M21                  ; 自動運転開始条件2

; --- 1570 ---
  LD M96                      ; フォーク原位置
  SET M22                  ; 自動運転開始条件3

;------------------------------------------------------------------------------
; 【07-03】タスク指令受付 - 統合版
;------------------------------------------------------------------------------
; --- 1590 ---
  LD M50                      ; 待機中
  D331 D<> K0              ; タスクID有効
  SET M550                 ; タスク指令開始

; --- 1600 ---
  ; 搬入タスク判定
  AND M550
  AND M541                     ; タスクタイプ = 搬入
  D331 D<> D312            ; タスクID ≠ 現在タスクID
  LD<> D339 K0               ; 搬入台番号有効
  LD<> D336 K0               ; 終点棚有効
  LD<> D337 K0               ; 終点列有効
  LD<> D338 K0               ; 終点層有効
  AND M16
  AND M50
  AND M37                      ; 運転中(反転)
  SET M551                 ; タスク指令_搬入

; --- 1620 ---
  ; 搬出タスク判定
  AND M550
  AND M542
  D331 D<> D312
  LD<> D340 K0               ; 搬出台番号有効
  LD<> D333 K0               ; 起点棚有効
  LD<> D334 K0               ; 起点列有効
  LD<> D335 K0               ; 起点層有効
  AND M16
  AND M50
  AND M37
  SET M552                 ; タスク指令_搬出

; --- 1640 ---
  ; 移庫タスク判定
  AND M550
  AND M543
  D331 D<> D312
  LD<> D333 K0
  LD<> D334 K0
  LD<> D335 K0
  LD<> D336 K0
  LD<> D337 K0
  LD<> D338 K0
  AND M16
  AND M50
  AND M37
  SET M553                 ; タスク指令_移庫

; --- 1660 ---
  ; 原位置タスク判定
  AND M550
  AND M544
  D331 D<> D312
  LD= D333 K0                ; 起点・終点すべて0
  LD= D334 K0
  LD= D335 K0
  LD= D336 K0
  LD= D337 K0
  LD= D338 K0
  LD= D339 K0
  LD= D340 K0
  AND M16
  AND M50
  AND M37
  SET M554                 ; タスク指令_原位置

;------------------------------------------------------------------------------
; 【07-04】タスク実行状態管理 - 統合版
;------------------------------------------------------------------------------
; --- 1700 ---
  LD M12
  AND M539                     ; 地上盤自動運転中
  AND M20                      ; 自動運転開始条件1
  AND M21                      ; 自動運転開始条件2
  AND M22                      ; 自動運転開始条件3
  AND M551                     ; タスク指令_搬入
  AND M552                     ; タスク指令_搬出(反転)
  AND M553                     ; タスク指令_移庫(反転)
  AND M554                     ; タスク指令_原位置(反転)
  SET M31                  ; 搬入運転中

; --- 1710 ---
  LD M12
  AND M539
  AND M20
  AND M21
  AND M22
  AND M551
  AND M552
  AND M553
  AND M554
  SET M32                  ; 搬出運転中

; --- 1720 ---
  LD M12
  AND M539
  AND M20
  AND M21
  AND M22
  AND M551
  AND M552
  AND M553
  AND M554
  SET M33                  ; 移庫運転中

; --- 1730 ---
  LD M12
  AND M539
  AND M20
  AND M21
  AND M22
  AND M551
  AND M552
  AND M553
  AND M554
  SET M34                  ; 検修運転中

; --- 1750 ---
  ; 運転中まとめ
  AND M31
  AND M32
  AND M33
  AND M34
  SET M37                  ; 運転中まとめ

; --- 1760 ---
  ; スタッカー状態コード設定
  AND M50
  MOVP K1 D316             ; 待機中 = 1

; --- 1765 ---
  LD M31
  MOVP K2 D316             ; 搬入中 = 2

; --- 1770 ---
  LD M32
  AND M33
  AND M34
  MOVP K2 D316             ; その他運転中 = 2

; --- 1775 ---
  LD<> D301 K0               ; アラーム発生時
  MOVP K3 D316             ; 異常 = 3

;------------------------------------------------------------------------------
; 【07-05】タスク開始処理 - 統合版
;------------------------------------------------------------------------------
; --- 1800 ---
  LD M37                      ; 運転中
  AND M51                      ; 自動運転開始(反転)
  AND M55                      ; 受取フォーク伸出(反転)
  AND M60                      ; 受渡フォーク伸出(反転)
  SET M71                  ; 自動運転開始補助

; --- 1810 ---
  LD M71
  OUT T17 K20	; 自動運転開始遅延(2秒)

; --- 1815 ---
  LD M37
  AND T17
  SET M51                  ; 自動運転開始

;------------------------------------------------------------------------------
; 【07-06】座標計算 - 最適化版
;------------------------------------------------------------------------------
; --- 1850 ---
  LD M71
  ; 搬入台番号 → インデックス変換
  LD= D309 K2                ; 搬入台 B01
  MOVP K1 D398             ; インデックス = 1

; --- 1855 ---
  LD= D309 K6                ; 搬入台 B02
  MOVP K2 D398             ; インデックス = 2

; --- 1860 ---
  ; 搬出台番号 → インデックス変換
  LD= D310 K4                ; 搬出台 B01
  MOVP K3 D399             ; インデックス = 3

; --- 1865 ---
  LD= D310 K8                ; 搬出台 B02
  MOVP K4 D399             ; インデックス = 4

; --- 1880 ---
  LD M71
  ; 列・層の配列インデックス計算
  D304 - K1 D394           ; 始点列インデックス = 列 - 1
  D305 - K1 D395           ; 始点層インデックス = 層 - 1
  D307 - K1 D396           ; 終点列インデックス = 列 - 1
  D308 - K1 D397           ; 終点層インデックス = 層 - 1

;------------------------------------------------------------------------------
; 【07-07】目標位置設定 - タスク別
;------------------------------------------------------------------------------
; --- 1920 ---
  ; 搬入タスク: 終点(棚)への移動
  AND M71
  AND M541                     ; タスクタイプ_搬入
  AND M98                      ; 終点位置ON
  LD<> D309 K0               ; 搬入台番号有効
  AND M628                     ; パレット在席
  D396 * K2 Z2             ; 列インデックス×2 → Z2
  D397 * K2 Z4             ; 層インデックス×2 → Z4
  EMOV D3284Z2 D200        ; 列座標[Z2] → X軸目標位置
  EADD D3274Z4 D3268 D212    ; 層座標[Z4] + 持上高さ → Y軸目標位置
  SET M102                 ; X軸ON 位置決め補助1
  SET M122                 ; Y軸ON 位置決め補助1
  SET M165                 ; 受渡点補助1

; --- 1950 ---
  ; 搬入タスク: 受取点(搬入台)への移動
  AND M71
  AND M541
  AND M98
  LD<> D309 K0
  AND M628
  D398 * K6 Z10            ; 搬入台インデックス×6 → Z10
  EMOV D5034Z10 D200       ; DockTable列座標[Z10] → X軸目標
  ESUB D5036Z10 D3268 D212   ; DockTable層座標[Z10] - 持上高さ → Y軸目標
  SET M103                 ; X軸ON 位置決め補助2
  SET M123                 ; Y軸ON 位置決め補助2
  SET M160                 ; 受取点補助1

; --- 1980 ---
  ; 搬出タスク: 受取点(棚)からの取出
  AND M71
  AND M542                     ; タスクタイプ_搬出
  AND M97                      ; 始点位置ON
  LD<> D310 K0               ; 搬出台番号有効
  AND M628
  D399 * K6 Z12
  EMOV D5034Z12 D200
  EADD D5036Z12 D3268 D212
  SET M104                 ; X軸ON 位置決め補助3
  SET M124                 ; Y軸ON 位置決め補助3
  SET M166                 ; 受渡点補助2

; --- 2010 ---
  ; 搬出タスク: 棚からの受取
  AND M71
  AND M542
  AND M97
  LD<> D310 K0
  AND M628
  D394 * K2 Z2
  D395 * K2 Z4
  EMOV D3284Z2 D200
  ESUB D3274Z4 D3268 D212
  SET M105                 ; X軸ON 位置決め補助4
  SET M125                 ; Y軸ON 位置決め補助4
  SET M161                 ; 受取点補助2

; --- 2040 ---
  ; 移庫タスク: 終点(棚)への受渡
  AND M71
  AND M543                     ; タスクタイプ_移庫
  AND M97
  AND M98
  AND M628
