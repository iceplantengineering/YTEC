  M683 Y8D                 ; Y軸INVレディ
  M684 Y8E                 ; Z軸INVレディ

;------------------------------------------------------------------------------
; 【10-01】積層灯制御ロジック - 統合・簡素化版
;------------------------------------------------------------------------------
; --- 3600 ---
  ; 赤点灯: アラーム発生時
  LD<> D301 K0               ; アラームコード有効
  SET M670                 ; 赤点灯

; --- 3610 ---
  ; 黄点滅: 起動準備中または運転準備中
  AND M21                      ; 自動運転開始条件2
  AND M22                      ; 自動運転開始条件3(反転)
  AND M31                      ; 運転中(反転)
  SET M670                 ; 赤点灯
  SET M671                 ; 黄点灯(点滅用)

; --- 3620 ---
  LD M21
  AND M22
  AND M31
  AND SM413                    ; 2秒クロック(点滅)
  SET M671                 ; 黄点滅

; --- 3630 ---
  LD M30                      ; 点検モード
  AND SM413
  SET M671                 ; 黄点滅

; --- 3635 ---
  LD M35                      ; 手動モード
  AND M31
  AND M51                      ; 自動運転開始(反転)
  AND SM413
  SET M671

; --- 3640 ---
  ; 黄点灯: ワーニング発生時
  LD<> D406 K0               ; ワーニングコード有効
  SET M671

; --- 3650 ---
  ; 緑点灯: 自動運転中
  AND M37                      ; 運転中
  AND M51                      ; 自動運転開始(反転)
  SET M670                 ; 赤OFF
  SET M672                 ; 緑点灯

; --- 3660 ---
  LD M37
  AND M51
  AND SM413                    ; 2秒クロック
  SET M672                 ; 緑点滅


;******************************************************************************
; BLOCK_11: HMI・表示処理
;******************************************************************************

;------------------------------------------------------------------------------
; 【11-00】管理者モード制御 - 簡素化版
;------------------------------------------------------------------------------
; --- 3750 ---
  ; パスワード初期化
  AND M604                     ; 管理者モード入(反転)
  MOVP K0 D5032            ; パスコード権限クリア

; --- 3760 ---
  ; 管理者画面切替条件
  AND M11                      ; 点検モード
  AND M604                     ; 管理者モード入
  SET M920                 ; 管理者画面切替有効条件

; --- 3770 ---
  ; パスワード設定値
  MOVP K55 D5120           ; パスワード = 55

; --- 3780 ---
  ; パスワード確認
  AND M920
  AND M922                     ; パスワード入力確定キー
  D5120 = D5121            ; 設定値 = 入力値
  MOVP K10 D5100           ; GOT画面切替番号 = 10(管理者画面)
  MOVP K0 D5101            ; オーバーラップウィンドウ1クリア

; --- 3790 ---
  LD M920
  AND M922
  D5120 <> D5121           ; パスワード不一致
  MOVP K12 D5101           ; オーバーラップウィンドウ1 = 12(エラー表示)

; --- 3800 ---
  LD M922
  MOVP K0 D5121            ; パスワード入力値クリア

; --- 3810 ---
  LD M920                     ; 条件外
  MOVP K0 D5101            ; ウィンドウクリア

;------------------------------------------------------------------------------
; 【11-01】安全機器一時解除制御 - 統合版
;------------------------------------------------------------------------------
; --- 3850 ---
  ; 安全機器一時解除画面判定
  AND M920
  D5112 >= K10             ; 表示中画面番号 >= 10
  D5112 <= K12             ; かつ <= 12
  SET M921                 ; 安全機器一時解除有効

; --- 3860 ---
  ; 画面遷移
  AND M921
  MOVP K1 D5100            ; 通常画面へ戻る

; --- 3870 ---
  ; 一時解除終了時の復帰処理
  AND M921                     ; 一時解除有効(反転)
  RST M910                 ; 障害物センサ無効PB OFF
  AND M12                      ; 運転モード時のみ
  RST M911                 ; 走行オーバーランLS無効PB OFF
  RST M912                 ; 昇降オーバーランLS無効PB OFF
  RST M913                 ; フォークオーバーランLS無効PB OFF
  RST M914                 ; ワイヤー緩みLS無効PB OFF
  RST M915                 ; 失速LS無効PB OFF

;------------------------------------------------------------------------------
; 【11-02】特殊操作中フラグ - 統合版
;------------------------------------------------------------------------------
; --- 3920 ---
  ; いずれかの安全機器無効化時
  AND M910                     ; 障害物センサ無効PB
  AND M911                     ; 走行オーバーランLS無効PB
  AND M912                     ; 昇降オーバーランLS無効PB
  AND M913                     ; フォークオーバーランLS無効PB
  AND M914                     ; ワイヤー緩みLS無効PB
  AND M915                     ; 失速LS無効PB
  SET M909                 ; 特殊操作中フラグ

;------------------------------------------------------------------------------
; 【11-03】画面自動切替 - アラーム発生時
;------------------------------------------------------------------------------
; --- 3950 ---
  LD<> D301 K0               ; アラーム発生時
  MOVP K7 D5100            ; GOT画面切替 = 7(アラーム画面)
  SET M8                   ; 異常発生中フラグ


;******************************************************************************
