Header
REMARK
;==============================================================================
; コンベア 制御プログラム - M8001 オフライン/実装モード切り替え機能付き
; ベース: REFACT2/Conveyor_Refactored_Q_GXW.asc
; 追加機能: SM8001(M8001)をONにするとオフライン(シミュレーション)モードに切り替わる
;
; 【M8001 モード説明】
;   M8001 = OFF: 実装モード（実機入力・CC-Link通信を使用）
;   M8001 = ON : オフラインモード（実機入力をバイパス、安全機器を正常固定）
;
; 【オフライン時の動作】
;   - 物理入力(X接点)をバイパス → 電源ON/安全機器正常を固定
;   - 異常検出フラグ（M2011）の発生を抑制
;   - 地上盤CC-Link受信ビット(B接点)をバイパス
;   - 自動運転開始条件を緩和
;==============================================================================

;------------------------------------------------------------------------------
; 【オフラインモード初期化処理】M8001 ON立上り時に実行
;------------------------------------------------------------------------------
;[オフライン初期化] M8001 ON時のリセット
  LDP M8001	;SM8001_オフラインモード立上りパルス
  FMOV K0 D50 K10	;異常フラグ全クリア
  MOV K0 D1005	;エラーコードクリア
  RST M2011	;異常フラグOFF
  RST M2012	;警告フラグOFF

;[オフライン初期化] M8001 OFF立下り時のリセット（実装モードへの復帰）
  LDF M8001	;SM8001_オフラインモード立下りパルス
  FMOV K0 D50 K10	;異常フラグ全クリア
  RST M2011	;異常フラグOFF

;[ネットワーク0] 初期フラグ
  LD SM401
  OUT M1
  LD SM400
  OUT M2

;[ネットワーク1] 入力マッピング統合
;  オフラインモード時: 制御電源入(X60) ON固定、X61もON固定
  LD M8001	;SM8001_オフラインモード(バイパス)
  OR X60
  OUT M1000
  LD M8001	;SM8001_オフラインモード(バイパス)
  OR X61
  OUT M1001
  LDP M1000
  MOVP K150 T10
  LD T10
  OUT M1500

;[ネットワーク2] 非常停止・安全装置統合処理
;  オフラインモード時: 全安全装置 正常固定（M40/M41/M42/M43 = ON）
;
;  M40: 非常停止正常
  LD M8001	;SM8001_オフラインモード(バイパス)
  LD X62
  ANI X63
  ORB
  OUT M40
;
;  M42: 安全装置2（AGVエリア）
  LD M8001	;SM8001_オフラインモード(バイパス)
  LD X0BA
  AND X0BB
  ORB
  OUT M42
;
;  M41: ライトカーテン（搬入側）
  LD M8001	;SM8001_オフラインモード(バイパス)
  LD X0B4
  AND X0B5
  AND X0B6
  AND X0B7
  ANI M902
  ANI M903
  ORB
  OUT M41
;
;  M43: 安全ドア（搬出側）
  LD M8001	;SM8001_オフラインモード(バイパス)
  LD X0B0
  AND X0B1
  AND X0B2
  AND X0B3
  ANI M900
  ANI M901
  ORB
  OUT M43

;[ネットワーク3] モード選択統合
;  注意: オフラインモード時もX70/X71はそのまま読む（モード選択はHMIで行う）
;  ソフトスイッチ（M8001ONで仮想X70=ON/X71=OFF として自動単独を想定）
  LD M8001	;SM8001_オフラインモード: 仮想自動モードデフォルト
  OR X70
  OUT M12
  LDI X70
  ANI M8001	;SM8001_オフラインモード時は手動選択OFF
  OUT M11
  LD X71
  OUT M14
  LDI X71
  OUT M13
  LD X73
  OUT M19

;[ネットワーク4] 運転準備条件統合
;  オフラインモード時: 全運転準備条件 ON固定
  LD M8001	;SM8001_オフラインモード: 全運転準備条件バイパス
  LD X7A
  OR X7B
  OR X7C
  OR X7D
  ORB
  OUT M10
;
;  自動運転開始条件: オフラインモード時は M10/M40/M41/M42バイパス、M2011は既にOFF
  LD M8001	;SM8001_オフラインモード: 自動運転開始条件 強制成立
  LD M1500
  ANB
  LD M8001
  OR M10
  ANB
  LD M8001
  OR M40
  ANB
  LD M8001
  OR M41
  ANB
  LD M8001
  OR M42
  ANB
  ANI M2011
  OUT M20

;[ネットワーク5] 搬入側開始条件チェック
;  オフラインモード時: X81/X0A1/X84 を正常固定
  LD M8001	;SM8001_オフラインモード(バイパス)
  LD M20
  LD M8001
  OR X81
  ANB
  LD M8001
  OR X0A1
  ANB
  LD M8001
  ANI_OR X84
  ANB
  ANI X84
  ORB
  OUT M21

;[ネットワーク6] 搬出側開始条件チェック
;  オフラインモード時: X91/X0A9/X0AC を正常固定
  LD M8001	;SM8001_オフラインモード(バイパス)
  LD M20
  LD M8001
  OR X91
  ANB
  LD M8001
  OR X0A9
  ANB
  ANI X0AC
  ORB
  OUT M22

;[ネットワーク7] 自動単独運転起動
;  オフラインモード時: X76（起動PB）はそのまま使用（HMIで操作）
  LD M12
  AND M13
  AND M21
  AND M22
  AND X76
  ANI M31
  ANI M32
  SET M31
  LD M31
  AND X77
  RST M31

;[ネットワーク8] 自動連動運転起動
;  オフラインモード時: B1526（地上盤起動許可）をバイパス
  LD M12
  AND M14
  AND M21
  AND M22
  AND X76
  LD M8001	;SM8001_オフラインモード: 地上盤起動許可バイパス
  OR B1526
  ANB
  ANI M31
  ANI M32
  SET M32
  LD M32
  AND X77
  LD M8001	;SM8001_オフラインモード: 地上盤サイクル停止バイパス
  ANI B1527
  ORB
  RST M32

;[ネットワーク9] 手動操作モード
;  オフラインモード時: M40（非常停止正常）はバイパス済み
  LD M11
  AND M1500
  AND M40
  OUT M30

;[ネットワーク10] 異常処理統合
  LD X74
  PLS M2010
  LD M2010
  FMOV K0 D50 K10
  FMOV K0 D51 K10
  MOV K0 D1005
  RST M2011
  RST M2012

;[ネットワーク11] 異常検出(制御電源)
;  オフラインモード時: 電源異常を検出しない（M2011をSETしない）
  LD T10
  ANI M1000
  ANI M8001	;SM8001_オフラインモード時は異常検出抑制
  SET D50.0
  SET M2011

;[ネットワーク12] 異常検出(盤クーラー)
;  オフラインモード時: クーラー異常を検出しない
  LD T10
  AND X7E
  ANI M8001	;SM8001_オフラインモード時は異常検出抑制
  SET D50.1
  SET M2011

;[ネットワーク13] 異常検出(非常停止)
;  オフラインモード時: 非常停止異常を検出しない
  LD T10
  ANI M40
  ANI M8001	;SM8001_オフラインモード時は異常検出抑制
  SET D50.2
  SET M2011

;[ネットワーク14] 積層灯制御統合（変更なし）
  LD M2011
  OUT Y100
  LD M2012
  OUT Y101
  LD M10
  ANI M2011
  ANI M2012
  OUT Y102
  LD M2011
  OR M2012
  OUT Y103

;[ネットワーク15] 搬入フォーク位置演算統合（変更なし）
  LD SM400
  DMOV D106 D160
  DIV D160 K10 D184
  SUB D184 D5006 D186

;[ネットワーク16] 搬入フォーク零点判定（変更なし）
  LD X86
  AND X87
  MOV D186 D200
  SUB D200 D500 D200
  AND> D200 K-2
  AND< D200 K2
  OUT M807

;[ネットワーク17] 搬出フォーク位置演算統合（変更なし）
  LD SM400
  DMOV D116 D170
  DIV D170 K10 D188
  SUB D188 D5008 D190

;[ネットワーク18] 搬出フォーク零点判定（変更なし）
  LD X96
  AND X97
  MOV D190 D202
  SUB D202 D505 D202
  AND> D202 K-2
  AND< D202 K2
  OUT M806

;[ネットワーク19] 搬入RFID処理統合（変更なし）
  LD M120
  AND X40
  AND X43
  ANI M121
  MOV H0 D520
  MOV K255 D525
  MOV H500 D528
  MOV H1002 D530
  MOV K6 D531
  MBRW U2 D520 D540 D550 M121
  LD M121
  ANI M120
  RST M121
  SWAP D540 D540
  SWAP D541 D541
  SWAP D542 D542
  SWAP D543 D543
  SWAP D544 D544
  SWAP D545 D545
  $MOV D540 D600
  SET M122

;[ネットワーク20] 搬出RFID処理統合（変更なし）
  LD M130
  AND X40
  AND X43
  ANI M131
  MOV H0 D560
  MOV K255 D565
  MOV H500 D568
  MOV H1002 D570
  MOV K6 D571
  MBRW U2 D560 D580 D590 M131
  LD M131
  ANI M130
  RST M131
  SWAP D580 D580
  SWAP D581 D581
  SWAP D582 D582
  SWAP D583 D583
  SWAP D584 D584
  SWAP D585 D585
  $MOV D580 D620
  SET M132

;[ネットワーク21] AGV光伝送制御統合（変更なし）
  LD X0C4
  OR X0C1
  OUT M50
  LD X0CA
  OR X0C7
  OUT M51
  LD X0D0
  OR X0CD
  OUT M52
  LD X0D6
  OR X0D3
  OUT M53

;[ネットワーク22] AGV発進可条件(搬入側)（変更なし）
  LD M31
  OR M32
  AND M807
  AND M50
  ANI M51
  ANI M900
  OUT M55
  LD M55
  OUT_T T50 K10
  LD T50
  OUT Y132

;[ネットワーク23] AGV発進可条件(搬出側)（変更なし）
  LD M31
  OR M32
  AND M806
  AND M52
  ANI M53
  ANI M900
  OUT M57
  LD M57
  OUT_T T52 K10
  LD T52
  OUT Y13A

;[ネットワーク24] インバータ通信(搬入フォーク)（変更なし）
  LD SM400
  BMOV U4\G4096 D100 K8
  MOV D100 K4M200
  BMOV K4M240 U4\G12288 K8
  MOV U4\G3104 K4M320
  LD K4M320
  SET M320

;[ネットワーク25] インバータ通信(搬出フォーク)（変更なし）
  LD SM400
  BMOV U4\G4112 D110 K8
  MOV D110 K4M220
  BMOV K4M260 U4\G12304 K8
  LD K4M322
  SET M322

;[ネットワーク26] 地上盤通信送信データ作成（変更なし）
  LD SM400
  MOV T0 D3000
  MOV D1008 D3001
  MOV D302 D3002
  MOV D1005 D3003
  MOV D1002 D3004
  DMOV D1000 D3006
  MOV D1102 D3009
  DMOV D1100 D3010
  $MOV D313 D3013
  $MOV D320 D3020

;[ネットワーク27] 地上盤通信受信データ処理
;  オフラインモード時: B1500/B1501/B1526/B1527 を強制ON
;  D3101/D3104（タスクID受信）はゼロ保持（タスクなし状態）
  LD M8001	;SM8001_オフラインモード(バイパス): 地上盤電源入
  OR B1500
  OUT M1500
  LD M8001	;SM8001_オフラインモード(バイパス): 地上盤運転準備
  OR B1501
  OUT M1501
  LD M8001	;SM8001_オフラインモード(バイパス): 地上盤起動許可
  OR B1526
  OUT M1526
  LD B1527
  OUT M1527
  LD SM400
  ANI M8001	;SM8001_オフラインモード時はタスクID受信をスキップ（D1000=0保持）
  DMOV D3101 D1000
  LD SM400
  ANI M8001
  DMOV D3104 D1100

;[ネットワーク999] 終了
  END
