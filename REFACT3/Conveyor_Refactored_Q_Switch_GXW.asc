; コンベア制御プログラム（M8001 オフライン/実装モード切り替え対応版）
; GX Works2 Simpleプロジェクト用 IL形式
;==============================================================================
; コンベア 制御プログラム（M8001 オフライン/実装モード切り替え対応版）
; ベース: REFACT2/Conveyor_Refactored_Q_GXW.asc
; M8001=OFF: 実装モード / M8001=ON: オフラインモード
;==============================================================================

;---------- オフラインモード初期化 ----------
  LDP M8001	;オフラインモード立上りパルス
  FMOV K0 D50 K10	;異常コードクリア
  FMOV K0 D51 K10
  MOV K0 D1005
  RST M2011	;重故障フラグ OFF
  RST M2012	;軽故障フラグ OFF
  LDF M8001	;オフラインモード立下りパルス(実装モード復帰)
  FMOV K0 D50 K10
  FMOV K0 D51 K10
  RST M2011
  RST M2012

;[ネットワーク0] 初期フラグ
  LD SM401
  OUT M1
  LD SM400
  OUT M2

;[ネットワーク1] 入力マッピング統合
  LD M8001	;オフラインバイパス
  OR X60
  OUT M1000
  LD X61
  OUT M1001
  LDP M1000
  OUT T10 K150
  LD T10
  OUT M1500

;[ネットワーク2] 非常停止・安全装置統合処理
  LD M8001	;オフラインバイパス(非常停止正常扱い)
  LD X62
  ANI X63
  ORB
  OUT M40
  LD M8001	;オフラインバイパス
  LD X0BA
  AND X0BB
  ORB
  OUT M42
  LD M8001	;オフラインバイパス
  LD X0B4
  AND X0B5
  AND X0B6
  AND X0B7
  ANI M902
  ANI M903
  ORB
  OUT M41
  LD M8001	;オフラインバイパス
  LD X0B0
  AND X0B1
  AND X0B2
  AND X0B3
  ANI M900
  ANI M901
  ORB
  OUT M43

;[ネットワーク3] モード選択統合
  LD X70
  OUT M12
  LDI X70
  OUT M11
  LD X71
  OUT M14
  LDI X71
  OUT M13
  LD X73
  OUT M19

;[ネットワーク4] 運転準備条件統合
  LD M8001	;オフラインバイパス
  LD X7A
  OR X7B
  OR X7C
  OR X7D
  ORB
  OUT M10
  LD M1500
  AND M10
  AND M40
  AND M41
  AND M42
  ANI M2011
  OUT M20

;[ネットワーク5] 搬入側開始条件チェック
  LD M20
  LD M8001	;オフラインバイパス
  OR X81
  LD M8001	;オフラインバイパス
  OR X0A1
  ANI X84
  OUT M21

;[ネットワーク6] 搬出側開始条件チェック
  LD M20
  LD M8001	;オフラインバイパス
  OR X91
  LD M8001	;オフラインバイパス
  OR X0A9
  ANI X0AC
  OUT M22

;[ネットワーク7] 自動単独運転起動
  LD M12
  AND M13
  AND M21
  AND M22
  AND X76
  ANI M31
  ANI M32
  SET M31
  LD M31
  AND X77
  RST M31

;[ネットワーク8] 自動連動運転起動
  LD M12
  AND M14
  AND M21
  AND M22
  AND X76
  LD M8001	;オフラインバイパス
  OR B1526
  ANI M31
  ANI M32
  SET M32
  LD M32
  AND X77
  LD B1527
  ANI M8001	;オフライン時はB1527によるRSTなし
  RST M32

;[ネットワーク9] 手動操作モード
  LD M11
  AND M1500
  AND M40
  OUT M30

;[ネットワーク10] 異常処理統合
  LD X74
  PLS M2010
  LD M2010
  FMOV K0 D50 K10
  FMOV K0 D51 K10
  MOV K0 D1005
  RST M2011
  RST M2012

;[ネットワーク11] 異常検出(制御電源)
  LD T10
  ANI M1000
  ANI M8001	;オフライン時は異常検出しない
  SET D50.0
  SET M2011

;[ネットワーク12] 異常検出(盤クーラー)
  LD T10
  AND X7E
  ANI M8001	;オフライン時は異常検出しない
  SET D50.1
  SET M2011

;[ネットワーク13] 異常検出(非常停止)
  LD T10
  ANI M40
  ANI M8001	;オフライン時は異常検出しない
  SET D50.2
  SET M2011

;[ネットワーク14] 積層灯制御統合
  LD M2011
  OUT Y100
  LD M2012
  OUT Y101
  LD M10
  ANI M2011
  ANI M2012
  OUT Y102
  LD M2011
  OR M2012
  OUT Y103

;[ネットワーク15] 搬入フォーク位置演算統合
  LD SM400
  DMOV D106 D160
  DIV D160 K10 D184
  SUB D184 D5006 D186

;[ネットワーク16] 搬入フォーク零点判定
  LD M8001	;オフラインバイパス
  LD X86
  AND X87
  ORB
  MOV D186 D200
  SUB D200 D500 D200
  AND> D200 K-2
  AND< D200 K2
  OUT M807

;[ネットワーク17] 搬出フォーク位置演算統合
  LD SM400
  DMOV D116 D170
  DIV D170 K10 D188
  SUB D188 D5008 D190

;[ネットワーク18] 搬出フォーク零点判定
  LD M8001	;オフラインバイパス
  LD X96
  AND X97
  ORB
  MOV D190 D202
  SUB D202 D505 D202
  AND> D202 K-2
  AND< D202 K2
  OUT M806

;[ネットワーク19] 搬入RFID処理統合
  LD M120
  AND X40
  AND X43
  ANI M121
  MOV H0 D520
  MOV K255 D525
  MOV H500 D528
  MOV H1002 D530
  MOV K6 D531
  MBRW U2 D520 D540 D550 M121
  LD M121
  ANI M120
  RST M121
  SWAP D540 D540
  SWAP D541 D541
  SWAP D542 D542
  SWAP D543 D543
  SWAP D544 D544
  SWAP D545 D545
  $MOV D540 D600
  SET M122

;[ネットワーク20] 搬出RFID処理統合
  LD M130
  AND X40
  AND X43
  ANI M131
  MOV H0 D560
  MOV K255 D565
  MOV H500 D568
  MOV H1002 D570
  MOV K6 D571
  MBRW U2 D560 D580 D590 M131
  LD M131
  ANI M130
  RST M131
  SWAP D580 D580
  SWAP D581 D581
  SWAP D582 D582
  SWAP D583 D583
  SWAP D584 D584
  SWAP D585 D585
  $MOV D580 D620
  SET M132

;[ネットワーク21] AGV光伝送制御統合
  LD X0C4
  OR X0C1
  OUT M50
  LD X0CA
  OR X0C7
  OUT M51
  LD X0D0
  OR X0CD
  OUT M52
  LD X0D6
  OR X0D3
  OUT M53

;[ネットワーク22] AGV発進可条件(搬入側)
  LD M31
  OR M32
  AND M807
  AND M50
  ANI M51
  ANI M900
  OUT M55
  LD M55
  OUT T50 K10
  LD T50
  OUT Y132

;[ネットワーク23] AGV発進可条件(搬出側)
  LD M31
  OR M32
  AND M806
  AND M52
  ANI M53
  ANI M900
  OUT M57
  LD M57
  OUT T52 K10
  LD T52
  OUT Y13A

;[ネットワーク24] インバータ通信(搬入フォーク)
  LD SM400
  ANI M8001	;オフライン時はインバータ通信スキップ
  BMOV U4\G4096 D100 K8
  MOV D100 K4M200
  BMOV K4M240 U4\G12288 K8
  MOV U4\G3104 K4M320
  LD K4M320
  SET M320

;[ネットワーク25] インバータ通信(搬出フォーク)
  LD SM400
  ANI M8001	;オフライン時はインバータ通信スキップ
  BMOV U4\G4112 D110 K8
  MOV D110 K4M220
  BMOV K4M260 U4\G12304 K8
  LD K4M322
  SET M322

;[ネットワーク26] 地上盤通信送信データ作成
  LD SM400
  MOV T0 D3000
  MOV D1008 D3001
  MOV D302 D3002
  MOV D1005 D3003
  MOV D1002 D3004
  DMOV D1000 D3006
  MOV D1102 D3009
  DMOV D1100 D3010
  $MOV D313 D3013
  $MOV D320 D3020

;[ネットワーク27] 地上盤通信受信データ処理
  LD M8001	;オフラインバイパス(通信正常扱い)
  OR B1500
  OUT M1500
  LD M8001	;オフラインバイパス
  OR B1501
  OUT M1501
  LD M8001	;オフラインバイパス
  OR B1526
  OUT M1526
  LD B1527
  OUT M1527
  ANI M8001	;オフライン時はDMOVスキップ
  DMOV D3101 D1000
  DMOV D3104 D1100

;[ネットワーク999] 終了
  END
