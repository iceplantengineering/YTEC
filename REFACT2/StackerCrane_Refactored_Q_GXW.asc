  SET M671                 ; 黄点灯(点滅用)

( 3620)
  M21
  M22
  M31
  SM413                    ; 2秒クロック(点滅)
  SET M671                 ; 黄点滅

( 3630)
  M30                      ; 点検モード
  SM413
  SET M671                 ; 黄点滅

( 3635)
