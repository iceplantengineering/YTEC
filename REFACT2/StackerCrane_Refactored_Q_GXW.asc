  K20 T17                  ; 自動運転開始遅延(2秒)

( 1815)
  M37
  T17
  SET M51                  ; 自動運転開始

;------------------------------------------------------------------------------
; 【07-06】座標計算 - 最適化版
;------------------------------------------------------------------------------
( 1850)
  M71
  ; 搬入台番号 → インデックス変換
  D309 = K2                ; 搬入台 B01
  MOVP K1 D398             ; インデックス = 1

( 1855)
  D309 = K6                ; 搬入台 B02
  MOVP K2 D398             ; インデックス = 2

( 1860)
  ; 搬出台番号 → インデックス変換
  D310 = K4                ; 搬出台 B01
  MOVP K3 D399             ; インデックス = 3

( 1865)
  D310 = K8                ; 搬出台 B02
  MOVP K4 D399             ; インデックス = 4

( 1880)
  M71
  ; 列・層の配列インデックス計算
  D304 - K1 D394           ; 始点列インデックス = 列 - 1
  D305 - K1 D395           ; 始点層インデックス = 層 - 1
  D307 - K1 D396           ; 終点列インデックス = 列 - 1
  D308 - K1 D397           ; 終点層インデックス = 層 - 1

;------------------------------------------------------------------------------
; 【07-07】目標位置設定 - タスク別
;------------------------------------------------------------------------------
( 1920)
  ; 搬入タスク: 終点(棚)への移動
  M71
  M541                     ; タスクタイプ_搬入
  M98                      ; 終点位置ON
  D309 <> K0               ; 搬入台番号有効
  M628                     ; パレット在席
  D396 * K2 Z2             ; 列インデックス×2 → Z2
  D397 * K2 Z4             ; 層インデックス×2 → Z4
  EMOV D3284Z2 D200        ; 列座標[Z2] → X軸目標位置
  E+ D3274Z4 D3268 D212    ; 層座標[Z4] + 持上高さ → Y軸目標位置
  SET M102                 ; X軸ON 位置決め補助1
  SET M122                 ; Y軸ON 位置決め補助1
  SET M165                 ; 受渡点補助1

( 1950)
  ; 搬入タスク: 受取点(搬入台)への移動
  M71
  M541
  M98
  D309 <> K0
  M628
  D398 * K6 Z10            ; 搬入台インデックス×6 → Z10
  EMOV D5034Z10 D200       ; DockTable列座標[Z10] → X軸目標
  E- D5036Z10 D3268 D212   ; DockTable層座標[Z10] - 持上高さ → Y軸目標
  SET M103                 ; X軸ON 位置決め補助2
  SET M123                 ; Y軸ON 位置決め補助2
  SET M160                 ; 受取点補助1

( 1980)
  ; 搬出タスク: 受取点(棚)からの取出
  M71
  M542                     ; タスクタイプ_搬出
  M97                      ; 始点位置ON
  D310 <> K0               ; 搬出台番号有効
  M628
  D399 * K6 Z12
  EMOV D5034Z12 D200
  E+ D5036Z12 D3268 D212
  SET M104                 ; X軸ON 位置決め補助3
  SET M124                 ; Y軸ON 位置決め補助3
  SET M166                 ; 受渡点補助2

( 2010)
  ; 搬出タスク: 棚からの受取
  M71
  M542
  M97
  D310 <> K0
  M628
  D394 * K2 Z2
  D395 * K2 Z4
  EMOV D3284Z2 D200
  E- D3274Z4 D3268 D212
  SET M105                 ; X軸ON 位置決め補助4
  SET M125                 ; Y軸ON 位置決め補助4
  SET M161                 ; 受取点補助2

( 2040)
  ; 移庫タスク: 終点(棚)への受渡
  M71
  M543                     ; タスクタイプ_移庫
  M97
  M98
  M628
  D396 * K2 Z2
  D397 * K2 Z4
  EMOV D3284Z2 D200
  E+ D3274Z4 D3268 D212
  SET M106
  SET M126
  SET M167                 ; 受渡点補助3

( 2070)
  ; 移庫タスク: 始点(棚)からの受取
  M71
  M543
  M97
  M98
  M628
  D394 * K2 Z2
  D395 * K2 Z4
  EMOV D3284Z2 D200
  E- D3274Z4 D3268 D212
  SET M107
  SET M127
  SET M162                 ; 受取点補助3

( 2100)
  ; 原位置タスク
  M71
  M544                     ; タスクタイプ_原位置
  EMOV D3296 D200          ; 列座標[7] → 原点列位置
  EMOV D3274 D212          ; 層座標[1] → 原点層位置
  SET M108
  SET M128
  SET M163                 ; 受取点補助4

;------------------------------------------------------------------------------
; 【07-08】受取・受渡シーケンス - 統合・簡素化版
;------------------------------------------------------------------------------
( 2150)
  ; 【受取位置へ移動】
  M54                      ; 受取位置へフラグ
  M416                     ; X軸位置到達
  M437                     ; Y軸位置到達
  M541                     ; 搬入タスク
  M628                     ; パレット在席
  K1 T30                   ; 受取位置到着確認(0.1秒)
  SET M55                  ; 受取_フォーク伸出

( 2160)
  M54
  M416
  M437
  M542                     ; 搬出タスク
  M543                     ; 移庫タスク
  M544                     ; 原位置タスク
