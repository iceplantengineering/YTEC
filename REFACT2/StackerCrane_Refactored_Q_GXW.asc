  M200                     ; X軸運転レディ
  M220                     ; Y軸運転レディ
  M240                     ; Z軸運転レディ
  M205                     ; X軸装置原点
  M225                     ; Y軸装置原点
  M245                     ; Z軸装置原点
  SET M21                  ; 自動運転開始条件2

( 1570)
  M96                      ; フォーク原位置
  SET M22                  ; 自動運転開始条件3

;------------------------------------------------------------------------------
; 【07-03】タスク指令受付 - 統合版
;------------------------------------------------------------------------------
( 1590)
  M50                      ; 待機中
  D331 D<> K0              ; タスクID有効
  SET M550                 ; タスク指令開始

( 1600)
  ; 搬入タスク判定
  M550
  M541                     ; タスクタイプ = 搬入
