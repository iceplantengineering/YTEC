;******************************************************************************
; スタッカークレーン制御プログラム - 改修版
; 作成日: 2024-12-12
; 対象機器: 三菱電機 PLC (Q/iQシリーズ)
; 
; 【主な改修内容】
; 1. 冗長なコードの統合と削除
; 2. 命名規則の統一とコメントの充実
; 3. 安全機能の集約化
; 4. タスク処理フローの明確化
; 5. 通信処理の効率化
;******************************************************************************

;==============================================================================
; プログラム構成
;==============================================================================
; BLOCK_00: 初期化・システム監視
; BLOCK_01: 安全機能管理
; BLOCK_02: 入力処理
; BLOCK_03: 軸制御共通処理
; BLOCK_04: X軸(走行)制御
; BLOCK_05: Y軸(昇降)制御
; BLOCK_06: Z軸(フォーク)制御
; BLOCK_07: 自動運転制御
; BLOCK_08: 手動・点検運転制御
; BLOCK_09: 通信処理
; BLOCK_10: 出力処理
; BLOCK_11: HMI・表示処理
;==============================================================================


;******************************************************************************
; BLOCK_00: 初期化・システム監視
;******************************************************************************

;------------------------------------------------------------------------------
; 【00-00】システム起動時初期化
;------------------------------------------------------------------------------
( 0)
  SM400                    ; 常時ON
  K300 T0                  ; 電源ON後遅延タイマー(3秒)
  
( 1)
  T0                       ; 起動遅延完了後
  SET M0                   ; システム初期化完了フラグ

;------------------------------------------------------------------------------
; 【00-01】システム状態管理
;------------------------------------------------------------------------------
( 5)
  M0                       ; システム初期化完了
  M40                      ; 非常停止正常
  M45                      ; 異常なし(反転)
  SET M1                   ; システム動作許可

( 10)
  M0                       ; システム初期化完了
  M40                      ; 非常停止正常(反転)
  RST M1                   ; システム動作許可解除

( 15)
  M0
  M45                      ; 異常発生
  RST M1                   ; システム動作許可解除


;******************************************************************************
; BLOCK_01: 安全機能管理
;******************************************************************************

;------------------------------------------------------------------------------
; 【01-00】非常停止監視
;------------------------------------------------------------------------------
( 20)
  X40                      ; 非常停止PB1
  SET M600                 ; 非常停止1正常
  
( 22)
  X40                      ; 非常停止PB1(反転)
  RST M600

( 24)
  X41                      ; 非常停止PB2
  SET M601                 ; 非常停止2正常
  
( 26)
  X41                      ; 非常停止PB2(反転)
  RST M601

( 28)
  M600                     ; 非常停止1正常
  M601                     ; 非常停止2正常
  SET M40                  ; 非常停止正常まとめ

( 32)
  M600                     ; 非常停止1異常
  RST M40

( 34)
  M601                     ; 非常停止2異常
  RST M40

;------------------------------------------------------------------------------
; 【01-01】アラーム検出・記録 - 統合版
;------------------------------------------------------------------------------
( 40)
  M40                      ; 非常停止異常
  SET M800                 ; アラーム記録1
  MOVP K1 D301             ; アラームコード1

( 45)
  M340                     ; 地上盤通信異常
  SET M804                 ; アラーム記録5
  MOVP K5 D301

( 50)
  M320                     ; X軸通信異常
  SET M805
  MOVP K6 D301

( 55)
  M322                     ; Y軸通信異常
  SET M806
  MOVP K7 D301

( 60)
  M324                     ; Z軸通信異常
  SET M807
  MOVP K8 D301

;------------------------------------------------------------------------------
; 【01-02】走行系安全装置監視 - 最適化版
;------------------------------------------------------------------------------
( 70)
  SM400
  M606                     ; 前方障害物減速
  M910                     ; 障害物センサ無効PB(反転)
  M11                      ; 点検モード(反転)
  SET M3179                ; 障害物回避アラーム

( 75)
  M608                     ; 後方障害物減速
  M910
  M11
  SET M3179

( 80)
  M607                     ; 前方障害物停止
  M910
  M11
  SET M829                 ; アラーム記録30
  MOVP K30 D301

( 85)
  M609                     ; 後方障害物停止
  M910
  M11
  SET M830
  MOVP K31 D301

;------------------------------------------------------------------------------
; 【01-03】昇降系安全装置監視 - 統合版
;------------------------------------------------------------------------------
( 100)
  M619                     ; 昇降失速
  M11                      ; 点検モード(反転)
  M915                     ; 失速LS無効PB(反転)
  SET M811
  MOVP K12 D301

( 105)
  M620                     ; 昇降ロープ緩み1
  M621                     ; または緩み2
  M11
  M914                     ; ワイヤー緩みLS無効PB(反転)
  SET M812                 ; アラーム記録13
  MOVP K13 D301

( 112)
  M622                     ; 昇降過負荷1
  M623                     ; または過負荷2
  M11
  M914
  SET M814
  MOVP K15 D301

;------------------------------------------------------------------------------
; 【01-04】フォーク系安全監視 - 統合・簡素化版
;------------------------------------------------------------------------------
; 左側崩壊検出
( 130)
  M632                     ; 左側崩壊1
  M633                     ; または崩壊2
  M12                      ; 運転モード時のみ
  M95                      ; フォーク中位
  M307                     ; Z軸動作中
  SET M3205                ; 左側崩壊アラーム

; 右側崩壊検出
( 140)
  M640                     ; 右側崩壊1
  M641                     ; または崩壊2
  M12
  M95
  M307
  SET M3200                ; 右側崩壊アラーム

; はみだし検出(左右統合)
( 150)
  M634                     ; 左側はみだし1
  M635                     ; 左側はみだし2
  M12
  M95
  M307
  SET M3203                ; 左超ワイドアラーム

( 160)
  M642                     ; 右側はみだし1
  M643                     ; 右側はみだし2
  M12
  M95
  M307
  SET M3198                ; 右超ワイドアラーム

;------------------------------------------------------------------------------
; 【01-05】アラームリセット処理 - 統合版
;------------------------------------------------------------------------------
( 180)
  X43                      ; 異常リセットKSW
  M3217                    ; 地上盤リセット
  D301 <> K0               ; アラームコード有効時
  SET M9                   ; アラームリセット中フラグ

( 185)
  M9                       ; アラームリセット実行
  MOVP K0 K4M800           ; 全アラーム記録クリア(M800-M835)
  MOVP K0 D301             ; アラームコードクリア
  RST M3179                ; 障害物回避アラームクリア
  RST M3205                ; 左側崩壊アラームクリア
  RST M3204
  RST M3200                ; 右側崩壊アラームクリア
  RST M3199

( 195)
  M9
  MOVP K0 D330             ; タスクタイプクリア
  MOVP K0 D333             ; 起点データクリア
  MOVP K0 D334
  MOVP K0 D335
  MOVP K0 D336             ; 終点データクリア
  MOVP K0 D337
  MOVP K0 D338
  MOVP K0 D339             ; 搬入台番号クリア
  MOVP K0 D340             ; 搬出台番号クリア

( 200)
  M9
  SET M268                 ; X軸異常リセット
  SET M288                 ; Y軸異常リセット
  SET M308                 ; Z軸異常リセット

( 205)
  M9                       ; リセット完了後
  K2 T50                   ; 0.2秒後
  T50
  RST M9                   ; リセット中フラグOFF


;******************************************************************************
; BLOCK_02: 入力処理
;******************************************************************************

;------------------------------------------------------------------------------
; 【02-00】デジタル入力マッピング - 統合版
;------------------------------------------------------------------------------
( 250)
  SM400
  X42 M602                 ; 点検/運転SSW
  X43 M603                 ; 異常リセットKSW
  X44 M604                 ; 管理者モードKSW

( 255)
  ; 走行系センサ
  X46 M606                 ; 走行前方障害物減速
  X47 M607                 ; 走行前方障害物停止
  X48 M608                 ; 走行後方障害物減速
  X49 M609                 ; 走行後方障害物停止
  X4C M612                 ; 走行前方オーバーRUN
  X4D M613                 ; 走行後方オーバーRUN
  X4E M614                 ; 走行減速

( 265)
  ; 昇降系センサ
  X50 M616                 ; 昇降上オーバーRUN
  X51 M617                 ; 昇降下オーバーRUN
  X52 M618                 ; 昇降減速
  X53 M619                 ; 昇降失速
  X54 M620                 ; 昇降ロープ緩み1
  X55 M621                 ; 昇降ロープ緩み2
  X56 M622                 ; 昇降過負荷1
  X57 M623                 ; 昇降過負荷2

( 275)
  ; フォーク系センサ
  X58 M624                 ; フォーク左側出限
  X59 M625                 ; フォーク右側出限
  X5A M626                 ; フォーク中位1
  X5B M627                 ; フォーク中位2
  X5C M628                 ; パレット在席

( 285)
  ; フォーク異常検出
  X60 M632                 ; 左側崩壊1
  X61 M633                 ; 左側崩壊2
  X62 M634                 ; 左側はみだし1
  X63 M635                 ; 左側はみだし2
  X64 M636                 ; 左側超高
  X65 M637                 ; 左側パレット検出

( 295)
  X68 M640                 ; 右側崩壊1
  X69 M641                 ; 右側崩壊2
  X6A M642                 ; 右側超はみだし1
  X6B M643                 ; 右側超はみだし2
  X6C M644                 ; 右側超高
  X6D M645                 ; 右側パレット検出

( 305)
  ; その他
  X70 M648                 ; 盤クーラ異常
  X71 M649                 ; 光通信センサ異常
  X7A M658                 ; メンテピン格納1
  X7B M659                 ; メンテピン格納2

( 310)
  ; INV電源確認
  X5D M629                 ; 走行ドライブ電源
  X5E M630                 ; 昇降ドライブ電源
  X5F M631                 ; フォーク(伸縮)ドライブ電源
  X74 M652                 ; 走行INV MC ON
  X75 M653                 ; 昇降INV MC ON
  X76 M654                 ; 伸縮INV MC ON

;------------------------------------------------------------------------------
; 【02-01】フォーク中位検出 - 簡素化
;------------------------------------------------------------------------------
( 330)
  M626                     ; フォーク中位1
  M627                     ; フォーク中位2
  SET M95                  ; フォーク伸縮中位検出

( 335)
  M626                     ; どちらかOFFで
  RST M95

( 337)
  M627
  RST M95

;------------------------------------------------------------------------------
; 【02-02】フォーク原点検出 - 最適化
;------------------------------------------------------------------------------
( 340)
  M95                      ; フォーク中位
  D321 E> E-2              ; Z軸現在位置 > -2
  D321 E< E2               ; かつ < 2
  SET M96                  ; フォーク原位置

( 345)
  M95                      ; 条件外
  RST M96

;------------------------------------------------------------------------------
; 【02-03】地上盤通信データ受信 - 統合版
;------------------------------------------------------------------------------
( 360)
  SM400
  BMOV U2\G4096 D3000 K30  ; 地上盤データ一括受信

( 365)
  ; タスク情報
  MOV D3000 D330           ; タスクタイプ
  DMOV D3001 D331          ; タスクID
  MOV D3003 D333           ; 起点棚
  MOV D3004 D334           ; 起点列
  MOV D3005 D335           ; 起点層
  MOV D3006 D336           ; 終点棚
  MOV D3007 D337           ; 終点列
  MOV D3008 D338           ; 終点層
  MOV D3009 D339           ; 搬入台番号
  MOV D3010 D340           ; 搬出台番号

( 380)
  ; 制御ビット情報
  MOV D3024 K4M2500        ; 制御ビット → M2500~
  M2500 M535               ; 手動操作要求
  M2501 M523               ; 庫位切替
  M2502 M530               ; Y軸強制動作
  M2503 M520               ; X軸位置決め
  M2504 M521               ; Y軸位置決め
  M2505 M522               ; Z軸位置決め
  M2506 M524               ; X軸前進
  M2507 M525               ; X軸後退
  M2508 M526               ; Y軸上昇
  M2509 M527               ; Y軸下降
  M2510 M528               ; Z軸左伸
  M2511 M529               ; Z軸右伸
  M2512 M531               ; 原点位置決め
  M2513 M539               ; 自動運転中

( 400)
  ; モード・状態情報
  D3016 = K0 M3220         ; 自動運転モード
  D3016 = K2 M3221         ; 手動運転モード
  D3017 = K1 M3217         ; リセット
  D3018 = K1 M3218         ; 一時停止
  D3025 = K1 M3219         ; 非常停止

( 410)
  ; 搬入搬出可能フラグ
  D3012 = K1 M3208         ; B01搬入可
  D3013 = K1 M3210         ; B02搬入可
  D3014 = K1 M3213         ; B01搬出可
  D3015 = K1 M3215         ; B02搬出可


;******************************************************************************
; BLOCK_03: 軸制御共通処理
;******************************************************************************

;------------------------------------------------------------------------------
; 【03-00】U0(軸制御ユニット)データ受信
;------------------------------------------------------------------------------
( 450)
  SM400
  BMOV U0\G4096 D100 K8    ; X軸データ受信
  BMOV U0\G4112 D110 K8    ; Y軸データ受信
  BMOV U0\G4128 D120 K8    ; Z軸データ受信

( 460)
  ; 状態ワード展開
  MOV D100 K4M200          ; X軸状態 → M200~
  MOV D110 K4M220          ; Y軸状態 → M220~
  MOV D120 K4M240          ; Z軸状態 → M240~

( 470)
  ; 通信異常監視
  MOV U0\G3104 K4M320      ; X軸通信異常
  MOV U2\G3104 K4M340      ; 地上盤通信異常

;------------------------------------------------------------------------------
; 【03-01】現在位置・速度データ処理 - 統合版
;------------------------------------------------------------------------------
( 500)
  SM400
  ; X軸(走行)
  MOV D106 D161            ; X軸現在位置(High)
  MOV D107 D160            ; X軸現在位置(Low)
  DFLT D160 D204           ; 実数変換
  E/ D204 E10 D1000        ; モータ位置 = 現在位置/10
  E- D1000 D5024 D317      ; 実位置 = モータ位置 - オフセット

( 510)
  ; Y軸(昇降)
  MOV D116 D163
  MOV D117 D162
  DFLT D162 D216
  E/ D216 E10 D1004
  E- D1004 D5026 D319

( 520)
  ; Z軸(フォーク)
  MOV D126 D165
  MOV D127 D164
  DFLT D164 D228
  E/ D228 E10 D1008
  E- D1008 D5028 D321

( 530)
  ; 速度データ
  FLT D101 D206            ; X軸速度
  E/ D206 E1 D323
  FLT D111 D218            ; Y軸速度
  E/ D218 E1 D325
  FLT D121 D230            ; Z軸速度
  E/ D230 E1 D327

;------------------------------------------------------------------------------
; 【03-02】目標位置計算 - 統合・最適化版
;------------------------------------------------------------------------------
( 560)
  SM400
  ; X軸目標位置計算
  E+ D200 D5024 D208       ; 列目標位置 + オフセット
  E* D208 E10 D208         ; ×10(モータ単位)
  DINT D208 D170           ; 整数変換
  MOV D171 D136            ; 目標位置High
  MOV D170 D137            ; 目標位置Low

( 570)
  ; Y軸目標位置計算
  E+ D212 D5026 D220
  E* D220 E10 D220
  DINT D220 D172
  MOV D173 D146
  MOV D172 D147

( 580)
  ; Z軸目標位置計算
  E+ D224 D5028 D232
  E* D232 E10 D232
  DINT D232 D174
  MOV D175 D156
  MOV D174 D157

;------------------------------------------------------------------------------
; 【03-03】位置到達判定 - 統合版
;------------------------------------------------------------------------------
( 600)
  SM400
  ; X軸位置到達判定
  D317 E>= D200            ; 現在位置 >= 目標位置
  E- D317 D200 D1002       ; 位置差計算
  D1002 E< E5              ; 位置差 < 5mm
  M207                     ; 情報有効化済み
  M401                     ; X軸位置決め中(自動)
  SET M416                 ; X軸位置到達

( 610)
  ; 同様にY軸
  D319 E>= D212
  E- D319 D212 D1006
  D1006 E< E2              ; ±2mm
  M227
  M422
  SET M437                 ; Y軸位置到達

( 620)
  ; 同様にZ軸
  D321 E>= D224
  E- D321 D224 D1010
  D1010 E< E2
  M247
  M443
  SET M458                 ; Z軸位置到達

( 630)
  ; 逆方向からの到達判定も同様に処理(省略)

;------------------------------------------------------------------------------
; 【03-04】軸動作許可条件 - 統合・簡素化版
;------------------------------------------------------------------------------
( 680)
  ; X軸(走行)動作許可
  T0                       ; 起動遅延完了
  M652                     ; 走行INV電源ON
  M95                      ; フォーク中位
  D5012 E> D317            ; 前方リミット内
  M606                     ; 前方障害物なし(反転)
  M612                     ; 前方オーバーRUNなし(反転)
  M910                     ; 障害物センサ無効時は許可
  SET M417                 ; X軸正回転可

( 690)
  T0
  M652
  M95
  D5014 E< D317            ; 後方リミット内
  M608                     ; 後方障害物なし
  M613                     ; 後方オーバーRUNなし
  M910
  SET M418                 ; X軸逆回転可

( 700)
  ; Y軸(昇降)動作許可
  T0
  M653                     ; 昇降INV電源ON
  M95
  D5016 E> D319            ; 上限リミット内
  M616                     ; 上オーバーRUNなし
  M30                      ; 点検モード時は許可
  M510                     ; Y軸強制可時は許可
  SET M438                 ; Y軸正回転可

( 710)
  T0
  M653
  M95
  D5018 E< D319            ; 下限リミット内
  M617                     ; 下オーバーRUNなし
  M30
  M530                     ; 地上盤Y軸強制可
  SET M439                 ; Y軸逆回転可

( 720)
  ; Z軸(フォーク)動作許可
  T0
  M654                     ; フォークINV電源ON
  D5020 E> D321            ; 左限リミット内
  M624                     ; 左出限なし
  SET M459                 ; Z軸正回転可

( 730)
  T0
  M654
  D5022 E< D321            ; 右限リミット内
  M625                     ; 右出限なし
  SET M460                 ; Z軸逆回転可

;------------------------------------------------------------------------------
; 【03-05】速度設定 - 統合版
;------------------------------------------------------------------------------
( 760)
  ; X軸速度設定
  M267                     ; X軸動作中
  M614                     ; 走行減速(反転)
  M11                      ; 点検モード
  MOV D5003 D131           ; 手動速度設定

( 765)
  M267
  M614
  M12                      ; 運転モード
  MOV D5000 D131           ; 自動速度設定

( 770)
  M267
  M614                     ; 減速センサON時
  MOVP K500 D131           ; 減速速度(500mm/s)

( 780)
  ; Y軸速度設定
  M287                     ; Y軸動作中
  M618                     ; 昇降減速(反転)
  M11
  MOV D5004 D141           ; 手動速度設定

( 785)
  M287
  M618
  M12
  MOV D5001 D141           ; 自動速度設定

( 790)
  M287
  M618                     ; 減速センサON時
  MOVP K300 D141           ; 減速速度(300mm/s)

( 795)
  ; 受取・受渡時の低速設定
  M56                      ; 受取フォーク持上げ中
  M61                      ; 受渡フォーク下降中
  MOVP D5070 D141          ; 取投物料速度(50mm/s)

( 800)
  ; Z軸速度設定(点検/運転で切替)
  M307                     ; Z軸動作中
  M11
  MOV D5005 D151           ; 手動速度設定

( 805)
  M307
  M12
  MOV D5002 D151           ; 自動速度設定

;------------------------------------------------------------------------------
; 【03-06】加減速設定 - 統合版
;------------------------------------------------------------------------------
( 820)
  M267                     ; X軸動作中
  MOV D5006 D132           ; X軸加速度
  MOV D5007 D133           ; X軸減速度

( 825)
  M287                     ; Y軸動作中
  MOV D5008 D142
  MOV D5009 D143

( 830)
  M307                     ; Z軸動作中
  MOV D5010 D152
  MOV D5011 D153

;------------------------------------------------------------------------------
; 【03-07】制御ワード送信 - 統合版
;------------------------------------------------------------------------------
( 850)
  SM400
  ; X軸制御ワード
  MOV K4M260 D130          ; Enable非常停止 → 制御ワード
  BMOV D130 U0\G12288 K8   ; 送信

( 855)
  ; Y軸制御ワード
  MOV K4M280 D140
  BMOV D140 U0\G12304 K8

( 860)
  ; Z軸制御ワード
  MOV K4M300 D150
  BMOV D150 U0\G12320 K8


;******************************************************************************
