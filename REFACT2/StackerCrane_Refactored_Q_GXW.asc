  D339 <> K0               ; 搬入台番号有効
  D336 <> K0               ; 終点棚有効
  D337 <> K0               ; 終点列有効
  D338 <> K0               ; 終点層有効
  M16
  M50
  M37                      ; 運転中(反転)
  SET M551                 ; タスク指令_搬入

( 1620)
  ; 搬出タスク判定
  M550
  M542
  D331 D<> D312
  D340 <> K0               ; 搬出台番号有効
  D333 <> K0               ; 起点棚有効
  D334 <> K0               ; 起点列有効
  D335 <> K0               ; 起点層有効
  M16
  M50
  M37
  SET M552                 ; タスク指令_搬出

( 1640)
