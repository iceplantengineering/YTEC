;------------------------------------------------------------------------------
; 【11-01】安全機器一時解除制御 - 統合版
;------------------------------------------------------------------------------
( 3850)
  ; 安全機器一時解除画面判定
  M920
  D5112 >= K10             ; 表示中画面番号 >= 10
  D5112 <= K12             ; かつ <= 12
  SET M921                 ; 安全機器一時解除有効

( 3860)
  ; 画面遷移
